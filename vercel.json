{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/screens",
      "destination": "/gallery/",
      "permanent": false
    },
    {
      "source": "/screens/",
      "destination": "/gallery/",
      "permanent": false
    },
    {
      "source": "/screens/:path+",
      "destination": "/gallery/",
      "permanent": false
    },
    {
      "source": "/screens/:path+/",
      "destination": "/gallery/",
      "permanent": false
    },
    {
      "source": "/signin",
      "destination": "/waitlist/",
      "permanent": false
    },
    {
      "source": "/signin/",
      "destination": "/waitlist/",
      "permanent": false
    }
  ]
}
