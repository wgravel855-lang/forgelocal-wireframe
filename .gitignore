# Reference screenshots of other products. Kept locally for design comparison,
# not redistributed.
refs/

# Generated design-canvas payload (~2 MB of embedded editor).
design/forgelocal-wireframe.html

node_modules/
.DS_Store
Thumbs.db
.vercel

# QA harness is copied into public/ only while auditing locally
public/qa-audit.js
desktop/src-tauri/target/
desktop/src-tauri/gen/

# The inference engine binary, fetched by scripts/fetch-engine.mjs. Hundreds of
# megabytes per acceleration build, so it is provisioned rather than committed.
# Model weights are never here either; they live in the user's model folder.
desktop/src-tauri/binaries/
.forgelocal/engine-cache/

# The vendored Node and playwright-core, produced by scripts/vendor-node.mjs.
# A hundred megabytes of third-party binary that any build can reproduce from
# runtime/vendor/node-manifest.mjs, verified against the checksum nodejs.org
# publishes. The manifest is committed; the payload is not.
desktop/src-tauri/vendor/
