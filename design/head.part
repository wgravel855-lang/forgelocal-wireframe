<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <style>
    /* ==================================================================
       ForgeLocal design tokens

       :root  = light marketing surface
       .app   = near-black desktop shell
       Components read only the vars, so one set serves both.
       ================================================================== */
    /* ---- type scale -------------------------------------------------------
       One integer scale, assigned by role rather than by how much space a
       control happened to have. Every size carries its own line height, so
       enlarging text cannot leave a cramped line box behind.

         meta   13/18  tertiary only: timestamps, durations, counts, shortcuts
         label  14/20  secondary labels, navigation, tabs, buttons, chips
         copy   15/22  compact body: descriptions, empty-state explanations
         body   16/24  primary text: page titles, model names, composer, prose
         title  20/28  model-detail titles and small feature headings
         hero   24/32  the empty-workspace question, and nothing else

       13px is the floor for anything visible and 14px the floor for anything
       interactive or needed to understand the screen. Fractional sizes are
       gone: they were the residue of fitting text to a column rather than
       choosing a role for it. */
    :root {
      --t-meta:13px;  --lh-meta:18px;
      --t-label:14px; --lh-label:20px;
      --t-copy:15px;  --lh-copy:22px;
      --t-body:16px;  --lh-body:24px;
      --t-title:20px; --lh-title:28px;
      --t-hero:24px;  --lh-hero:32px;

      --bg:#F7F5F0; --panel:#F1EEE7; --raised:#FFFFFF; --sunk:#EAE7DF;
      --line:#DEDAD1; --line-soft:#E8E4DC; --line-strong:#C9C4B9;
      --fg:#17181A; --mut:#5F6165; --faint:#64666B;
      --acc:#5457CE; --acc-hi:#4B4EC2; --acc-text:#4F52C9; --acc-soft:#EDEDFA;
      --ok:#2F6B3D; --ok-line:#5C9268; --ok-soft:#EDF4EE;
      --warn:#7A5310; --warn-line:#BF8B2C; --warn-soft:#FBF4E6;
      --bad:#9B3A33; --bad-line:#C2564D; --bad-soft:#FBEFEE;
      --focus:#5457CE;
      --flow-head:#2F7DEB; --flow-tail:#4F52C9; --flow-far:#38BDF8;
      --dis-fg:#78797C; --dis-bd:#E0DCD3; --dis-bg:#EFEDE7; --dis-icon:#93918B;
      --shadow-menu:0 10px 30px rgba(23,24,26,.14), 0 1px 3px rgba(23,24,26,.10);
    }
    .app {
      /* Three persistent surfaces and nothing else: canvas, sidebar, floating
         layer. --raised is the floating/inset surface; --sunk is the quiet fill
         a row takes when it is hovered or selected. */
      --bg:#0E0F10; --panel:#171718; --raised:#1E1E20; --sunk:#252527;
      --line:#2B2B2E; --line-soft:#212123; --line-strong:#39393D;
      --fg:#ECECEA; --mut:#AAA9A3; --faint:#8B8C87;
      --acc:#6366D9; --acc-hi:#7275E2; --acc-text:#9698F2; --acc-soft:#191A2B;
      --ok:#7FB98A; --ok-line:#4F7A59; --ok-soft:#131C16;
      --warn:#D0A36B; --warn-line:#8A6A2E; --warn-soft:#1F1A10;
      --bad:#D8847B; --bad-line:#8E4A44; --bad-soft:#211413;
      /* Focus is blue and only blue, so it is never confused with selection. */
      --focus:#5B7CFF;
      --flow-head:#38BDF8; --flow-tail:#6366D9; --flow-far:#3B82F6;
      --dis-fg:#85878A; --dis-bd:#2A2D31; --dis-bg:#141518; --dis-icon:#6C6F73;
      --shadow-menu:0 16px 40px rgba(0,0,0,.55), 0 2px 6px rgba(0,0,0,.4);
      /* The sidebar is one surface with rows on it. These name the states a
         row can take so no rule reaches for an accent to show selection. */
      --sidebar-hover:#212123; --sidebar-selected:#272729; --sidebar-line:#2B2B2E;
      --sidebar-secondary:#AAA9A3; --sidebar-tertiary:#777873;
    }

    /* ---- reset / base ------------------------------------------------ */
    *, *::before, *::after { box-sizing: border-box; }
    /* Any author rule that sets display beats the UA [hidden] rule, and most of
       our rows carry an inline display:flex. Without this, setting .hidden on a
       row updated the count but left the row painted. */
    [hidden] { display: none !important; }
    html, body { height: 100%; }
    body { margin: 0; background: var(--bg); color: var(--fg);
      font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
      font-size: 14px; line-height: 20px; -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility; }
    button, input, textarea, select { font: inherit; color: inherit; }
    button { background: none; border: 0; padding: 0; cursor: pointer; }
    a { color: var(--acc-text); text-decoration: none; }
    a:hover { text-decoration: underline; }
    /* A standalone link is a control and needs a hit area. Links inside a
       paragraph keep the paragraph line-height and are exempt. */
    /* A standalone link is a control. Links written inside a paragraph, list
       item or definition keep the paragraph line-height and are excluded. */
    /* A standalone link is a control. Only links written inside running prose
       are exempt, so the exclusion is <p> and <dd>, not every list item: a
       catalog row is an <li> and its title link is very much a control. */
    a.link,
    .msec a:not(p a):not(dd a):not(.btn):not(.brand),
    .mfoot a:not(p a):not(.btn):not(.brand),
    .mhead [data-nav] a:not(.btn) {
      display: inline-flex; align-items: center; min-height: 40px; }
    .mfoot a:not(.btn), .mhead [data-nav] a:not(.btn) { font-size: 14px; }
    .brand { min-height: 40px; }
    :focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
    ::selection { background: var(--acc); color: #fff; }

    /* ---- type -------------------------------------------------------- */
    .m { font-family: "Geist Mono", "Cascadia Mono", ui-monospace, Consolas, monospace;
      font-size: var(--t-label); line-height: 21px; }
    /* .lab is the optional-metadata floor at 12px. Functional labels use
       .lab-fn at 13px. Nothing customer-facing goes below 12px. */
    /* Section labels are sans and sentence case. Monospace with letter spacing
       made every heading look like a placeholder in a generated layout; mono is
       for code, paths, quantizations, hashes and numeric logs only. */
    .lab { font-size: 13px; line-height: 18px; font-weight: 500; color: var(--mut); }
    .lab-fn { font-size: 13px; line-height: 18px; }
    .h1 { font-size: 28px; line-height: 34px; font-weight: 600; letter-spacing: -.015em; margin: 0; }
    .h2 { font-size: 16px; line-height: 24px; font-weight: 600; margin: 0; }
    .h3 { font-size: 15px; line-height: 22px; font-weight: 600; margin: 0; }
    .h-sec { font-size: 18px; line-height: 26px; font-weight: 600; margin: 0; }
    .mut { color: var(--mut); }
    .faint { color: var(--faint); }
    .prose { font-size: 15px; line-height: 22px; }
    .prose p { margin: 0 0 14px; }
    .prose p:last-child { margin-bottom: 0; }

    /* ---- surfaces ---------------------------------------------------- */
    .app, .site { background: var(--bg); color: var(--fg); }
    .box { border: 1px solid var(--line); background: var(--raised); border-radius: 8px; }
    .soft { background: var(--sunk); }
    .menu { border: 1px solid var(--line); background: var(--raised); border-radius: 10px;
      box-shadow: var(--shadow-menu); }

    /* ---- app shell --------------------------------------------------- */
    .shell { display: flex; height: 100%; min-height: 0; overflow: hidden; }
    /* One flat surface, one divider at the canvas edge. No gradient, no rail. */
    .sidebar { width: 256px; flex-shrink: 0; border-right: 1px solid var(--sidebar-line);
      background: var(--panel); display: flex; flex-direction: column; min-height: 0; }
    .main { flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--bg); }
    .topbar { height: 52px; flex-shrink: 0; display: flex; align-items: center; gap: 10px;
      padding: 0 16px 0 12px; border-bottom: 1px solid var(--line-soft); }
    .scroll { flex: 1; min-height: 0; overflow: hidden; }
    .col { width: 100%; max-width: 792px; margin: 0 auto; padding: 0 28px; }
    .drawer { position: relative; width: 480px; flex-shrink: 0;
      border-left: 1px solid var(--line); background: var(--panel);
      display: flex; flex-direction: column; min-height: 0; }

    /* sidebar rows */
    .srow { display: flex; align-items: center; gap: 10px; min-height: 40px; padding: 4px 10px;
      border-radius: 8px; font-size: 14px; color: var(--mut); cursor: pointer;
      transition: background 140ms ease, color 140ms ease; width: 100%; text-align: left; }
    .srow:hover { background: var(--sunk); color: var(--fg); }
    /* An active row is the same neutral fill an active chat gets, so the
       footer belongs to the same navigation rather than looking like a widget
       with its own outline. */
    .srow[aria-current="true"], .srow.on { background: var(--sidebar-selected); color: var(--fg);
      font-weight: 500; }
    .srow .t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .sgroup { font-size: 13px; line-height: 18px; font-weight: 500;
      color: var(--sidebar-secondary); padding: 0 10px; height: 30px;
      display: flex; align-items: center; letter-spacing: .02em; }

    /* ---- model detail drawer -------------------------------------------------- */
    .mdrawer-host { position: absolute; inset: 0; z-index: 80; }
    .mdrawer-host[hidden] { display: none !important; }
    .mdrawer-scrim { position: absolute; inset: 0; background: rgba(0,0,0,.42); }
    .mdrawer { position: absolute; top: 0; right: 0; bottom: 0; width: min(520px, 92vw);
      border-left: 1px solid var(--line); background: var(--bg);
      display: flex; flex-direction: column; box-shadow: var(--shadow-menu); }
    .mdrawer-h { flex-shrink: 0; display: flex; align-items: center; gap: 10px;
      min-height: 52px; padding: 0 12px 0 20px; border-bottom: 1px solid var(--line-soft); }
    .mdrawer-b { flex: 1; min-height: 0; overflow-y: auto; padding: 20px 20px 28px; }
    .mdrawer-s { margin: 0; display: flex; align-items: center; gap: 8px;
      font-size: 14px; color: var(--mut); }
    .mdrawer-f { flex-shrink: 0; display: flex; align-items: center; gap: 8px;
      padding: 12px 16px; border-top: 1px solid var(--line-soft); }
    /* the row title is a control, and the whole row is its target */
    button.rname { font: inherit; font-size: 16px; line-height: 24px; font-weight: 600;
      color: var(--fg); text-align: left; }
    button.rname::after { content: ""; position: absolute; inset: 0; }
    .rrow.has-action button.rname::after { content: none; }
    .rrow.has-action button.rname { padding: 9px 10px 9px 0; margin: -9px -10px -9px 0; }

    .diag-steps { margin: 10px 0 0; padding-left: 20px; }
    .diag-steps li { font-size: 14px; line-height: 20px; color: var(--mut); margin-bottom: 8px; }
    .diag-steps li::marker { color: var(--faint); }

    /* ---- first run ---------------------------------------------------------- */
    /* A new user has no history, no second project and no settings to manage
       yet, so none of that is drawn. */
    .sidebar[data-sidebar-mode="first-run"] .side-search,
    .sidebar[data-sidebar-mode="first-run"] .cgroup,
    .sidebar[data-sidebar-mode="first-run"] .chat-archived,
    .sidebar[data-sidebar-mode="first-run"] .side-foot { display: none; }
    .sidebar[data-sidebar-mode="first-run"] [data-first-run] { display: block; }

    /* ---- downloads ---------------------------------------------------------- */
    .dlrow { display: grid; grid-template-columns: minmax(0,1fr) 168px auto; gap: 6px 20px;
      align-items: center; padding: 16px 2px; }
    .dl-main { min-width: 0; display: flex; flex-direction: column; gap: 7px; }
    .dl-n { font-size: 15px; line-height: 22px; font-weight: 500; }
    .dl-track { width: 100%; max-width: 320px; }
    .dl-m { margin: 0; font-size: var(--t-label); line-height: var(--lh-label); color: var(--mut); max-width: 62ch; }
    .dl-s { font-size: 14px; }
    .dl-s.is-bad { color: var(--bad); }
    .dl-a { display: flex; gap: 8px; justify-self: end; }
    @media (max-width: 860px) {
      .dlrow { grid-template-columns: minmax(0,1fr); }
      .dl-s, .dl-a { justify-self: start; }
    }

    /* ---- settings ----------------------------------------------------------- */
    /* A section list and one readable column. Each row is a label, a sentence
       of consequence and the current value. */
    .setwrap { display: flex; overflow-y: auto; }
    .setnav { flex-shrink: 0; width: 208px; padding: 24px 8px; position: sticky; top: 0;
      align-self: flex-start; }
    .setnav .srow.is-on { background: var(--sidebar-selected); color: var(--fg); font-weight: 500; }
    .setcol { flex: 1; min-width: 0; max-width: 680px; padding: 24px 28px 64px; }
    .setsec { padding-top: 32px; }
    .setsec:first-child { padding-top: 0; }
    .setsec > h1, .setsec > h2 { margin: 0 0 4px; }
    .set-lede { margin: 8px 0 4px; font-size: 15px; line-height: 22px; color: var(--mut);
      max-width: 68ch; }
    .set-h3 { margin: 26px 0 0; font-size: 14px; line-height: 20px; font-weight: 600; }
    .setrow { display: flex; align-items: flex-start; gap: 20px; padding: 16px 0;
      border-top: 1px solid var(--line-soft); }
    .setsec > .setrow:first-of-type { border-top: 1px solid var(--line); margin-top: 14px; }
    .setrow > div:first-child { flex: 1; min-width: 0; }
    .set-l { font-size: 15px; line-height: 22px; font-weight: 500; }
    .set-d { margin: 3px 0 0; font-size: 14px; line-height: 20px; color: var(--mut);
      max-width: 62ch; }
    .set-v { flex-shrink: 0; font-size: 14px; line-height: 20px; color: var(--mut);
      text-align: right; max-width: 40%; overflow-wrap: anywhere; }
    .set-empty { margin: 14px 0 0; font-size: 14px; line-height: 20px; color: var(--faint); }
    .setrow[hidden] { display: none !important; }
    /* a switch that states its value in text as well as position */
    .switch { flex-shrink: 0; width: 44px; height: 40px; border: 0; background: none;
      padding: 0; position: relative; cursor: pointer; }
    .switch::before { content: ""; position: absolute; inset: 7px 0; border-radius: 13px;
      border: 1px solid var(--line-strong); background: var(--sunk);
      transition: background 140ms ease-out, border-color 140ms ease-out; }
    .switch > span { position: absolute; top: 10px; left: 3px; width: 18px; height: 18px;
      border-radius: 50%; background: var(--mut); transition: transform 160ms ease-out,
      background 160ms ease-out; }
    .switch[aria-checked="true"]::before { background: var(--acc); border-color: var(--acc); }
    .switch[aria-checked="true"] > span { transform: translateX(18px); background: #fff; }
    @media (max-width: 860px) {
      .setwrap { flex-direction: column; }
      .setnav { width: auto; position: static; display: flex; gap: 4px; overflow-x: auto;
        padding: 12px 12px 8px; border-bottom: 1px solid var(--line-soft); }
      .setnav .srow { width: auto; white-space: nowrap; }
      .setcol { padding: 20px 16px 56px; }
    }

    /* ---- details popovers --------------------------------------------------- */
    /* Project and runtime context, on demand, instead of permanent metrics in
       the header. */
    .pdetails { top: calc(100% + 6px); left: 0; width: min(320px, calc(100vw - 16px));
      padding: 14px 16px 12px; }
    .pd-h { margin: 0 0 10px; display: flex; align-items: center; gap: 8px;
      font-size: 14px; font-weight: 600; }
    .pd-kv { margin: 0; display: grid; grid-template-columns: 108px 1fr; gap: 7px 12px; }
    .pd-kv dt { font-size: var(--t-label); line-height: var(--lh-label); color: var(--faint); }
    .pd-kv dd { margin: 0; font-size: 14px; line-height: 20px; overflow-wrap: anywhere; }
    .pd-bar { margin-top: 12px; display: flex; flex-direction: column; gap: 6px;
      font-size: 13px; line-height: 18px; }
    .pd-a { display: flex; gap: 8px; flex-wrap: wrap; padding-top: 10px; }
    .pdetails .sep { margin: 12px -16px 0; }
    /* A panel taller than the viewport scrolls inside itself rather than
       running off the bottom. */
    .pdetails { max-height: calc(100vh - 76px); overflow-y: auto; }

    /* ---- focused task shell ------------------------------------------------ */
    /* One field, one decision: a centred card and a slim footer instead of the
       full marketing page. */
    .authwrap { display: flex; justify-content: center; padding-top: 72px; padding-bottom: 72px; }
    .authcard { width: 100%; max-width: 460px; }
    .mfoot-slim { margin-top: 48px; }
    .mfoot-slim .mfoot-legal { padding-top: 20px; padding-bottom: 20px; }
    .mfoot-slim .mfoot-legal a:not(.brand) { font-size: 14px; color: var(--mut); }

    /* ---- dialog ----------------------------------------------------------- */
    /* One shape for every scoped decision. It says what the choice costs and
       what survives it, which a native confirm cannot. */
    .dlg-host { position: fixed; inset: 0; z-index: 300; }
    .dlg-host[hidden] { display: none !important; }
    .dlg-scrim { position: absolute; inset: 0; background: rgba(0,0,0,.5); }
    .dlg { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
      width: min(440px, calc(100vw - 32px)); border: 1px solid var(--line-strong);
      border-radius: 14px; background: var(--raised); box-shadow: var(--shadow-menu);
      padding: 22px 22px 18px; }
    .dlg-t { margin: 0 0 8px; font-size: 17px; line-height: 25px; font-weight: 600;
      letter-spacing: -.01em; }
    .dlg-b p { margin: 0; font-size: 15px; line-height: 22px; color: var(--mut); }
    .dlg-scope { margin: 14px 0 0; display: grid; grid-template-columns: 132px 1fr;
      gap: 8px 14px; padding-top: 14px; border-top: 1px solid var(--line-soft); }
    .dlg-scope dt { font-size: var(--t-label); line-height: var(--lh-label); color: var(--faint); }
    .dlg-scope dd { margin: 0; font-size: 14px; line-height: 20px; }
    .dlg-a { display: flex; justify-content: flex-end; gap: 8px; margin-top: 20px; }
    body.has-dlg { overflow: hidden; }

    /* ---- scrollbars ------------------------------------------------------- */
    /* Scoped to the dark shell so the light marketing pages keep their own. */
    .app { color-scheme: dark; }
    .app .thread-scroll, .app .scroll, .app pre, .app .drawer,
    .app [data-diff-view], .app .chat-list {
      scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; }
    .app ::-webkit-scrollbar { width: 10px; height: 10px; }
    .app ::-webkit-scrollbar-track { background: transparent; }
    .app ::-webkit-scrollbar-thumb { background: var(--line-strong);
      border-radius: 6px; border: 3px solid transparent; background-clip: content-box; }
    .app ::-webkit-scrollbar-thumb:hover { background: var(--mut);
      border: 3px solid transparent; background-clip: content-box; }
    .app ::-webkit-scrollbar-corner { background: transparent; }

    /* ---- conversation --------------------------------------------------- */
    /* One geometry for every conversation: a 748px thread column, the composer
       docked to the same column, and three levels of emphasis — message,
       then activity, then controls. */
    .thread-scroll { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain;
      display: flex; flex-direction: column; }
    .col { width: 100%; max-width: 748px; margin: 0 auto; padding: 0 28px; }
    .thread { display: flex; flex-direction: column; gap: 40px;
      padding-top: 28px; padding-bottom: 28px; }
    /* the last turn's action row lives in the gutter below it, so the thread
       needs room for one before the composer starts */
    .thread { flex: 0 0 auto; padding-bottom: 48px; }
    /* Start composition: heading, composer, context strip and recents are one
       centred cluster. Previously the heading sat at 34% and the composer was
       docked at the bottom, leaving ~400px of nothing between the only two
       things on the screen. */
    [data-composition="start"] .thread-scroll { justify-content: center; }
    [data-composition="start"] .thread { flex: 0 0 auto; padding: 0 0 30px; }
    [data-composition="start"] .dock { position: static; margin-top: 0;
      padding-bottom: 0; background: none; }
    [data-composition="start"] .dock::before { display: none; }
    [data-composition="start"] .col { max-width: 760px; }
    /* the cluster is nudged above true centre, where a reading eye expects it */
    [data-composition="start"] .thread-scroll > :first-child { margin-top: auto; }
    [data-composition="start"] .dock { margin-bottom: auto; }
    .thread.is-empty { gap: 0; }
    /* A new session has no title and no state, so it gets no header and no
       rule under it. The rail controls stay reachable in the corner. */
    [data-composition="start"] .topbar { border-bottom: 0; }
    [data-composition="start"] .topbar > div:nth-child(2),
    [data-composition="start"] [data-ws-title] { display: none; }
    /* The recomposition is one settle, not a flight across the canvas. */
    .is-recomposing .thread-scroll > * { animation: recompose 220ms ease-out; }
    @keyframes recompose { from { opacity: 0; transform: translateY(10px); } }
    @media (prefers-reduced-motion: reduce) {
      .is-recomposing .thread-scroll > * { animation: none; }
    }

    /* Recent sessions: plain rows, no card, no chevron, no description. */
    .recents { display: flex; flex-direction: column; margin-top: 20px; }
    .recents > a { display: flex; align-items: center; gap: 11px; min-height: 44px;
      padding: 0 12px; border-radius: 8px; font-size: 14px; line-height: 20px;
      color: var(--mut); text-decoration: none;
      transition: background 140ms ease-out, color 140ms ease-out; }
    .recents > a:hover { background: var(--sunk); color: var(--fg); text-decoration: none; }
    .recents > a:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
    .recents svg { flex-shrink: 0; color: var(--faint); }
    .recents .t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .turn { display: flex; flex-direction: column; gap: 12px; }
    .turn-user { align-items: flex-end; }

    /* user message: one quiet raised surface, no border, no shadow */
    .umsg { max-width: 74%; }
    .umsg-body { background: var(--sunk); border-radius: 19px; padding: 11px 15px;
      font-size: 16px; line-height: 24px; white-space: pre-wrap; overflow-wrap: anywhere; }
    .uedit { width: min(74vw, 640px); display: flex; flex-direction: column; gap: 8px; }
    .uedit-t { width: 100%; min-height: 68px; max-height: 220px; resize: none;
      border: 1px solid var(--acc); border-radius: 12px; background: var(--bg);
      color: var(--fg); font: inherit; font-size: 16px; line-height: 24px; padding: 10px 14px;
      outline: none; }
    .uedit-a { display: flex; gap: 8px; justify-content: flex-end; }

    /* assistant prose sits on the page, no bubble */
    .amsg { font-size: 16px; line-height: 24px; }
    .amsg p { margin: 0 0 14px; }
    .amsg p:last-child { margin-bottom: 0; }
    .amsg h2 { font-size: 20px; line-height: 28px; margin: 22px 0 8px; font-weight: 600; }
    .amsg h3 { font-size: 17px; line-height: 25px; margin: 18px 0 6px; font-weight: 600; }
    .tnote { display: flex; align-items: flex-start; gap: 9px; margin: 0;
      font-size: 15px; line-height: 22px; }
    .tnote svg { flex-shrink: 0; margin-top: 5px; }

    .plan { display: flex; flex-direction: column; gap: 2px; margin-top: 14px; }
    .plan-h { font-size: 13px; line-height: 18px; font-weight: 500; color: var(--mut);
      padding-bottom: 4px; }
    .plan-row { display: flex; align-items: center; gap: 10px; min-height: 28px;
      font-size: 15px; color: var(--mut); }
    .plan-row.is-now { color: var(--fg); font-weight: 500; }
    .plan-row.is-todo { color: var(--faint); }
    .plan-i { width: 14px; display: inline-flex; justify-content: center; flex-shrink: 0; }
    .box-todo { width: 13px; height: 13px; border-radius: 4px;
      border: 1px solid var(--line-strong); display: block; }

    /* code: quiet header, always-visible copy, horizontal scroll, never wrapped */
    .cblock { margin: 16px 0 0; border: 1px solid var(--line); border-radius: 10px;
      overflow: hidden; background: var(--panel); }
    .cblock-h { display: flex; align-items: center; gap: 10px; padding: 6px 8px 6px 14px;
      border-bottom: 1px solid var(--line-soft); }
    .cblock-h .m { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis;
      white-space: nowrap; color: var(--faint); }
    .cblock pre { margin: 0; padding: 12px 14px; overflow-x: auto;
      font-size: 14px; line-height: 20px; }

    /* ---- activity group -------------------------------------------------- */
    /* One low-contrast surface with internal rules. Never a card per row. */
    .num.add { color: var(--ok); font-variant-numeric: tabular-nums; font-size: 13px; }
    .num.del { color: var(--bad); font-variant-numeric: tabular-nums; font-size: 13px; }
    .frow { display: flex; align-items: center; gap: 10px; min-height: 34px; padding: 2px 14px;
      font-size: 14px; }
    .frow-n { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis;
      white-space: nowrap; direction: rtl; text-align: left; }
    .adiag { border-top: 1px solid var(--line-soft); margin-top: 4px; }
    .adiag summary { cursor: pointer; list-style: none; min-height: 40px; display: flex;
      align-items: center; padding: 0 14px; font-size: 14px; color: var(--mut); }
    .adiag summary::-webkit-details-marker { display: none; }
    .adiag summary:hover { color: var(--fg); }
    .adiag pre { margin: 0 14px 12px; padding: 10px 12px; border-radius: 6px;
      background: var(--bg); border: 1px solid var(--line-soft); color: var(--mut);
      font-size: 13px; line-height: 18px; overflow-x: auto; }

    /* ---- permission ------------------------------------------------------ */
    /* A real decision point stays a contained surface; once decided it becomes
       an immutable one-line result that cannot look actionable. */
    /* A decision, not an alert. One narrow amber rule marks it as needing an
       answer; an amber fill inside an amber perimeter made a routine pause
       look like a failure. */
    .perm { border: 0; border-left: 2px solid var(--warn-line); border-radius: 0;
      background: none; padding: 2px 0 4px 14px; }
    .perm-kv { margin: 0; display: grid; grid-template-columns: 108px 1fr; gap: 8px 14px; }
    .perm-kv dt { font-size: var(--t-label); line-height: var(--lh-label); color: var(--faint); }
    .perm-kv dd { margin: 0; font-size: 14px; line-height: 20px; }
    .perm-a { margin-top: 12px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    /* the command is a code row, so it reads as the thing being approved */
    .perm-cmd { margin: 8px 0 0; padding: 9px 12px; border-radius: 7px;
      background: var(--sunk); font-family: "Geist Mono", "Cascadia Mono", ui-monospace, Consolas, monospace;
      font-size: 13px; line-height: 18px; color: var(--fg); overflow-x: auto; }

    .recover-x { font-size: 14px; color: var(--acc-text); padding: 0 8px; }

    /* one primary recovery, neutral alternatives, diagnostics as text */
    .recover { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .recover-done { font-size: 14px; line-height: 20px; color: var(--mut); flex: 1; min-width: 200px; }

    /* ---- message actions ------------------------------------------------- */
    /* Reserved space, so revealing them never shifts the thread. */
    .mactions { display: flex; gap: 2px; height: 40px; align-items: center;
      opacity: 0; transition: opacity 140ms ease-out; }
    /* Out of flow, in the gutter between turns, starting at the content
       boundary rather than above it. The row itself never intercepts a
       pointer; only its buttons do, and only while they are visible. */
    .turn > .mactions { position: absolute; left: 0; right: 0; top: 100%;
      margin-top: 0; pointer-events: none; }
    .turn > .mactions .mact { pointer-events: none; }
    .turn { position: relative; }
    .turn:hover > .mactions, .turn:focus-within > .mactions { opacity: 1; }
    .turn:hover > .mactions .mact, .turn:focus-within > .mactions .mact { pointer-events: auto; }
    .turn-user > .mactions { justify-content: flex-end; }
    /* a coarse pointer has no hover, so the actions stay put and readable */
    @media (hover: none), (pointer: coarse) {
      .turn > .mactions { position: static; opacity: 1; margin-top: 4px; height: 44px; }
      .turn > .mactions .mact { pointer-events: auto; }
      .mact { min-height: 44px; min-width: 44px; }
    }
    .mact { display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      min-height: 40px; min-width: 40px; padding: 0 8px; border-radius: 7px;
      color: var(--mut); font-size: 13px;
      transition: background 140ms ease-out, color 140ms ease-out; }
    .mact:hover { background: var(--sunk); color: var(--fg); }
    .mact.is-done { color: var(--ok); }
    .mact[aria-pressed="true"] { color: var(--acc-text); background: var(--sunk); }
    .mact-i { display: inline-flex; }

    .thinking { display: flex; align-items: center; gap: 10px; margin: 0;
      font-size: 15px; color: var(--mut); }
    .haltnote { display: flex; align-items: center; gap: 9px; margin: 0;
      font-size: 15px; line-height: 22px; color: var(--faint); }
    .haltnote svg { flex-shrink: 0; }
    @keyframes fl-spin { to { transform: rotate(360deg); } }
    .spin { width: 13px; height: 13px; flex-shrink: 0; border-radius: 50%;
      border: 1.7px solid var(--line-strong); border-top-color: var(--acc);
      animation: fl-spin 720ms linear infinite; display: block; }

    /* ---- dock ------------------------------------------------------------ */
    /* The composer sits on the same column as the thread, with a canvas-coloured
       fade so content does not end in a hard cut. */
    .dock { position: sticky; bottom: 0; z-index: 6; flex-shrink: 0;
      padding-bottom: 14px; margin-top: auto; background: var(--bg); }
    .dock::before { content: ""; position: absolute; left: 0; right: 0; bottom: 100%;
      height: 40px; pointer-events: none;
      background: linear-gradient(to top, var(--bg), transparent); }
    .dock-inner { position: relative; }
    .jump { position: absolute; left: 50%; bottom: calc(100% + 10px); transform: translateX(-50%);
      display: inline-flex; align-items: center; gap: 7px; min-height: 40px; padding: 0 16px;
      border: 1px solid var(--line-strong); border-radius: 18px; background: var(--raised);
      color: var(--fg); font-size: var(--t-label); line-height: var(--lh-label); white-space: nowrap; box-shadow: var(--shadow-menu);
      transition: background 140ms ease-out; z-index: 5; }
    .jump:hover { background: var(--sunk); }
    .jump[hidden] { display: none !important; }

    /* ---- empty conversation ---------------------------------------------- */
    /* A question above the input and nothing else. The mark is small and quiet
       so the eye lands on the question, then on the composer under it. */
    .empty { display: flex; flex-direction: column; align-items: center; gap: 14px; }
    .empty-mark { color: var(--faint); line-height: 0; }
    .empty-q { margin: 0; font-size: var(--t-hero); line-height: var(--lh-hero); font-weight: 600;
      letter-spacing: -0.3px; color: var(--fg); text-align: center; }
    @media (max-width: 720px) {
      .btn, .ico, .btn.btns, .btn.ico { min-height: 44px; }
      .composer .ico, .composer .btn { min-height: 44px; }
      .drawer-h .btn, .dl-a .btn, [data-dl-toggle], [data-act-toggle] { min-height: 44px; }
      .empty-q { font-size: 22px; line-height: 30px; }
    }
    @media (max-width: 640px) {
      .col { padding: 0 16px; }
      .umsg { max-width: 88%; }
    }
    @media (prefers-reduced-motion: reduce) {
      .thread-scroll { scroll-behavior: auto; }
    }

    /* ---- saved session view -------------------------------------------- */
    /* A historical chat renders here. It reuses .prose, .act, .arow and .box so
       it introduces no new visual language of its own. */
    .sview-msg { display: flex; justify-content: flex-end; }
    .sview-msg p { margin: 0; max-width: 78%; padding: 11px 14px; border-radius: 12px;
      background: var(--raised); border: 1px solid var(--line);
      font-size: 15px; line-height: 22px; }
    .sview .arow { padding-left: 16px; padding-right: 16px; }
    .sview-file { display: flex; align-items: center; gap: 12px; min-height: 38px;
      padding: 5px 14px; font-size: 13px; }
    .sview-file .n { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis;
      white-space: nowrap; }
    .sview-file .a { color: var(--ok); font-variant-numeric: tabular-nums; }
    .sview-file .d { color: var(--bad); font-variant-numeric: tabular-nums; }

    /* ---- chat selector ------------------------------------------------ */
    /* The sidebar is a chat selector scoped to one project. Rows are 42px, the
       row menu appears on hover, focus and selection, and nothing here borrows
       the workspace's own surfaces. */
    /* One horizontal grid for every row in the sidebar: 8px outer inset, and
       text 12px inside that. Search, project, chats and the footer all sit on
       it, so nothing reads as a component dropped into a panel. */
    .side-hd { height: 52px; flex-shrink: 0; display: flex; align-items: center; gap: 8px;
      padding: 0 10px; }
    .side-hd-t { font-size: 15px; line-height: 22px; font-weight: 600; letter-spacing: -.005em;
      color: var(--fg); }
    .side-search { flex-shrink: 0; padding: 0 8px 4px; }
    /* Not a form card: a quiet row that fills only when it is used. */
    .side-search .field { height: 36px; width: 100%; border: 0; border-radius: 7px;
      background: transparent; transition: background 140ms ease-out; }
    .side-search .field:hover { background: var(--sidebar-hover); }
    .side-search .field:focus-within { background: var(--sidebar-hover);
      outline: 2px solid var(--focus); outline-offset: -2px; }
    .side-search input { font-size: 14px; color: var(--fg); }
    .side-search input::placeholder { color: var(--sidebar-tertiary); }
    .side-project { flex-shrink: 0; padding: 0 8px 10px; }
    .chat-list { flex: 1; min-height: 0; overflow-y: auto; padding: 0 8px 8px; }
    .side-foot { flex-shrink: 0; border-top: 1px solid var(--sidebar-line); padding: 8px; }
    /* the footer uses the chat rows' geometry exactly, not its own */
    .side-foot .srow { min-height: 40px; padding: 0 12px; border-radius: 7px;
      color: var(--sidebar-secondary); }
    .side-foot .srow:hover { background: var(--sidebar-hover); color: var(--fg); }

    /* The project switcher is a navigation row, not a second input. */
    .side-project .field { display: flex; align-items: center; gap: 10px; width: 100%;
      height: 36px; padding: 0 12px; border: 0; border-radius: 7px; background: transparent;
      font-size: 14px; line-height: 20px; font-weight: 500; color: var(--fg);
      transition: background 140ms ease-out; }
    .side-project .field:hover { background: var(--sidebar-hover); }
    .side-project .field:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }

    .cgroup[hidden] { display: none !important; }
    .cgroup-hd { margin: 0; }
    /* Sentence case, sans, normal tracking. The monospaced label read as a
       developer placeholder rather than a section of the user's own work. */
    .cgroup-hd > button { display: flex; align-items: center; gap: 6px; width: 100%;
      min-height: 30px; padding: 0 12px; border-radius: 6px;
      font-size: var(--t-label); line-height: var(--lh-label); font-weight: 500;
      letter-spacing: 0; color: var(--sidebar-secondary); text-align: left; }
    .cgroup-hd > button:hover { color: var(--fg); }
    .cgroup-hd svg { flex-shrink: 0; transition: transform 140ms ease-out; }
    .cgroup-hd > button[aria-expanded="false"] svg { transform: rotate(-90deg); }
    .cgroup-hd > button[aria-expanded="false"] + .cgroup-body,
    .cgroup-body[hidden] { display: none; }

    /* Selection is a neutral fill and a heavier title. The violet rail made
       selection, running and needs-input look like one state. */
    .chat { position: relative; display: flex; align-items: center; border-radius: 7px;
      transition: background 140ms ease-out; }
    .chat:hover { background: var(--sidebar-hover); }
    .chat.is-on { background: var(--sidebar-selected); }
    .chat.is-on:hover { background: var(--sidebar-selected); }
    .chat[hidden] { display: none !important; }
    .chat-open { flex: 1; min-width: 0; display: flex; align-items: center; gap: 8px;
      min-height: 38px; padding: 0 4px 0 12px; font-size: 14px; line-height: 20px;
      color: var(--sidebar-secondary); text-align: left; }
    .chat.is-on .chat-open { color: var(--fg); font-weight: 500; }
    .chat-open .t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis;
      white-space: nowrap; }
    /* Status sits at the right, in a reserved slot, so revealing the row menu
       never shifts the title. */
    .chat-mark { display: inline-flex; width: 14px; flex-shrink: 0; justify-content: center;
      color: var(--acc-text); }
    .chat-mark.is-need { color: var(--warn); }
    .chat:hover .chat-mark, .chat:focus-within .chat-mark { display: none; }
    /* the row menu is present for the pointer, the keyboard and the selection */
    .chat-more { width: 30px; min-width: 30px; height: 30px; flex-shrink: 0; margin-right: 4px;
      display: flex; align-items: center; justify-content: center; color: var(--faint);
      border-radius: 7px; opacity: 0; transition: opacity 140ms ease-out, color 140ms ease-out; }
    .chat:hover .chat-more, .chat.is-on .chat-more,
    .chat-more:focus-visible, .chat-more[aria-expanded="true"] { opacity: 1; }
    .chat-more:hover { color: var(--fg); background: var(--line-soft); }
    /* the inline rename field replaces the title in place */
    .chat-rename { flex: 1; min-width: 0; height: 30px; border: 1px solid var(--acc);
      border-radius: 6px; background: var(--bg); color: var(--fg); font-size: 14px;
      padding: 0 8px; outline: none; }
    .chat-empty { margin: 14px 10px; font-size: 14px; line-height: 20px; color: var(--faint); }
    .chat-archived { padding: 6px 2px 0; }
    .chat-archived-toggle { min-height: 40px; padding: 0 8px; font-size: var(--t-label); line-height: var(--lh-label);
      color: var(--faint); border-radius: 6px; width: 100%; text-align: left; }
    .chat-archived-toggle:hover { color: var(--mut); background: var(--sunk); }

    .chat-menu { width: 232px; padding: 6px; }
    .chat-menu > button { display: flex; align-items: center; gap: 9px; width: 100%;
      min-height: 40px; padding: 0 10px; border-radius: 7px; font-size: 14px;
      color: var(--fg); text-align: left; }
    .chat-menu > button:hover { background: var(--sunk); }
    .chat-menu > button.is-bad { color: var(--bad); }
    .chat-menu > button.is-bad:hover { background: var(--bad-soft); }
    .chat-menu .sep { margin: 5px 0; }
    .chat-menu-hd { margin: 4px 0 2px; padding: 0 10px;
      font-size: 13px; line-height: 18px; font-weight: 500; color: var(--sidebar-secondary); }
    .chat-menu .check { width: 14px; flex-shrink: 0; color: var(--acc-text); }
    .chat-menu [aria-checked="true"] .check::before { content: "\2713"; }

    /* ---- controls ---------------------------------------------------- */
    /* 40px is the floor for every control; 44px for primary actions. The dense
       variant trades padding, never height. */
    /* Interactive text never drops below the label size, whatever the
       control's own height is. */
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      height: 40px; padding: 0 14px; border: 1px solid var(--line-strong); background: var(--raised);
      border-radius: 8px; font-size: 14px; line-height: 20px; color: var(--fg); white-space: nowrap;
      transition: background 140ms ease-out, border-color 140ms ease-out, color 140ms ease-out; }
    .btn:hover { background: var(--sunk); }
    .btnp { background: var(--acc); border-color: var(--acc); color: #fff; }
    .btnp:hover { background: var(--acc-hi); border-color: var(--acc-hi); }
    .btnq { background: transparent; border-color: transparent; color: var(--mut); }
    .btnq:hover { background: var(--sunk); color: var(--fg); }
    .btnd { border-color: var(--bad-line); color: var(--bad); }
    .btns { height: 40px; padding: 0 12px; font-size: var(--t-label); line-height: var(--lh-label); border-radius: 8px; }
    .btnl { height: 44px; padding: 0 20px; font-size: 15px; border-radius: 10px; }
    .ico { width: 40px; min-width: 40px; padding: 0; flex-shrink: 0; }
    .ico.btns { width: 40px; min-width: 40px; }

    /* Stop replaces Send in the same control, in the same place.
       The control is an icon, not a button object: no fill, no border, no
       rounded container in its default state. The 36x36 hit area stays, and so
       does the icon size, so nothing moves when Send becomes Stop.
       These carry .btn as well as .sendbtn so they beat the generic .btn
       disabled and hover rules further down the sheet, which are the same
       specificity and would otherwise win on order alone. */
    .btn.sendbtn { background: none; border: 0; border-radius: 8px;
      width: 36px; min-width: 36px; height: 36px; min-height: 36px; padding: 0;
      color: var(--acc);
      transition: background 140ms ease, color 140ms ease; }
    .btn.sendbtn:hover:not(:disabled) { background: var(--sunk); color: var(--acc-hi); }
    .btn.sendbtn:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
    /* Muted when there is nothing to send, brighter when there is. Opacity is
       not used, so the disabled icon stays legible rather than ghosted. */
    .btn.sendbtn:disabled, .btn.sendbtn[aria-disabled="true"],
    .btn.sendbtn:disabled:hover, .btn.sendbtn[aria-disabled="true"]:hover {
      background: none; border-color: transparent; color: var(--faint);
      opacity: 1; cursor: default; }
    .btn.sendbtn:disabled svg, .btn.sendbtn[aria-disabled="true"] svg { opacity: 1; }
    .btn.sendbtn .i-stop { width: 12px; height: 12px; border-radius: 2px; background: currentColor;
      display: none; }
    /* Stop is the same box and the same 15px optical size as the arrow, so the
       swap costs no layout. */
    .btn.sendbtn[data-stop="true"] { background: none; border: 0; color: var(--fg); }
    .btn.sendbtn[data-stop="true"]:hover { background: var(--sunk); color: var(--fg); }
    .btn.sendbtn[data-stop="true"] .i-send { display: none; }
    .btn.sendbtn[data-stop="true"] .i-stop { display: block; }


    /* ---- segmented control ------------------------------------------- */
    /* One object instead of a row of loose pills. Children keep whatever
       pressed/unpressed behaviour the page already wired. */
    .seg { display: inline-flex; border: 1px solid var(--line); border-radius: 8px;
      background: var(--raised); overflow: hidden; }
    .seg > button { height: 40px; padding: 0 13px; font-size: 14px; color: var(--mut);
      border-left: 1px solid var(--line); white-space: nowrap;
      transition: background 140ms ease-out, color 140ms ease-out; }
    .seg > button:first-child { border-left: 0; }
    .seg > button:hover { background: var(--sunk); color: var(--fg); }
    .seg > button[aria-pressed="true"] { background: var(--sunk); color: var(--fg); font-weight: 500;
      box-shadow: inset 0 -2px 0 var(--acc); }

    /* ---- registry list ------------------------------------------------ */
    /* A list of comparable things is one surface with rules between rows, not
       a stack of cards. The rules live on the rows so filtering a row out
       never leaves a stray divider or doubles one up. */
    .reg { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
    .reg > li { border-top: 1px solid var(--line); }
    .rrow { position: relative; display: grid; align-items: center; gap: 6px 28px;
      grid-template-columns: minmax(0, 1fr) 132px 208px 148px 32px;
      padding: 16px; box-shadow: inset 2px 0 0 transparent;
      transition: background 140ms ease-out; }
    .rrow:hover { background: var(--sunk); }
    /* the current row is marked by the rule at its edge, not by a coloured block */
    /* The loaded row uses the same neutral selected fill an active chat gets.
       A violet rail and a violet tint made "loaded" look like the accent's job
       rather than a state, and repeated the word beside it in colour. */
    .reg > li.is-current .rrow { background: var(--sidebar-selected); box-shadow: none; }
    .reg > li.is-current .rrow:hover { background: var(--sidebar-selected); }
    .rname { font-size: 16px; line-height: 24px; font-weight: 600; color: var(--fg); }
    .rname:hover { text-decoration: none; }
    /* the whole row is the target; the title is the only link in it */
    .rname::after { content: ""; position: absolute; inset: 0; }
    .ruse { font-size: 14px; line-height: 20px; color: var(--mut); margin: 2px 0 0; }
    .rmeta { font-size: 13px; line-height: 18px; color: var(--mut);
      font-variant-numeric: tabular-nums; margin: 0; }
    .rfit { display: inline-flex; align-items: center; gap: 7px; font-size: 14px; line-height: 20px; }
    /* Explicit tracks. A value must never break across lines: "4.68" above
       "GB" was the clearest sign these columns were being squeezed. */
    .rnum { display: flex; flex-direction: column; gap: 2px; font-variant-numeric: tabular-nums;
      min-width: 0; }
    .rnum b { font-size: 14px; line-height: 20px; font-weight: 500; color: var(--fg);
      white-space: nowrap; }
    .rnum span { font-size: 13px; line-height: 18px; color: var(--mut); }
    .rnums { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
    .rchev { color: var(--faint); justify-self: end; }
    /* a row that carries its own action button is targeted by that button */
    /* the action column is a fixed track, not auto: "Use", "Install" and
       "In use" are different widths, and an auto track let every row put its
       fit state and numbers in a slightly different place */
    .rrow.has-action { grid-template-columns: minmax(200px, 1fr) 132px minmax(0, 300px) 96px;
      gap: 6px 20px; }
    .rrow.has-action > .btn { justify-self: end; }
    .rrow.has-action .rname::after { content: none; }
    /* Between 980 and 1120 the publisher column is gone but the row is still a
       row: the name keeps column one and picks the metadata up underneath it. */
    @media (min-width: 981px) and (max-width: 1120px) {
      .rrow { grid-template-columns: minmax(0, 1fr) 132px 208px 32px; }
      .rrow > div:first-child { grid-column: 1; grid-row: 1; }
      .rrow .rmeta { grid-column: 1; grid-row: 2; margin-top: 4px; }
      .rrow .rfit { grid-column: 2; grid-row: 1; }
      .rrow .rnums { grid-column: 3; grid-row: 1; }
      .rrow .rchev { grid-column: 4; grid-row: 1; }
    }
    /* Below 980 the row stacks, but stays a row of one list rather than
       becoming a card: name, then status, then the numbers underneath. */
    @media (max-width: 980px) {
      .rrow { grid-template-columns: minmax(0, 1fr) auto; gap: 10px 20px; padding: 16px; }
      .rrow > div:first-child { grid-column: 1; grid-row: 1; }
      .rrow .rfit { grid-column: 2; grid-row: 1; justify-self: end; align-self: start; }
      .rrow .rmeta { grid-column: 1 / -1; grid-row: 2; }
      .rrow .rnums { grid-column: 1 / -1; grid-row: 3; }
      .rrow .btn { grid-column: 1 / -1; grid-row: 4; justify-self: start; }
      .rchev { display: none; }
    }
    @media (max-width: 560px) {
      .rnums { gap: 16px; flex-wrap: wrap; }
    }

    /* a pill is a status badge */
    .pill { display: inline-flex; align-items: center; gap: 6px; min-height: 26px; padding: 2px 10px;
      border-radius: 13px; border: 1px solid var(--line); background: transparent;
      font-size: 13px; line-height: 18px; color: var(--mut); white-space: nowrap; }
    /* a pill that is a control gets a control's hit area */
    button.pill, a.pill { height: 40px; border-radius: 20px; padding: 0 15px; font-size: var(--t-label); line-height: var(--lh-label);
      color: var(--fg); cursor: pointer; }
    .pill.ok { border-color: var(--ok-line); color: var(--ok); }
    .pill.warn { border-color: var(--warn-line); color: var(--warn); }
    .pill.bad { border-color: var(--bad-line); color: var(--bad); }
    .pill.acc { border-color: var(--acc); color: var(--acc-text); }

    .dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; background: var(--faint); }
    .dot.ok { background: var(--ok-line); }
    .dot.warn { background: var(--warn-line); }
    .dot.bad { background: var(--bad-line); }
    .dot.acc { background: var(--acc); }

    .track { height: 5px; border-radius: 3px; background: var(--line); overflow: hidden; }
    .fillbar { height: 100%; background: var(--acc); border-radius: 3px; }

    .field { height: 40px; border: 1px solid var(--line); background: var(--sunk);
      border-radius: 8px; display: flex; align-items: center; gap: 10px; padding: 0 12px;
      font-size: 14px; color: var(--mut); }
    .field:focus-within { border-color: var(--acc); }
    .field input { border: 0; background: transparent; outline: none; flex: 1; min-width: 0;
      color: var(--fg); font-size: 14px; align-self: stretch; height: auto; }

    /* ---- composer ---------------------------------------------------- */
    /* One short light travels the perimeter. About three quarters of the ring
       is transparent at any moment, so it reads as a passing light rather than
       a rotating ring. Only opacity responds to hover and focus, so the light
       never restarts or jumps position when focus moves. */
    @property --flow-angle {
      syntax: "<angle>";
      inherits: false;
      initial-value: 0deg;
    }
    /* ---- composer: one shell, one geometry ------------------------------- */
    /* The composer is the same object in every state.
       It used to be two compositions: the session one collapsed the shell to a
       56px single row the moment a message existed, turned .cbar into an
       inline group, and hid the reasoning selector outright. That made the
       controls move and change size exactly when the user started depending on
       them. The geometry below is therefore unconditional. `data-composition`
       still arranges the page around the composer (centred cluster with
       recents, or transcript above it), but nothing resizes the composer. */
    .composer { display: flex; flex-direction: column; gap: 8px;
      border: 0; background: none; padding: 0; }
    .cshell { position: relative; isolation: isolate;
      border: 1px solid var(--line-strong); background: var(--raised);
      border-radius: 14px;
      display: flex; flex-direction: column;
      min-height: 108px; padding: 14px 14px 8px;
      transition: border-color 160ms ease-out; }
    .cinput { display: flex; align-items: flex-start; flex: 1; gap: 8px; }
    .cinput > .ta { flex: 1; min-width: 0; }
    /* Top-aligned with the field rather than pulled up onto the first line's
       optical centre, which read as sitting above the text. It stays anchored
       to the top so a growing draft never drags it down the composer. */
    .cinput > .sendbtn { align-self: flex-start; }

    /* The strip is moved in the DOM, not reordered here, so the tab order
       matches what is on screen. These rules only size it. */
    [data-composition="start"] .composer .cstrip { justify-content: center; }
    /* recents belong to the start cluster only */
    [data-composition="session"] .composer .recents { display: none; }
    [data-composition="session"] .dock { padding-bottom: 20px; }

    .cshell::before, .cshell::after {
      content: ""; position: absolute; border-radius: inherit; pointer-events: none;
      background: conic-gradient(from var(--flow-angle),
        transparent 0deg 265deg,
        color-mix(in srgb, var(--flow-far) 8%, transparent) 278deg,
        var(--flow-head) 302deg,
        color-mix(in srgb, var(--flow-tail) 72%, transparent) 322deg,
        transparent 342deg 360deg);
      /* the ring is the difference between the padded box and its content box */
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
      mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      mask-composite: exclude;
      animation: none;
      transition: opacity 200ms ease-out;
    }
    /* A 1px edge highlight, not a halo. It rides the border itself, casts
       nothing onto the canvas, and appears only when the input is focused or a
       run is generating: an animated edge on an untouched composer is
       decoration, not state. */
    .cshell::before { inset: -1px; padding: 1px; opacity: 0; z-index: 2; }
    /* one faint pass of depth on the edge only, never a glow on the page */
    .cshell::after { inset: -1px; padding: 1px; opacity: 0; filter: blur(3px); z-index: 1; }

    .cshell:focus-within { border-color: color-mix(in srgb, var(--line-strong) 55%, var(--flow-head)); }
    .cshell:focus-within::before { opacity: .5; animation: flow-edge 6s linear infinite; }
    .cshell:focus-within::after { opacity: .18; animation: flow-edge 6s linear infinite; }
    /* Running moves a little faster, because it is reporting activity. */
    .composer[data-running] .cshell::before { opacity: .55; animation: flow-edge 3.2s linear infinite; }
    .composer[data-running] .cshell::after { opacity: .2; animation: flow-edge 3.2s linear infinite; }
    /* A pending decision is amber at the decision surface, and an error is a
       border, not a light show: both stop the motion. */
    .composer[data-awaiting] .cshell::before,
    .composer[data-awaiting] .cshell::after,
    .composer[data-error] .cshell::before,
    .composer[data-error] .cshell::after { animation: none; opacity: 0; }
    .composer[data-error] .cshell { border-color: var(--bad-line); }
    /* Nothing animates in a window the user is not looking at. */
    body.is-blurred .cshell::before,
    body.is-blurred .cshell::after { animation-play-state: paused; }

    @keyframes flow-edge { to { --flow-angle: 360deg; } }

    /* Static equivalent: a plain focus ring, with the light parked. */
    @media (prefers-reduced-motion: reduce) {
      .cshell::before, .cshell::after { animation: none; opacity: 0; }
      .cshell:focus-within { box-shadow: 0 0 0 3px color-mix(in srgb, var(--flow-head) 16%, transparent); }
    }
    /* Without mask compositing there is no ring to draw, so fall back to the
       neutral border and a plain focus ring. */
    @supports not ((-webkit-mask-composite: xor) or (mask-composite: exclude)) {
      .cshell::before, .cshell::after { display: none; }
      .cshell:focus-within { border-color: var(--flow-head);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--flow-head) 16%, transparent); }
    }
    /* The control row must wrap rather than push Send past the viewport on a
       narrow window, and the model name truncates before it does. */
    .cbar { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; row-gap: 6px;
      min-height: 36px; }
    .cbar .btn, .cbar .ico { min-height: 36px; height: 36px; }
    .cbar-ctx { font-size: var(--t-label); line-height: var(--lh-label); color: var(--faint); padding: 0 8px; }
    .cbar > .btn { min-width: 0; }
    .cbar [data-model-label] { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    /* Narrow is handled by wrapping the row, not by shrinking the controls.
       `nowrap` here belonged to the old compact composer, which had two
       controls; with six it pushed Send outside the shell and overlapped the
       labels. Every control keeps its size and its place in the order, and the
       row becomes two lines when it has to. */
    @media (max-width: 560px) {
      .cbar { flex-wrap: wrap; row-gap: 8px; }
      .cbar-l, .cbar-r { flex-wrap: wrap; row-gap: 8px; }
      .cbar [data-model-label] { max-width: 12ch; }
    }
    @media (max-width: 460px) {
      /* The spacer stops earning its place once the row wraps. */
      .cbar > .grow { display: none; }
      .cbar [data-model-label] { max-width: 10ch; }
    }

    /* ---- activity group ---------------------------------------------- */
    .act { border: 1px solid var(--line); border-radius: 8px; background: var(--raised);
      overflow: hidden; }
    .act > .hd { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 4px 16px; }
    .arow { display: flex; align-items: center; gap: 12px; min-height: 36px; padding: 6px 16px;
      font-size: 14px; color: var(--mut); }
    .arow .t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .arow.now { color: var(--fg); }
    /* A finished run is a status line, not a second surface competing with the
       result it introduces. */
    .act.is-flat { border: 0; background: transparent; border-radius: 0; }
    .act.is-flat > .hd { padding: 0; min-height: 32px; }
    .act.is-flat .arow { padding-left: 0; padding-right: 0; }

    /* ---- misc -------------------------------------------------------- */
    /* floor for controls that are not one of the named primitives */
    .hit { display: inline-flex; align-items: center; min-height: 40px; }

    .sep { height: 1px; background: var(--line-soft); }
    .grow { flex-grow: 1; }
    .ph { background: var(--line); border-radius: 2px; }
    .xbox { border: 1px solid var(--line); border-radius: 6px; background-color: var(--sunk);
      background-image:
        linear-gradient(to top right, transparent calc(50% - .5px), var(--line) 50%, transparent calc(50% + .5px)),
        linear-gradient(to bottom right, transparent calc(50% - .5px), var(--line) 50%, transparent calc(50% + .5px)); }
    .note { border: 1px dashed var(--line-strong); background: transparent; border-radius: 8px; }
    .chrome { height: 34px; flex-shrink: 0; display: flex; align-items: center; gap: 10px;
      padding: 0 12px; border-bottom: 1px solid var(--line); background: var(--panel); }

    /* ---- pulse (single, on the current activity only) ---------------- */
    @keyframes fl-pulse { 0%,100% { opacity: 1 } 50% { opacity: .45 } }
    .pulse { animation: fl-pulse 2s ease-in-out infinite; }

    /* ---- tables ------------------------------------------------------- */
    /* Row groups, not a grid. A rule under every cell drew four lines per row
       and turned a six-row table into two dozen borders. */
    .tbl { width:100%; border-collapse:collapse; font-size:14px; }
    .tbl th, .tbl td { text-align:left; padding:14px 16px; }
    .tbl tbody tr { border-bottom:1px solid var(--line-soft); }
    .tbl thead tr { border-bottom:1px solid var(--line); }
    .tbl thead th { font-size:13px; color:var(--mut); font-weight:500; padding-bottom:10px; }
    /* A caution is a note with a rule, never a filled box inside a border. */
    .note-rule { display:flex; align-items:flex-start; gap:12px; margin:0;
      padding:2px 0 2px 14px; border-left:2px solid var(--warn-line); }
    .note-rule .h3 { display:block; font-size: 15px; line-height: 22px; }
    .note-rule p { margin:4px 0 0; font-size: 14px; line-height: 20px; color:var(--mut);
      text-wrap:pretty; }
    .tbl tbody tr:last-child { border-bottom:0; }
    .tbl td.num, .tbl th.num { font-variant-numeric:tabular-nums; }

    /* comparison table stacks into labelled rows on narrow screens */
    @media (max-width: 760px) {
      .cmp thead { display: none; }
      .cmp, .cmp tbody, .cmp tr, .cmp th, .cmp td { display: block; }
      .cmp tr { border-bottom: 1px solid var(--line-soft); padding: 12px 14px; }
      .cmp tbody tr:last-child { border-bottom: 0; }
      .cmp th[scope="row"] { padding: 0 0 8px; border: 0; font-weight: 600; }
      .cmp td { border: 0; padding: 3px 0; display: flex; justify-content: space-between; gap: 16px; }
      .cmp td::before { content: attr(data-l); color: var(--mut); font-size: 13px; }
    }

    /* ---- marketing shell --------------------------------------------- */
    .mwrap { width:100%; max-width:1240px; margin:0 auto; padding:0 32px; }
    .brand { display:inline-flex; align-items:center; gap:9px; color:var(--fg);
      font-weight:600; font-size:15px; letter-spacing:-.01em; }
    .brand:hover { text-decoration:none; }
    .brand.small { font-size:13px; gap:7px; }
    /* Was an inline style on the footer's platform note. It is a class now so
       the landing page can raise it without !important; every other marketing
       page keeps the 13px it had. */
    .mfoot-note { font-size:13px; line-height:19px; }
    .mhead { border-bottom:1px solid var(--line); position:sticky; top:0; z-index:50;
      background:var(--bg); }
    .mhead-in { height:72px; display:flex; align-items:center; gap:22px; }
    .mhead [data-nav] { display:flex; align-items:center; gap:22px; flex:1; }
    .mhead [data-nav] a { color:var(--mut); font-size:14px; font-weight:500; }
    .mhead [data-nav] a:hover { color:var(--fg); text-decoration:none; }
    .mhead [data-nav] a[aria-current="page"] { color:var(--fg); font-weight:500; }
    .mhead [data-nav] a.btn { color:var(--fg); }
    .mhead-sp { flex:1; }
    .mhead [data-nav-toggle] { display:none; }

    .mfoot { border-top:1px solid var(--line); margin-top:64px; }
    .mfoot-top { padding:40px 32px 32px; display:flex; gap:40px; flex-wrap:wrap; align-items:flex-start; }
    .mfoot-cta { flex:1; min-width:280px; display:flex; flex-direction:column; gap:14px; }
    .mfoot-cta h2 { margin:0; font-size:22px; line-height:30px; font-weight:600; }
    .mfoot-cta .row { display:flex; align-items:center; gap:14px; flex-wrap:wrap; }
    .mfoot-nav { display:flex; gap:44px; flex-wrap:wrap; }
    .mfoot-nav > div { display:flex; flex-direction:column; gap:2px; }
    .mfoot-nav a { color:var(--mut); font-size:14px; }
    .mfoot-legal { padding:0 32px 28px; display:flex; align-items:center; gap:16px;
      flex-wrap:wrap; font-size:13px; }

    /* two editorial columns with a rule between them on desktop only */
    .seclower { padding: 44px clamp(20px, 5vw, 56px); border-top: 1px solid var(--line);
      background: var(--panel); display: grid; grid-template-columns: 1fr 1fr; gap: 0 44px; }
    .seclower > div + div { border-left: 1px solid var(--line); padding-left: 44px; }
    @media (max-width: 900px) {
      .seclower { grid-template-columns: 1fr; gap: 36px; }
      .seclower > div + div { border-left: 0; padding-left: 0; }
    }

    /* ---- process band -------------------------------------------------- */
    /* Four stages of one process on a shared surface, divided by a rule and a
       chevron rather than four mini-cards floating inside a larger card. */
    /* A numbered sequence, not four boxes. The order carries the flow, so no
       card, fill or perimeter is needed to hold each step together. */
    .band-p { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0 28px;
      counter-reset: stage; border: 0; background: none; }
    .band-p > .stage { position: relative; padding: 0 0 0 0; display: flex;
      flex-direction: column; gap: 5px; counter-increment: stage; }
    .band-p > .stage .lab::before { content: counter(stage) ". "; color: var(--faint); }
    /* the chevron sits in the gap, so the steps read as one flow */
    .band-p > .stage + .stage::before { content: ""; position: absolute; left: -18px; top: 9px;
      width: 8px; height: 8px; border-top: 1.6px solid var(--line-strong);
      border-right: 1.6px solid var(--line-strong); transform: rotate(45deg); }
    .band-p > .stage.is-key .h3 { color: var(--fg); }
    .band-p .h3 { font-size: 15px; line-height: 22px; }
    .band-p .why { font-size: 13px; line-height: 18px; color: var(--mut); }
    @media (max-width: 900px) {
      .band-p { grid-template-columns: 1fr; gap: 18px; }
      .band-p > .stage + .stage::before { left: 0; top: -13px; transform: rotate(135deg); }
      .band-p > .stage + .stage::before { left: 50%; top: -5px; margin: 0 0 0 -5px;
        transform: rotate(135deg); }
      .band-p > .stage.is-key { box-shadow: inset 2px 0 0 var(--acc); }
    }

    /* ---- editorial index ---------------------------------------------- */
    /* Sparse informational pages share this: a readable measure, rules top and
       bottom, rows divided by 1px. No outer radius, no shadow, no card per row.
       The rules sit on the rows so a hidden row never doubles a divider up. */
    .measure { max-width: 900px; }
    .measure-doc { max-width: 740px; }
    .index { border-bottom: 1px solid var(--line); }
    .index > * { border-top: 1px solid var(--line); }
    .irow { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto;
      gap: 0 24px; align-items: baseline; padding: 20px 2px; min-height: 44px; }
    .irow .n { grid-column: 1; grid-row: 1; font-size: 13px; line-height: 18px;
      color: var(--mut); font-variant-numeric: tabular-nums; }
    .irow .t { grid-column: 2; grid-row: 1; font-size: 16px; line-height: 24px;
      font-weight: 600; letter-spacing: -.01em; }
    .irow .d { grid-column: 2; grid-row: 2; margin: 5px 0 0; font-size: 15px;
      line-height: 22px; color: var(--mut); max-width: 68ch; }
    .irow .s { grid-column: 3; grid-row: 1; justify-self: end; font-size: 14px;
      line-height: 20px; color: var(--faint); white-space: nowrap; }
    /* an interactive row gets the hover and focus treatment; a status-only row
       must not, because nothing happens when you click it */
    a.irow, button.irow { width: 100%; text-align: left; cursor: pointer;
      transition: background 140ms ease-out; }
    a.irow:hover, button.irow:hover { background: var(--sunk); text-decoration: none; }
    /* status table: service, what it affects, state */
    .strow { display: grid; grid-template-columns: 210px minmax(0, 1fr) 150px;
      gap: 4px 24px; align-items: baseline; padding: 18px 2px; min-height: 44px; }
    .strow .t { font-size: 15px; line-height: 22px; font-weight: 600; }
    .strow .d { margin: 0; font-size: 14px; line-height: 20px; color: var(--mut); }
    .strow .s { justify-self: end; display: inline-flex; align-items: center; gap: 8px;
      font-size: 14px; line-height: 20px; color: var(--mut); white-space: nowrap; }
    /* changelog: a release timeline that happens to be empty */
    .tlrow { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 6px 24px;
      padding: 22px 2px; }
    .tlrow .when { font-size: 14px; line-height: 20px; color: var(--faint);
      font-variant-numeric: tabular-nums; }
    .tlrow .t { font-size: 16px; line-height: 24px; font-weight: 600; letter-spacing: -.01em; }
    .tlrow .d { margin: 6px 0 0; font-size: 15px; line-height: 22px; color: var(--mut);
      max-width: 68ch; }
    @media (max-width: 720px) {
      .irow { grid-template-columns: minmax(0, 1fr) auto; gap: 0 16px; }
      .irow .n { display: none; }
      .irow .t { grid-column: 1; }
      .irow .d { grid-column: 1 / -1; }
      .strow, .tlrow { grid-template-columns: minmax(0, 1fr); }
      .strow .s { justify-self: start; margin-top: 6px; }
      /* a column header means nothing once the columns have stacked */
      .strow-head { display: none; }
      .tlrow .when { order: -1; }
    }

    /* a plain-language document: sections separated by space and a rule */
    .doc > section { padding: 26px 0; border-top: 1px solid var(--line-soft); }
    .doc > section:first-child { padding-top: 0; border-top: 0; }
    .doc h2 { margin: 0 0 8px; font-size: 17px; line-height: 25px; font-weight: 600;
      letter-spacing: -.01em; }
    .doc p { margin: 0; font-size: 16px; line-height: 24px; color: var(--mut); }

    /* ---- technical document ------------------------------------------- */
    /* Sections divided by a rule rather than each one sitting in its own
       rounded box. Used by the model detail pages. */
    fieldset.bare { border: 0; margin: 0; padding: 0; min-width: 0; }

    /* the field-by-field rows on /privacy/: two columns of plain lists, no card */
    .cfrow { padding: 18px 0; border-top: 1px solid var(--line-soft); }
    .cfrow-h { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
    .cfrow-h .t { font-size: 16px; line-height: 24px; font-weight: 600; color: var(--fg); }
    .cfrow-b { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 32px; margin-top: 12px; }
    .cfrow-b ul { margin: 6px 0 0; padding-left: 18px; }
    .cfrow-b li { font-size: 15px; line-height: 22px; color: var(--mut); margin-bottom: 5px; }
    .cfrow-b li::marker { color: var(--faint); }
    .ok-t { color: var(--ok); }
    @media (max-width: 700px) { .cfrow-b { grid-template-columns: minmax(0, 1fr); gap: 14px; } }

    /* a listed file, not an action: no hover lift, no pointer, no focus ring */
    .srow.is-static { cursor: default; background: none; }
    .srow.is-static:hover { background: none; }

    .dlchip { display: inline-flex; align-items: center; gap: 8px; height: 40px;
      padding: 0 12px; border-radius: 8px; font-size: var(--t-label); line-height: var(--lh-label); color: var(--mut);
      text-decoration: none; }
    .dlchip:hover { background: var(--sunk); color: var(--fg); }
    .dlchip b { font-weight: 600; color: var(--fg); }
    /* narrow onboarding headers have no room for the word, only the number */
    @media (max-width: 640px) { .dlchip-t { display: none; } .dlchip { padding: 0 8px; } }

    .setupdone { display: flex; align-items: center; gap: 9px; margin: 0 0 10px;
      padding: 6px 4px; font-size: 14px; line-height: 20px; color: var(--mut); }
    .setupdone-i { display: inline-flex; flex-shrink: 0; }
    .setupdone > span:nth-child(2) { flex: 1; min-width: 0; }

    .dl-info > summary { cursor: pointer; font-size: 14px; color: var(--mut);
      min-height: 36px; display: flex; align-items: center; }
    .dl-info > summary:hover { color: var(--fg); }
    .dl-info > p { margin: 2px 0 0; font-size: 14px; line-height: 20px;
      color: var(--mut); max-width: 70ch; }

    .ob-what > summary { cursor: pointer; font-size: 14px; color: var(--mut);
      min-height: 36px; display: flex; align-items: center; }
    .ob-what > summary:hover { color: var(--fg); }
    .ob-what > p { margin: 2px 0 0; font-size: 14px; line-height: 20px;
      color: var(--mut); max-width: 62ch; }

    .doclist-nav { display: flex; flex-direction: column; }
    .docitem { display: flex; align-items: center; gap: 14px; min-height: 42px;
      padding: 4px 8px; margin: 0 -8px; border-radius: 7px; text-decoration: none;
      border-top: 1px solid var(--line-soft); }
    .doclist-nav .docitem:first-child { border-top: 0; }
    .docitem:hover { background: var(--sunk); }
    .docitem .t { flex: 1; min-width: 0; font-size: 15px; line-height: 22px; color: var(--fg); }
    .docitem .s { font-size: var(--t-label); line-height: var(--lh-label); color: var(--faint); flex-shrink: 0; }
    h2.docgroup-h { margin: 0 0 2px; font-size: 13px; line-height: 18px;
      font-weight: 600; letter-spacing: .04em; text-transform: uppercase;
      color: var(--mut); }

    /* one-line contextual chips, not a second pair of decision cards */
    .chips { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; }
    .chip { min-height: 40px; padding: 0 14px; border: 1px solid var(--line);
      border-radius: 8px; background: transparent; font-size: 14px;
      line-height: 20px; color: var(--mut);
      transition: background 140ms ease-out, border-color 140ms ease-out, color 140ms ease-out; }
    .chip:hover { background: var(--sunk); border-color: var(--line-strong); color: var(--fg); }

    h1.ws-h1 { margin: 0; font-size: var(--t-body); line-height: var(--lh-body); font-weight: 600;
      color: var(--fg); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* ---- Surface B: the loader dialog ------------------------------------ */
    .loader-host[hidden] { display: none; }
    .loader-scrim { position: fixed; inset: 0; z-index: 190;
      background: color-mix(in srgb, #05060a 62%, transparent); }
    .loader { position: fixed; z-index: 200; top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: min(840px, calc(100vw - 48px)); max-height: min(600px, calc(100dvh - 48px));
      display: flex; flex-direction: column;
      border: 1px solid var(--line-strong); border-radius: 10px;
      background: var(--panel); box-shadow: var(--shadow-menu); overflow: hidden; }
    .loader-h { display: flex; align-items: center; gap: 10px; flex-shrink: 0;
      padding: 12px 14px; border-bottom: 1px solid var(--line-soft); }
    /* One explicit row, so the body is bounded by the dialog rather than by its
       own content. Without it the implicit auto row grew past the footer and
       the last parameter control was clipped by the dialog's overflow. */
    .loader-b { flex: 1; min-height: 0; display: grid;
      grid-template-columns: minmax(0, 38%) minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr); }
    .loader-list { display: flex; flex-direction: column; min-height: 0;
      border-right: 1px solid var(--line-soft); }
    .loader-search { margin: 12px 14px 8px; flex-shrink: 0; }
    .loader-sort { display: flex; gap: 4px; padding: 0 14px 8px; flex-shrink: 0; }
    .lsort { min-height: 36px; padding: 0 10px; border: 1px solid transparent;
      border-radius: 7px; background: none; font-size: var(--t-label); line-height: var(--lh-label); color: var(--mut); }
    .lsort:hover { background: var(--sunk); color: var(--fg); }
    .lsort[aria-pressed="true"] { background: var(--sunk); color: var(--fg);
      border-color: var(--line); font-weight: 500; }
    .loader-rows { flex: 1; min-height: 0; overflow-y: auto; padding: 0 8px 10px; }
    /* The dialog list is narrower than Explore, so its right column gives the
       name back the space rather than truncating it to three characters. */
    .loader-rows .mrow2 { grid-template-columns: 32px minmax(0, 1fr) auto; padding: 10px; }
    .loader-rows .mrow2-mark { width: 30px; height: 30px; }
    .loader-rows .mrow2-right { min-width: 0; }

    .loader-cfg { min-height: 0; overflow-y: auto; padding: 14px 16px 18px; }
    .loader-n { margin: 0; font-size: 16px; line-height: 24px; font-weight: 600; }
    .loader-sub { margin: 3px 0 14px; font-size: var(--t-label); line-height: var(--lh-label); color: var(--faint); }
    .loader-params > summary, .loader-adv > summary { cursor: pointer;
      min-height: 36px; display: flex; align-items: center;
      font-size: 14px; color: var(--mut); }
    .loader-params > summary:hover, .loader-adv > summary:hover { color: var(--fg); }
    .loader-adv { margin-top: 12px; }

    .lfield { display: flex; flex-direction: column; gap: 4px; margin-top: 12px; }
    .lfield label { font-size: 13px; color: var(--mut); }
    .lfield input, .lfield select { min-height: 36px; padding: 0 10px;
      border: 1px solid var(--line-strong); border-radius: 7px;
      background: var(--sunk); color: var(--fg); font: inherit; font-size: 14px; }
    .lfield input:focus-visible, .lfield select:focus-visible {
      outline: 2px solid var(--focus); outline-offset: 1px; }
    .lfield input[aria-invalid="true"] { border-color: var(--bad-line); }
    .lfield-h { font-size: 13px; line-height: 18px; color: var(--mut); }
    .lfield-e { color: var(--bad); }
    .lfield-row { flex-direction: row; align-items: center;
      justify-content: space-between; gap: 12px; }
    .lfield-row select { max-width: 210px; }

    .loader-facts { margin: 14px 0 0; display: grid; grid-template-columns: 118px minmax(0,1fr);
      gap: 7px 14px; }
    .loader-facts dt { font-size: var(--t-label); line-height: var(--lh-label); color: var(--faint); }
    .loader-facts dd { margin: 0; font-size: 14px; line-height: 20px; color: var(--fg); }
    .loader-est { display: flex; flex-direction: column; gap: 4px; margin-top: 14px;
      padding-top: 12px; border-top: 1px solid var(--line-soft);
      font-size: 13px; color: var(--mut); }
    .loader-est b { color: var(--fg); font-weight: 600; }
    /* A configuration that exceeds the machine is a note, not an alarm. */
    .loader-note { margin: 8px 0 0; font-size: var(--t-label); line-height: var(--lh-label); color: var(--warn); }

    .loader-f { display: flex; align-items: center; gap: 10px; flex-shrink: 0;
      flex-wrap: wrap; padding: 12px 14px; border-top: 1px solid var(--line-soft); }
    .loader-why { margin: 0; font-size: var(--t-label); line-height: var(--lh-label); color: var(--faint);
      max-width: 40ch; }

    @media (max-width: 860px) {
      .loader { inset: 12px; width: auto; max-height: none;
        transform: none; top: 12px; left: 12px; }
      /* minmax(0, 1fr), not 1fr: a plain fr row keeps a min-content floor, so
         the configuration pane grew instead of scrolling and its last inputs
         sat outside the dialog. */
      .loader-b { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr); }
      .loader-list { border-right: 0; border-bottom: 1px solid var(--line-soft); max-height: 44vh; }
    }
    @media (max-width: 720px) {
      .loader { inset: 0; border-radius: 0; border: 0; }
      .lsort, .lfield input, .lfield select { min-height: 44px; }
      .loader-f .btn { min-height: 44px; }
    }

    /* ---- model card ------------------------------------------------------ */
    .mc { display: flex; flex-direction: column; gap: 10px; }
    .mc-h { margin: 8px 0 0; font-size: 14px; line-height: 20px; font-weight: 600; color: var(--fg); }
    .mc-p { margin: 0; font-size: 14px; line-height: 20px; color: var(--mut); }
    .mc-list { margin: 0; padding-left: 20px; }
    .mc-list li { font-size: 14px; line-height: 20px; color: var(--mut); }
    .mc-code { margin: 0; padding: 10px 12px; border-radius: 8px; background: var(--sunk);
      border: 1px solid var(--line-soft); font-size: 13px; line-height: 18px;
      color: var(--mut); overflow-x: auto; }
    .mc-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .mc-table th, .mc-table td { text-align: left; padding: 6px 8px;
      border-bottom: 1px solid var(--line-soft); }
    .mc-table th { color: var(--faint); font-weight: 600; }
    .mc-table td { color: var(--mut); }
    .mc a { color: var(--acc-text); }
    .mc-state { gap: 10px; align-items: flex-start; }
    .mc-state p { margin: 0; font-size: 14px; line-height: 20px; color: var(--faint); }
    /* fixed geometry, so nothing jumps when the content arrives */
    .mc-skeleton { gap: 8px; }
    .mc-bar { height: 12px; border-radius: 4px; background: var(--sunk); display: block; }

    /* ---- model catalog, split view --------------------------------------- */
    .modelwrap { width: 100%; max-width: 1180px; margin: 0 auto;
      padding: 20px 24px 28px; display: flex; flex-direction: column; gap: 16px; }
    .modelnav { display: flex; gap: 2px; border-bottom: 1px solid var(--line-soft); }
    .modelnav > * { display: inline-flex; align-items: center; min-height: 40px;
      padding: 0 12px; font-size: 14px; color: var(--mut); text-decoration: none; }
    .modelnav > a:hover { color: var(--fg); }
    .modelnav > [aria-current] { font-weight: 600; color: var(--fg);
      border-bottom: 2px solid var(--acc); margin-bottom: -1px; }

    .cat { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
      gap: 24px; align-items: start; }
    .cat-list { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
    .cat-search { position: sticky; top: 0; z-index: 2; background: var(--bg); }
    .cat-rows { display: flex; flex-direction: column; }

    /* One row, seven facts, no pills for ordinary metadata. */
    .cat-row { display: grid; grid-template-columns: minmax(0,1fr) auto auto;
      gap: 2px 12px; padding: 10px 10px; margin: 0 -10px; border-radius: 8px;
      border-top: 1px solid var(--line-soft); text-decoration: none;
      align-items: center; }
    .cat-rows > *:first-child .cat-row { border-top: 0; }
    .cat-row:hover { background: var(--sunk); }
    .cat-row:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
    /* selection is a rule and a weight, not colour alone */
    .cat-row.is-on { background: var(--sunk); box-shadow: inset 2px 0 0 var(--acc); }
    .cat-row.is-on .cat-name { color: var(--fg); }
    .cat-name { grid-column: 1; grid-row: 1; font-size: 15px; line-height: 22px;
      font-weight: 500; color: var(--fg); overflow: hidden;
      text-overflow: ellipsis; white-space: nowrap; }
    .cat-state { grid-column: 2; grid-row: 1; font-size: 13px; color: var(--ok); }
    .cat-size { grid-column: 3; grid-row: 1; font-size: 13px; color: var(--mut);
      justify-self: end; }
    .cat-pub { grid-column: 1; grid-row: 2; font-size: 13px; color: var(--mut); }
    .cat-use { grid-column: 1; grid-row: 3; font-size: 14px; line-height: 20px;
      color: var(--mut); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cat-caps { grid-column: 2 / -1; grid-row: 2 / 4; display: flex; gap: 8px;
      align-items: center; justify-self: end; color: var(--faint); }
    .cat-fit { grid-column: 2 / -1; grid-row: 1; display: none; }
    .cat-row .cat-fit { display: inline-flex; align-items: center; gap: 7px;
      grid-column: 3; grid-row: 3; font-size: 13px; color: var(--mut);
      justify-self: end; white-space: nowrap; }

    /* A flush pane separated by one vertical rule. A bordered, filled card
       floating beside the results read as a widget rather than as the other
       half of the same view. */
    .cat-detail { position: sticky; top: 0; display: flex; flex-direction: column;
      padding: 4px 0 20px 28px; border: 0; border-left: 1px solid var(--line-soft);
      border-radius: 0; background: none; max-height: calc(100vh - 140px); overflow-y: auto; }
    .cat-back { display: none; align-items: center; gap: 6px; min-height: 40px;
      font-size: 14px; color: var(--mut); text-decoration: none; }
    .cat-h { margin: 0; font-size: 19px; line-height: 27px; font-weight: 600; }
    .cat-sub { margin: 3px 0 0; font-size: 13px; line-height: 18px; color: var(--mut); }
    .cat-desc { margin: 12px 0 0; font-size: 14px; line-height: 20px; color: var(--mut); }
    .cat-h3 { margin: 20px 0 8px; font-size: 13px; line-height: 18px; font-weight: 600;
      color: var(--mut); }
    .cat-caplist { list-style: none; margin: 0; padding: 0; display: flex;
      flex-direction: column; gap: 7px; }
    .cat-caplist li { display: flex; align-items: center; gap: 9px;
      font-size: 14px; color: var(--mut); }
    .cat-kv { margin: 0; display: grid; grid-template-columns: 118px minmax(0,1fr);
      gap: 7px 12px; }
    .cat-kv dt { font-size: 13px; color: var(--mut); }
    .cat-kv dd { margin: 0; font-size: 14px; line-height: 20px; }
    .cat-note { margin: 10px 0 0; font-size: 13px; line-height: 18px; color: var(--mut); }
    .cat-actions { margin-top: 20px; display: flex; gap: 8px; }
    /* No box is drawn to reserve space: the instruction is the only thing here. */
    .cat-empty { justify-content: flex-start; min-height: 0; padding-top: 10px; }
    .cat-empty p { margin: 0; max-width: 34ch; text-align: left;
      font-size: 14px; line-height: 20px; color: var(--faint); }

    /* Below the split point the results are the page and a selection navigates
       to its own detail view with a Back action. */
    @media (max-width: 980px) {
      .cat { grid-template-columns: minmax(0, 1fr); }
      .cat-detail { position: static; max-height: none; }
      .cat[data-selected] .cat-list { display: none; }
      .cat:not([data-selected]) .cat-detail { display: none; }
      .cat-back { display: inline-flex; }
    }

    /* ---- composer: context strip, input, control line -------------------- */
    /* Three bands with one border around them. The strip states where the work
       happens, the input is the one thing you type in, and the control line
       carries what changes the next message. */
    /* The strip grows with its chips rather than clipping them. */
    .cstrip { display: flex; align-items: center; gap: 2px; padding: 0; flex-wrap: wrap;
      min-height: 36px; }
    /* Facts about the session, so they read a step below the controls that
       change what happens next, but never below the metadata floor. */
    .cchip { display: inline-flex; align-items: center; gap: 6px; min-height: 36px;
      padding: 0 8px; border-radius: 6px; background: none; border: 0;
      font-size: var(--t-label); line-height: var(--lh-label); color: var(--mut); cursor: pointer;
      max-width: 300px; }
    .cchip:hover { background: var(--sunk); color: var(--mut); }
    .cchip:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
    .cchip .m { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cchip svg { flex-shrink: 0; }
    .folder-anchor { position: relative; }
    .folder-anchor .popover { bottom: auto; top: calc(100% + 6px); left: 0; }

    /* ---- project selector ------------------------------------------------ */
    /* A folder icon and the folder's own name. The full path used to sit in a
       chip under the composer; it is one fact and it now lives in one place,
       on the control that changes it. A long name truncates here rather than
       pushing the model selector off the row. */
    .projbtn { max-width: 180px; }
    .projbtn [data-project-name] { overflow: hidden; text-overflow: ellipsis;
      white-space: nowrap; min-width: 0; }
    .projbtn svg { flex-shrink: 0; }
    .projbtn[data-empty="true"] { color: var(--faint); }
    /* The narrow caps were sized for a row that could not wrap. It wraps now,
       so the name gets enough room to stay a name rather than "Choo...". */
    @media (max-width: 900px) { .projbtn { max-width: 150px; } }
    @media (max-width: 560px) { .projbtn { max-width: 140px; } }

    /* ---- attachments ----------------------------------------------------- */
    /* Sits above the input, inside the shell, so an attachment reads as part of
       the message being written. Reserves no height when empty. */
    .catt { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 0 8px; }
    .catt[hidden] { display: none; }
    .cattc { display: inline-flex; align-items: center; gap: 6px; min-height: 32px;
      max-width: 240px; padding: 0 4px 0 10px; border: 1px solid var(--line);
      border-radius: 8px; background: var(--sunk);
      font-size: var(--t-label); line-height: var(--lh-label); color: var(--fg); }
    .cattc .t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cattc .z { color: var(--faint); flex-shrink: 0; }
    .cattc svg { flex-shrink: 0; }
    .cattc .x { display: inline-flex; align-items: center; justify-content: center;
      width: 28px; height: 28px; min-height: 28px; border: 0; border-radius: 6px;
      background: none; color: var(--mut); cursor: pointer; flex-shrink: 0; }
    .cattc .x:hover { background: var(--line-soft); color: var(--fg); }

    .cbar-l, .cbar-r { display: flex; align-items: center; gap: 4px; min-width: 0; }
    .cbar-r [data-model-label] { max-width: 168px; overflow: hidden;
      text-overflow: ellipsis; white-space: nowrap; }

    /* the context ring: a quiet dial, not a progress bar competing with Send */
    .ring { width: 13px; height: 13px; border-radius: 50%; flex-shrink: 0;
      background: conic-gradient(var(--acc) calc(var(--pct) * 1%), var(--line-strong) 0); }
    .cbar-ctx { padding: 0 8px; gap: 6px; font-size: 13px; color: var(--mut); }
    .cbar-ctx .num { font-size: 13px; }

    /* mode and effort rows: a name, a shortcut, and one line of consequence */
    .mrow { height: auto; padding: 8px 9px; align-items: flex-start;
      flex-direction: column; gap: 2px; text-align: left; }
    .mrow-t { display: flex; align-items: center; gap: 8px; width: 100%;
      font-size: 14px; font-weight: 600; color: var(--fg); }
    .mrow-d { font-size: var(--t-label); line-height: var(--lh-label); color: var(--faint); }
    .mrow[disabled] { cursor: not-allowed; }
    .mrow[disabled] .mrow-t { color: var(--dis-fg); }
    .kbd { margin-left: auto; font-size: 13px; color: var(--mut);
      font-family: "Geist Mono", "Cascadia Mono", ui-monospace, Consolas, monospace; }
    .pd-note { margin: 10px 0 0; font-size: var(--t-label); line-height: var(--lh-label); color: var(--faint); }

    /* ---- model center ---------------------------------------------------- */
    /* One shell for Explore, My models and Downloads. The task bar says
       "Models" on all three; these tabs say which view is open, and the
       toolbar keeps its geometry so nothing jumps between routes. */
    .mc-scroll { overflow-y: auto; }
    .mc { width: 100%; max-width: 1180px; margin: 0 auto; padding: 20px 28px 40px;
      display: flex; flex-direction: column; gap: 16px; }
    .mc-head { display: flex; flex-direction: column; gap: 10px; }
    .mc-title { display: flex; align-items: center; gap: 10px; }
    .mc-h1 { margin: 0; font-size: 22px; line-height: 30px; font-weight: 600;
      letter-spacing: -.01em; }
    /* Said once, for the whole centre, never per row. */
    .mc-demo { display: inline-flex; align-items: center; height: 24px; padding: 0 9px;
      border: 1px solid var(--line-strong); border-radius: 6px;
      font-size: 13px; line-height: 18px; color: var(--mut); }
    .mc-tabs { display: flex; align-items: center; gap: 2px;
      border-bottom: 1px solid var(--line-soft); }
    .mc-tabs > a { display: inline-flex; align-items: center; gap: 6px; height: 40px;
      padding: 0 12px; font-size: 14px; line-height: 20px; font-weight: 500;
      color: var(--mut); text-decoration: none;
      border-bottom: 2px solid transparent; margin-bottom: -1px; }
    .mc-tabs > a:hover { color: var(--fg); text-decoration: none; }
    .mc-tabs > [aria-current="page"] { color: var(--fg); font-weight: 600;
      border-bottom-color: var(--line-strong); }
    .mc-n { font-size: 13px; color: var(--mut); font-variant-numeric: tabular-nums; }
    .mc-tools { display: flex; align-items: center; gap: 8px; min-height: 40px; }
    .mc-tools-r { display: flex; align-items: center; gap: 8px; margin-left: auto; }
    .mc-search { width: 380px; max-width: 100%; height: 40px; }
    .mc-search input { font-size: 14px; }
    .mc-summary { margin: 0; font-size: 14px; line-height: 20px; color: var(--mut); }
    .mc-foot { margin: 6px 0 0; font-size: var(--t-label); line-height: var(--lh-label); color: var(--faint); }
    .mc-sec { display: flex; flex-direction: column; gap: 6px; }
    .mc-sec + .mc-sec { margin-top: 18px; }
    .mc-filters { display: flex; flex-wrap: wrap; gap: 6px; }
    .chipf { min-height: 36px; padding: 0 12px; border: 1px solid var(--line);
      border-radius: 7px; background: none; font-size: var(--t-label); line-height: var(--lh-label); color: var(--mut); }
    .chipf:hover { background: var(--sunk); color: var(--fg); }
    .chipf[aria-pressed="true"] { background: var(--sunk); color: var(--fg);
      border-color: var(--line-strong); font-weight: 500; }

    /* One state block, aligned to the content column: a heading, one sentence
       and at most one action. Not a card, not centred in the viewport. */
    .vstate { display: flex; flex-direction: column; align-items: flex-start; gap: 8px;
      padding: 26px 8px 8px; max-width: 52ch; }
    .vstate-h { margin: 0; font-size: 16px; line-height: 24px; font-weight: 500; color: var(--fg); }
    .vstate-b { margin: 0; font-size: 14px; line-height: 20px; color: var(--mut); }
    .vstate-a { align-self: flex-start; min-height: 36px; padding: 0; border: 0; background: none;
      font-size: 14px; line-height: 20px; color: var(--acc-text); text-decoration: none; }
    .vstate-a:hover { text-decoration: underline; }
    .mdet-help { margin-top: 12px; }
    .mdet-help > summary { cursor: pointer; min-height: 36px; display: flex; align-items: center;
      font-size: 14px; line-height: 20px; color: var(--mut); }
    .mdet-help > summary:hover { color: var(--fg); }
    .mdet-help > p { margin: 4px 0 0; font-size: 14px; line-height: 20px; color: var(--faint);
      max-width: 68ch; }
    .vstate-a:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 4px; }

    /* ---- Explore: list beside detail -------------------------------------- */
    /* The list is the index and the detail is the decision, so the detail gets
       the larger share. Both are work surfaces on the canvas: no card around
       either, and one structural line between them. */
    .mc-explore .cat { display: grid; grid-template-columns: 400px minmax(0, 1fr);
      gap: 0 24px; align-items: start; min-height: 0; }
    .cat-list { display: flex; flex-direction: column; min-width: 0;
      border-right: 1px solid var(--line-soft); padding-right: 24px; }
    .cat-rows { display: flex; flex-direction: column; }
    .cat-detail-wrap { min-width: 0; }

    /* One row primitive, shared by Explore and the loader. */
    .mrow2 { display: grid; grid-template-columns: 36px minmax(0, 1fr) auto;
      grid-template-rows: auto auto auto; gap: 1px 12px;
      padding: 12px; border-radius: 8px; text-decoration: none;
      transition: background 140ms ease-out; }
    .mrow2:hover { background: var(--sunk); text-decoration: none; }
    .mrow2.is-on { background: var(--sidebar-selected); }
    .mrow2:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
    .mrow2-mark { grid-column: 1; grid-row: 1 / 3; width: 34px; height: 34px;
      display: inline-flex; align-items: center; justify-content: center;
      border-radius: 8px; background: var(--sunk); color: var(--mut);
      font-size: 13px; font-weight: 600; letter-spacing: .02em; }
    .mrow2.is-on .mrow2-mark { background: var(--raised); }
    .mrow2-n { grid-column: 2; grid-row: 1; font-size: var(--t-body); line-height: 22px;
      font-weight: 600; color: var(--fg); overflow: hidden;
      text-overflow: ellipsis; white-space: nowrap; }
    .mrow2-pub { grid-column: 2; grid-row: 2; font-size: var(--t-label);
      line-height: var(--lh-label); color: var(--mut); }
    .mrow2-use { grid-column: 2 / -1; grid-row: 3; font-size: var(--t-label); line-height: 21px;
      color: var(--mut); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      margin-top: 3px; }
    /* a fixed right track, so labels never shift between rows */
    .mrow2-right { grid-column: 3; grid-row: 1 / 3; display: flex;
      flex-direction: column; align-items: flex-end; justify-content: center; gap: 2px;
      text-align: right; min-width: 128px; }
    .mrow2-size { font-size: 14px; line-height: 20px; color: var(--fg);
      font-variant-numeric: tabular-nums; }
    .mrow2-fit { font-size: var(--t-label); line-height: var(--lh-label); color: var(--mut); }
    .mrow2-fit.is-over { color: var(--bad); }
    .mrow2-inst { display: inline-flex; align-items: center; gap: 5px;
      font-size: var(--t-label); line-height: var(--lh-label); color: var(--mut); }

    /* ---- Explore: detail --------------------------------------------------- */
    .mdet { display: flex; flex-direction: column; gap: 0; padding: 4px 0 32px;
      max-width: 760px; }
    .mdet-back { display: none; align-items: center; gap: 6px; min-height: 40px;
      font-size: 14px; color: var(--mut); text-decoration: none; }
    .mdet-h { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto;
      gap: 0 14px; align-items: start; }
    .mdet-mark { width: 44px; height: 44px; display: inline-flex; align-items: center;
      justify-content: center; border-radius: 10px; background: var(--sunk);
      color: var(--mut); font-size: 15px; font-weight: 600; }
    .mdet-id { min-width: 0; }
    .mdet-name { margin: 0; font-size: var(--t-title); line-height: var(--lh-title); font-weight: 600;
      letter-spacing: -.01em; }
    .mdet-sub { margin: 3px 0 0; font-size: var(--t-label); line-height: var(--lh-label);
      color: var(--mut); }
    .mdet-sub a { color: var(--mut); }
    .mdet-act { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .mdet-state { display: inline-flex; align-items: center; gap: 6px;
      font-size: 14px; color: var(--mut); }
    .mdet-desc { margin: 16px 0 0; font-size: var(--t-body); line-height: var(--lh-body); color: var(--mut);
      max-width: 70ch; }
    .mdet-caps { list-style: none; display: flex; flex-wrap: wrap; gap: 6px;
      margin: 16px 0 0; padding: 0; }
    .mdet-caps li { display: inline-flex; align-items: center; height: 30px;
      padding: 0 11px; border: 1px solid var(--line); border-radius: 7px;
      font-size: var(--t-label); line-height: var(--lh-label); color: var(--mut); }
    .mdet-note { margin: 12px 0 0; font-size: var(--t-label); line-height: 21px;
      color: var(--mut); max-width: 68ch; }
    .mdet-sec { margin-top: 28px; }
    .mdet-h3 { margin: 0 0 10px; font-size: var(--t-copy); line-height: var(--lh-copy);
      font-weight: 600; color: var(--fg); }
    .mdet-kv { margin: 0; display: grid; grid-template-columns: 150px minmax(0, 1fr);
      gap: 8px 16px; }
    .mdet-kv dt { font-size: var(--t-label); line-height: 21px; color: var(--mut); }
    .mdet-kv dd { margin: 0; font-size: var(--t-label); line-height: 21px; color: var(--fg); }
    .mdet-fitline { margin: 0; font-size: var(--t-copy); line-height: var(--lh-copy); color: var(--fg); }
    .mdet-fitline.is-over { color: var(--bad); }
    /* the one bordered surface in the pane: the artifact being decided on */
    .mdet-variant { margin-top: 28px; padding: 14px 16px 12px;
      border: 1px solid var(--line); border-radius: 10px; }
    .mdet-variant .mdet-h3 { margin-bottom: 8px; }
    .mvar { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 16px;
      align-items: center; min-height: 46px; }
    .mvar-q { grid-column: 1; grid-row: 1; font-size: 14px; line-height: 20px;
      font-weight: 500; color: var(--fg); }
    .mvar-m { grid-column: 1; grid-row: 2; font-size: 13px; line-height: 18px;
      color: var(--mut); }
    .mvar-s { grid-column: 2; grid-row: 1 / 3; font-size: 14px; line-height: 20px;
      color: var(--fg); font-variant-numeric: tabular-nums; }

    /* ---- My models: one row primitive -------------------------------------- */
    .ilist { list-style: none; margin: 0; padding: 0; }
    .ilist > li { border-top: 1px solid var(--line-soft); }
    .ilist > li:first-child { border-top: 0; }
    .irow { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto;
      gap: 2px 14px; align-items: center; padding: 14px 8px; min-height: 88px; }
    .irow-mark { grid-row: 1; width: 38px; height: 38px; display: inline-flex;
      align-items: center; justify-content: center; border-radius: 9px;
      background: var(--sunk); color: var(--mut); font-size: 14px; font-weight: 600; }
    .irow-id { min-width: 0; }
    .irow-n { display: block; font-size: 16px; line-height: 24px; font-weight: 600;
      color: var(--fg); background: none; border: 0; padding: 0; text-align: left; }
    .irow-n:hover { color: var(--fg); text-decoration: underline; }
    .irow-use { margin: 2px 0 0; font-size: 14px; line-height: 20px; color: var(--mut);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .irow-res { margin: 4px 0 0; font-size: var(--t-label); line-height: var(--lh-label); color: var(--faint); }
    .irow-act { display: flex; align-items: center; gap: 10px; justify-self: end; }
    .irow-state { font-size: 14px; color: var(--mut); }
    .ilist > li.is-current .irow { background: var(--sidebar-selected); }

    /* ---- downloads: progress and recovery lead ------------------------------ */
    .dl-head { margin: 6px 0 0; font-size: 15px; line-height: 22px; font-weight: 500;
      color: var(--fg); }
    .dlrow.is-bad .dl-head { color: var(--bad); }
    .dl-det { margin-top: 8px; }
    .dl-det > summary { cursor: pointer; font-size: var(--t-label); line-height: var(--lh-label); color: var(--mut);
      min-height: 32px; display: flex; align-items: center; }
    .dl-det > p { margin: 4px 0 0; font-size: 14px; line-height: 20px; color: var(--faint);
      max-width: 70ch; }
    .dlrow.is-done { min-height: 64px; padding-top: 12px; padding-bottom: 12px; }
    .dlrow.is-done .dl-main { gap: 3px; }

    @media (max-width: 1099px) {
      .mc-explore .cat { grid-template-columns: minmax(0, 38%) minmax(0, 1fr); gap: 0 18px; }
      .cat-list { padding-right: 18px; }
      .mrow2-use { display: none; }
    }
    /* Below 800 the list is the page and a selection opens its own detail. */
    @media (max-width: 799px) {
      .mc { padding: 16px 16px 32px; }
      .mc-explore .cat { grid-template-columns: minmax(0, 1fr); gap: 0; }
      .cat-list { border-right: 0; padding-right: 0; }
      .mrow2-use { display: block; }
      .cat[data-selected] .cat-list { display: none; }
      .cat:not([data-selected]) .cat-detail-wrap { display: none; }
      .mdet-back { display: inline-flex; }
      .mdet-h { grid-template-columns: 40px minmax(0, 1fr); }
      .mdet-act { grid-column: 1 / -1; margin-top: 14px; }
      .irow { grid-template-columns: 38px minmax(0, 1fr); }
      .irow-act { grid-column: 1 / -1; justify-self: start; margin-top: 10px; }
      .mc-search { width: 100%; }
    }
    @media (max-width: 720px) {
      .chipf, .mc-tabs > a { min-height: 44px; }
      .irow-act .btn { min-height: 44px; }
    }

    /* ---- model picker ---------------------------------------------------- */
    .mpick { width: 360px; padding: 6px; max-height: 420px; overflow-y: auto; }
    .mpick-h { display: block; padding: 8px 9px 4px; font-size: 13px;
      font-weight: 600; letter-spacing: .04em; text-transform: uppercase;
      color: var(--mut); }
    .mpick-row { display: grid; grid-template-columns: 15px minmax(0,1fr) auto;
      gap: 4px 10px; width: 100%; padding: 8px 9px; border: 0; background: none;
      border-radius: 7px; text-align: left; cursor: pointer; }
    .mpick-row:hover { background: var(--sunk); }
    .mpick-row:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
    .mpick-row .n { grid-column: 2; font-size: 14px; line-height: 20px;
      font-weight: 500; color: var(--fg); overflow: hidden;
      text-overflow: ellipsis; white-space: nowrap; }
    .mpick-row .meta { grid-column: 2; font-size: 13px; line-height: 18px;
      color: var(--mut); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mpick-row .ic { grid-column: 1; grid-row: 1; display: inline-flex;
      justify-content: center; padding-top: 3px; }
    .mpick-row .tick { grid-column: 3; grid-row: 1; color: var(--acc-text); }
    .mpick-row[aria-disabled="true"] { cursor: default; }
    .badge-agent { display: inline-flex; align-items: center; height: 22px;
      padding: 0 8px; border-radius: 6px; background: var(--acc-soft);
      color: var(--acc-text); font-size: 13px; font-weight: 500; }
    .mpick-foot { display: flex; gap: 6px; padding: 6px 3px 2px; margin-top: 4px;
      border-top: 1px solid var(--line-soft); }

    /* ---- stream events ------------------------------------------------- */
    /* Every event is a 34px row with a glyph, a label and its evidence behind
       it. Whitespace and one hairline separate them; none of them is a card. */
    .acts { display: flex; flex-direction: column; margin: 2px 0; }
    .ev { display: flex; flex-direction: column; }
    .evrow { display: flex; align-items: center; gap: 10px; width: 100%;
      min-height: 34px; padding: 4px 6px; margin-left: -6px; border: 0;
      background: none; border-radius: 7px; text-align: left; color: var(--mut);
      font: inherit; font-size: 14px; line-height: 20px; }
    button.evrow { cursor: pointer; }
    button.evrow:hover { background: var(--sunk); color: var(--fg); }
    button.evrow:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
    .evrow-i { display: inline-flex; width: 15px; justify-content: center; flex-shrink: 0; }
    .evrow-t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis;
      white-space: nowrap; }
    .evrow-t.m { font-size: 14px; }
    .evrow-m { font-size: 13px; color: var(--mut); flex-shrink: 0; }
    .evrow-c { display: inline-flex; color: var(--faint); flex-shrink: 0;
      transition: transform 140ms ease-out; }
    .evrow[aria-expanded="true"] .evrow-c { transform: rotate(180deg); }
    .evbody { padding: 6px 0 10px 25px; }
    .evkv { display: flex; gap: 12px; margin: 0 0 5px; font-size: 13px;
      line-height: 18px; color: var(--mut); }
    .evkv > span:first-child { width: 92px; color: var(--faint); flex-shrink: 0; }
    .evout { margin: 4px 0 0; padding: 10px 12px; border-radius: 8px;
      background: var(--sunk); border: 1px solid var(--line-soft);
      font-size: 14px; line-height: 20px; color: var(--mut);
      max-height: 260px; overflow: auto; white-space: pre-wrap; }
    .ev-tool.is-fail .evrow-t { color: var(--bad); }
    .ev-audit .evrow { color: var(--faint); font-size: 14px; }

    /* the plan is a row that opens a checklist, not a permanent block */
    .ev-plan .evbody { padding-top: 2px; }

    /* the outcome: one status line, then evidence, then one way into the pane */
    .done { display: flex; flex-direction: column; gap: 2px; margin: 10px 0 2px; }
    .done-h { display: flex; align-items: center; gap: 9px; margin: 0 0 4px;
      font-size: 15px; line-height: 22px; font-weight: 600; color: var(--fg); }
    .done-i { display: inline-flex; }
    .done-t { font-size: 13px; font-weight: 400; color: var(--mut); }
    .evidence { display: flex; align-items: center; gap: 10px; width: 100%;
      min-height: 34px; padding: 4px 6px; margin-left: -6px; border: 0;
      background: none; border-radius: 7px; cursor: pointer; text-align: left;
      color: var(--mut); font: inherit; font-size: 14px; line-height: 20px; }
    .evidence:hover { background: var(--sunk); color: var(--fg); }
    .evidence:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
    .evidence > span:first-child { flex: 1; min-width: 0; }
    .done.is-stopped .done-h { color: var(--warn); }

    /* ---- queued corrections -------------------------------------------- */
    .queue { display: flex; flex-direction: column; gap: 4px; padding: 2px 2px 8px; }
    .qrow { display: flex; align-items: center; gap: 9px; min-height: 34px;
      padding: 3px 8px; border-radius: 7px; background: var(--sunk);
      font-size: 14px; line-height: 20px; color: var(--mut); }
    .qrow-i { display: inline-flex; color: var(--faint); flex-shrink: 0; }
    .qrow-t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis;
      white-space: nowrap; }

    /* ---- caret menus ---------------------------------------------------- */
    .caret-menu { position: absolute; bottom: calc(100% + 8px); left: 8px;
      width: min(420px, calc(100% - 16px)); z-index: 40; padding: 6px;
      max-height: 260px; overflow-y: auto; }
    .caret-menu .srow .lab { margin-left: auto; }

    /* ---- permission, collapsed ------------------------------------------ */
    .perm-q { margin: 0; font-size: 15px; line-height: 22px; font-weight: 600; }
    .perm-scope { margin: 8px 0 0; font-size: 14px; line-height: 20px;
      color: var(--mut); }
    .perm-d { margin-top: 12px; }
    .perm-d > summary { cursor: pointer; font-size: 14px; color: var(--mut);
      min-height: 36px; display: flex; align-items: center; }
    .perm-d > summary:hover { color: var(--fg); }
    .perm-d[open] > summary { margin-bottom: 6px; }

    /* ---- documentation ------------------------------------------------------ */
    /* Two columns: a persistent index and one readable measure. No cards, and
       the article is the widest thing on the page rather than a panel in it. */
    .docwrap { display: grid; grid-template-columns: 210px minmax(0, 1fr);
      gap: 56px; align-items: start; padding: 56px 24px 88px; }
    .docnav { position: sticky; top: 84px; display: flex; flex-direction: column; gap: 22px; }
    .docnav-g { display: flex; flex-direction: column; gap: 2px; }
    .docnav-g .lab { margin-bottom: 5px; }
    .docnav a { display: flex; align-items: center; min-height: 40px; padding: 6px 10px;
      margin-left: -10px; border-radius: 7px; font-size: 14px; line-height: 20px;
      color: var(--mut); text-decoration: none; }
    .docnav a:hover { background: var(--sunk); color: var(--fg); }
    .docnav a.on { color: var(--fg); font-weight: 600; background: var(--sunk); }
    .docbody { max-width: 44rem; }
    .docbreadcrumb { margin: 0 0 14px; font-size: 13px; color: var(--mut); }
    .docbreadcrumb a { color: var(--mut); }
    .docbreadcrumb span { margin: 0 7px; }
    .docmeta { margin: 16px 0 0; font-size: 13px; color: var(--mut); }
    .docbody .docsec:first-of-type { margin-top: 30px; }
    .docbody .docsec p { margin: 0 0 14px; font-size: 16px; line-height: 24px; color: var(--mut); }
    .docbody .docsec p:last-child { margin-bottom: 0; }
    .docnote { border-left: 2px solid var(--line); padding-left: 16px; }
    .doccode { margin: 0 0 14px; padding: 14px 16px; border: 1px solid var(--line);
      border-radius: 8px; background: var(--sunk); font-size: 13px; line-height: 18px;
      overflow-x: auto; color: var(--fg); }
    .doclist { margin: 0 0 14px; padding-left: 22px; }
    .doclist li { font-size: 16px; line-height: 24px; color: var(--mut); margin-bottom: 8px; }
    .doclist li::marker { color: var(--faint); }
    .dockv { margin: 0 0 14px; display: grid; gap: 0; }
    .dockv > div { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 22px;
      padding: 13px 0; border-top: 1px solid var(--line-soft); }
    .dockv > div:last-child { border-bottom: 1px solid var(--line-soft); }
    .dockv dt { font-size: 15px; font-weight: 600; color: var(--fg); }
    .dockv dd { margin: 0; font-size: 15px; line-height: 22px; color: var(--mut); }
    .docpn { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 44px;
      padding-top: 26px; border-top: 1px solid var(--line); }
    .docpn a { display: flex; flex-direction: column; gap: 4px; padding: 15px 17px;
      border: 1px solid var(--line); border-radius: 10px; text-decoration: none;
      min-height: 40px; justify-content: center; }
    .docpn a:hover { border-color: var(--line-strong); background: var(--sunk); }
    .docpn a.nx { text-align: right; }
    .docpn .lab { font-size: 13px; }
    .docpn .t { font-size: 15px; font-weight: 600; color: var(--fg); }
    .docgroup { margin-top: 34px; }
    .docgroup:first-child { margin-top: 0; }
    .docgroup-h { margin-bottom: 6px; }
    .docgroup-h h2 { margin: 0; font-size: 19px; line-height: 27px; font-weight: 600; }
    .docgroup-h p { margin: 4px 0 0; font-size: 14px; line-height: 20px; color: var(--mut); }
    .docrow { grid-template-columns: minmax(0, 1fr) auto; }
    .docrow .t { grid-column: 1; text-decoration: none; }
    .docrow .d { grid-column: 1 / -1; }
    .docrow .s { grid-column: 2; }
    .measure-w { max-width: 62rem; }

    @media (max-width: 900px) {
      /* twelve links ahead of the article is a wall to scroll past on a phone,
         so the index moves below the thing you actually opened */
      .docwrap { grid-template-columns: minmax(0, 1fr); gap: 30px; padding: 40px 20px 72px; }
      .docbody { order: 1; }
      .docnav { order: 2; position: static; flex-direction: row; flex-wrap: wrap;
        gap: 20px 28px; padding-top: 30px; border-top: 1px solid var(--line); }
      .docnav-g { min-width: 150px; }
      .docnav a { margin-left: -10px; }
      .dockv > div { grid-template-columns: minmax(0, 1fr); gap: 3px; }
      .docpn { grid-template-columns: minmax(0, 1fr); }
      .docpn a.nx { text-align: left; }
    }

    .docsec { border-top:1px solid var(--line); padding:34px 0 0; margin-top:34px; }
    .docsec > h2 { margin:0 0 12px; font-size:20px; line-height:28px; font-weight:600;
      letter-spacing:-.012em; }
    .docsec > p { margin:0 0 16px; font-size: 15px; line-height: 22px; color:var(--mut);
      max-width:72ch; }
    /* the metadata band under a title: values on a grid, rules top and bottom */
    .specs { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
      gap:20px 32px; padding:20px 0; border-top:1px solid var(--line);
      border-bottom:1px solid var(--line); margin:28px 0 0; }
    .specs > div { display:flex; flex-direction:column; gap:3px; min-width:0; }
    .specs dt, .specs .k { font-size: 13px; line-height: 18px; color: var(--mut); }
    .specs dd, .specs .v { margin:0; font-size: 15px; line-height: 22px;
      font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
    /* a table inside a document reads as rules, not as another outlined box */
    .tbl.flat { border:0; border-radius:0; border-top:1px solid var(--line);
      border-bottom:1px solid var(--line); }
    .tbl.flat thead th { background:transparent; font-family:inherit; font-size:13px;
      letter-spacing:0; border-bottom:1px solid var(--line); }
    .tbl.flat th, .tbl.flat td { padding:12px 12px 12px 0; }
    .tbl.flat tbody tr:last-child td { border-bottom:0; }
    /* one contained callout, reserved for a genuinely exceptional state */
    .callout { border:1px solid var(--line); border-radius:10px; background:var(--panel);
      padding:18px 20px; display:flex; gap:14px; align-items:flex-start; }
    .callout svg { flex-shrink:0; margin-top:2px; }

    /* ---- pricing ------------------------------------------------------ */
    /* One surface split by rules, not three floating cards. Every column
       shares the same baselines, so the eye compares rows rather than boxes. */
    .billing { display:flex; align-items:center; gap:14px; margin-bottom:22px; }
    .billing > span { font-size:14px; color:var(--mut); }
    .plans { display:grid; grid-template-columns:repeat(3, 1fr);
      /* eyebrow, name, price, note, blurb, features, cta: one row line per
         band, so every column shares the same baselines */
      grid-template-rows:auto auto auto auto auto 1fr auto;
      border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
    .plan { display:grid; grid-template-rows:subgrid; grid-row:span 7;
      padding:24px 26px; border-left:1px solid var(--line-soft); align-content:start; }
    .plan:first-child { border-left:0; }
    /* Every plan sits on the same surface. A violet panel and a violet stripe
       made the recommendation a graphic rather than a recommendation; one
       small label does that job. */
    .plan-eyebrow { font-size: 13px; line-height: 18px; color:var(--mut); font-weight:500; }
    .plan-price { display:flex; align-items:baseline; gap:5px; margin-top:8px; }
    .plan-price .num { font-size:34px; line-height:40px; font-weight:600; letter-spacing:-.02em; }
    .plan-price .mut { font-size:14px; }
    .plan-note { font-size: 13px; line-height: 18px; min-height:18px; display:block; }
    .plan-blurb { margin:12px 0 0; font-size: 14px; line-height: 20px; color:var(--mut); }
    .plan-feats { list-style:none; margin:20px 0 0; padding:0;
      display:flex; flex-direction:column; gap:10px; }
    .plan-feats li { display:flex; gap:9px; align-items:flex-start;
      font-size: 14px; line-height: 20px; }
    .plan-feats svg { flex-shrink:0; margin-top:4px; }
    .plan-cta { margin-top:24px; align-self:end; }
    /* Without subgrid the columns stack their own rows; they no longer share
       baselines, but nothing overlaps or clips. */
    @supports not (grid-template-rows: subgrid) {
      .plan { display:flex; flex-direction:column; }
      .plan-cta { margin-top:auto; padding-top:24px; }
    }
    @media (max-width: 900px) {
      .plans { grid-template-columns:1fr; grid-template-rows:none; }
      .plan { grid-row:auto; grid-template-rows:none; border-left:0;
        border-top:1px solid var(--line-soft); }
      .plan:first-child { border-top:0; }
    }

    /* ---- disclosure list ---------------------------------------------- */
    /* Questions are rows in one list, not a stack of rounded cards. */
    .faq > details { border-top:1px solid var(--line); }
    .faq > details:last-child { border-bottom:1px solid var(--line); }
    .faq summary { display:flex; align-items:center; gap:12px; cursor:pointer;
      list-style:none; padding:16px 2px; min-height:40px;
      font-size: 15px; line-height: 22px; font-weight:500; }
    .faq summary::-webkit-details-marker { display:none; }
    .faq summary svg { margin-left:auto; flex-shrink:0; color:var(--faint);
      transition:transform 160ms ease-out; }
    .faq details[open] summary svg { transform:rotate(180deg); }
    .faq summary:hover { color:var(--acc-text); }
    .faq p { margin:0; padding:0 2px 18px; font-size: 15px; line-height: 22px;
      color:var(--mut); max-width:72ch; }

    .msec { padding:0 32px; }
    .mhero h1 { margin:0; font-size:clamp(40px,4.4vw,60px); line-height:1.03;
      font-weight:600; letter-spacing:-.028em; max-width:15ch; }
    .mlede { margin:0; font-size:17px; line-height:27px; color:var(--mut); max-width:62ch; }
    .mbody { font-size: 16px; line-height: 24px; }
    .msmall { font-size: 13px; line-height: 18px; }
    .mh2 { margin:0; font-size:clamp(32px,3vw,40px); line-height:1.12; font-weight:600;
      letter-spacing:-.022em; }
    .mh1 { margin:0; font-size:clamp(36px,3.6vw,48px); line-height:1.14; font-weight:600;
      letter-spacing:-.024em; }
    .stack { display:flex; flex-direction:column; }

    /* ---- landing page --------------------------------------------------- */
    /* Scoped to body.lp rather than retuning the shared marketing classes,
       because /models/, /security/, /pricing/ and /docs/ are out of this
       brief's scope and share .mh1, .mh2 and .mlede.

       The palette is the one difference the eye should notice: the rest of the
       site is warm cream, and this page is close to neutral, so the dark
       product surface reads as the subject rather than as another card on a
       tinted ground. */
    body.lp {
      --lp-bg:#FBFBFA; --lp-fg:#171717; --lp-mut:#62625F;
      --lp-line:#DEDEDA; --lp-line-soft:#EAEAE7; --lp-sunk:#F2F2F0;
      --lp-ink:#0E0F10;
      background: var(--lp-bg); color: var(--lp-fg);
    }
    body.lp .mhead { background: var(--lp-bg); border-bottom-color: transparent; }
    /* The hairline appears only once the page has moved under the header. */
    body.lp .mhead[data-stuck="true"] { border-bottom-color: var(--lp-line); }
    body.lp .mhead [data-nav] a { color: var(--lp-mut); }
    body.lp .mhead [data-nav] a:hover,
    body.lp .mhead [data-nav] a[aria-current="page"] { color: var(--lp-fg); }

    .lp-wrap { width:100%; max-width:1240px; margin:0 auto;
      padding:0 clamp(20px, 5vw, 64px); }
    /* One section rhythm, so no section needs its own padding override. */
    .lp-sec { padding: clamp(72px, 9vw, 152px) 0; }
    .lp-sec-tight { padding: clamp(56px, 6vw, 96px) 0; }

    .lp-h1 { margin:0; font-size:clamp(40px, 5.4vw, 68px); line-height:1.0;
      font-weight:500; letter-spacing:-.03em; color:var(--lp-fg); max-width:22ch; }
    .lp-h2 { margin:0; font-size:clamp(32px, 3.8vw, 52px); line-height:1.08;
      font-weight:500; letter-spacing:-.025em; color:var(--lp-fg); }
    .lp-h3 { margin:0; font-size:clamp(22px, 2vw, 28px); line-height:1.2;
      font-weight:500; letter-spacing:-.02em; color:var(--lp-fg); }
    .lp-lede { margin:0; font-size:18px; line-height:27px; color:var(--lp-mut);
      max-width:620px; }
    .lp-body { margin:0; font-size:17px; line-height:28px; color:var(--lp-mut);
      max-width:660px; }
    .lp-cap { font-size:14px; line-height:20px; color:var(--lp-mut); }
    /* The floor for anything legal or incidental. Nothing on the page is
       smaller, so 13px is both the minimum and the only small size. */
    .lp-fine { font-size:13px; line-height:19px; color:var(--lp-mut); }

    .lp-center { text-align:center; display:flex; flex-direction:column;
      align-items:center; gap:24px; }
    .lp-center .lp-lede, .lp-center .lp-body { margin-left:auto; margin-right:auto; }

    /* One radius convention for every marketing control on this page. */
    body.lp .btn { border-radius:12px; }
    .lp-actions { display:flex; align-items:center; gap:14px; flex-wrap:wrap;
      justify-content:center; }
    .lp-btn { height:48px; min-height:48px; padding:0 24px; font-size:16px;
      font-weight:500; border-radius:12px; }
    body.lp .btn.lp-btn.btnp { background:#171717; border-color:#171717; color:#fff; }
    body.lp .btn.lp-btn.btnp:hover { background:#000; border-color:#000; }
    .lp-quiet { display:inline-flex; align-items:center; min-height:48px;
      padding:0 8px; font-size:16px; font-weight:500; color:var(--lp-fg); }
    .lp-quiet:hover { color:var(--lp-mut); }
    /* A link that stands alone in its own paragraph is an action, not prose, so
       it gets a real target instead of the 22px an inline anchor would take. */
    .lp-link { display:inline-flex; align-items:center; min-height:44px;
      font-size:17px; line-height:26px; }

    /* Product proof. A dark surface with one radius and one hairline: no
       floating cards around it, no gradient under it.

       It has its own wrapper rather than sitting inside .lp-wrap, because the
       section padding capped it at 1112px on a 1366px screen. It now takes
       min(1240px, 100vw - 64px), which is about 91% of a 1366 viewport, and the
       workspace inside renders at its natural size: no transform, so the app's
       own type is at its real scale rather than optically shrunk to 90%. */
    .lp-proof-wrap { width:min(1240px, calc(100vw - 40px)); margin:0 auto; }
    .lp-proof { border-radius:20px; overflow:hidden; background:var(--lp-ink);
      border:1px solid var(--lp-line); }
    .lp-proof .lp-win { height:420px; overflow:hidden; }
    .lp-proof .lp-inner { width:1240px; }
    .lp-proof-note { display:flex; align-items:center; justify-content:space-between;
      gap:16px; flex-wrap:wrap; margin:14px 2px 0; }

    /* A label that says what a preview is, so a static screenshot is never
       mistaken for a running app. */
    .lp-tag { display:inline-flex; align-items:center; gap:7px; min-height:28px;
      padding:0 10px; border:1px solid var(--lp-line); border-radius:8px;
      background:var(--lp-bg); font-size:13px; line-height:19px; color:var(--lp-mut); }
    .lp-tag::before { content:""; width:6px; height:6px; border-radius:50%;
      background:var(--lp-mut); flex-shrink:0; }

    /* Three editorial rows, not three equal cards. */
    .lp-rows { display:flex; flex-direction:column; gap:clamp(64px, 7vw, 112px); }
    .lp-row { display:grid; grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);
      gap:clamp(32px, 5vw, 80px); align-items:center; }
    .lp-row > .lp-rowtext { display:flex; flex-direction:column; gap:14px; }
    .lp-row .lp-num { font-size:14px; line-height:20px; color:var(--lp-mut);
      font-variant-numeric:tabular-nums; }
    .lp-shot { border-radius:16px; overflow:hidden; background:var(--lp-ink);
      border:1px solid var(--lp-line); padding:22px; }

    /* The one major tonal change on the page. */
    .lp-dark { background:var(--lp-ink); color:#ECECEA; }
    .lp-dark .lp-h2 { color:#ECECEA; }
    .lp-dark .lp-body { color:#A8A8A4; }
    .lp-dark a { color:#ECECEA; text-decoration-color:#6A6A67; }
    .lp-dark a:hover { color:#fff; }

    /* One data surface for the memory arithmetic, rather than a row of pills. */
    .lp-data { border:1px solid var(--lp-line); border-radius:16px;
      background:#fff; overflow:hidden; max-width:720px; }
    .lp-data-h { padding:20px 24px; border-bottom:1px solid var(--lp-line-soft);
      display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; }
    .lp-kv { margin:0; padding:8px 24px 20px; display:grid;
      grid-template-columns:minmax(0,1fr) auto; gap:0; }
    .lp-kv dt { padding:11px 0; font-size:15px; line-height:22px; color:var(--lp-mut);
      border-bottom:1px solid var(--lp-line-soft); }
    .lp-kv dd { margin:0; padding:11px 0; font-size:15px; line-height:22px;
      color:var(--lp-fg); text-align:right; border-bottom:1px solid var(--lp-line-soft);
      font-variant-numeric:tabular-nums; }
    .lp-kv dt:last-of-type, .lp-kv dd:last-of-type { border-bottom:0; }
    .lp-verdict { padding:16px 24px; border-top:1px solid var(--lp-line-soft);
      background:var(--lp-sunk); font-size:15px; line-height:23px; color:var(--lp-fg); }
    .lp-data details > summary { cursor:pointer; padding:14px 24px;
      border-top:1px solid var(--lp-line-soft); font-size:14px; line-height:20px;
      color:var(--lp-fg); min-height:44px; display:flex; align-items:center; }
    .lp-data details > summary:hover { background:var(--lp-sunk); }
    .lp-data details[open] > summary { border-bottom:1px solid var(--lp-line-soft); }
    .lp-calc { margin:0; padding:16px 24px 20px; font-size:14px; line-height:24px;
      color:var(--lp-mut); font-variant-numeric:tabular-nums; }

    /* Pricing as columns separated by whitespace and hairlines. */
    .lp-plans { display:grid; grid-template-columns:repeat(3, minmax(0,1fr));
      border-top:1px solid var(--lp-line); }
    .lp-plans > div { padding:28px 28px 32px; border-left:1px solid var(--lp-line-soft); }
    .lp-plans > div:first-child { border-left:0; padding-left:0; }
    .lp-plan-n { font-size:15px; line-height:22px; font-weight:500; color:var(--lp-fg); }
    .lp-plan-p { font-size:32px; line-height:40px; font-weight:500; letter-spacing:-.02em;
      margin:8px 0 10px; color:var(--lp-fg); font-variant-numeric:tabular-nums; }
    .lp-plan-p span { font-size:15px; font-weight:400; color:var(--lp-mut);
      letter-spacing:0; }
    .lp-plan-d { font-size:15px; line-height:23px; color:var(--lp-mut); }
    .lp-rec { display:inline-block; margin-top:12px; font-size:14px; line-height:20px;
      color:var(--lp-fg); border-bottom:1px solid var(--lp-fg); }

    /* Hairline accordion. No box per question. */
    .lp-faq { border-top:1px solid var(--lp-line); max-width:820px; }
    .lp-faq details { border-bottom:1px solid var(--lp-line); }
    .lp-faq summary { cursor:pointer; list-style:none; padding:22px 40px 22px 0;
      position:relative; font-size:17px; line-height:26px; color:var(--lp-fg); }
    .lp-faq summary::-webkit-details-marker { display:none; }
    .lp-faq summary::after { content:""; position:absolute; right:6px; top:31px;
      width:9px; height:9px; border-right:1.6px solid var(--lp-mut);
      border-bottom:1.6px solid var(--lp-mut); transform:rotate(45deg);
      transition:transform 180ms ease-out; }
    .lp-faq details[open] summary::after { transform:rotate(-135deg); top:34px; }
    .lp-faq summary:hover { color:var(--lp-mut); }
    .lp-faq p { margin:0; padding:0 0 24px; font-size:17px; line-height:28px;
      color:var(--lp-mut); max-width:70ch; }

    /* One entrance, once, and only for the surfaces that benefit.
       The hidden state is gated on a class the controller adds, so a page whose
       script fails or has not run yet shows its content rather than a column of
       invisible sections. */
    body.lp-anim .lp-enter { opacity:0; transform:translateY(14px);
      transition:opacity 420ms ease-out, transform 420ms ease-out; }
    body.lp-anim .lp-enter.is-in { opacity:1; transform:none; }

    /* ---- landing: desktop scale ------------------------------------------
       The page read small at 100% zoom: a 68px hero over an 831px column, 17px
       body copy, and a product surface using 81% of a 1366 screen. Everything
       below is the real type, control and width tokens moved up, not a zoom or
       a transform, so text stays crisp and breakpoints keep meaning what they
       say.

       The whole tier is gated at 768px, so the mobile composition below it is
       literally the same CSS it was before this pass. Each clamp reaches its
       full value at 1280 and eases down to the old value at 768, which is the
       smooth 1024-1280 ramp the brief asks for. */
    @media (min-width: 768px) {
      /* header */
      body.lp .mhead [data-nav] a { font-size:15px; }
      body.lp .mhead [data-nav] a.btn { font-size:15px; height:42px; }
      body.lp .brand span { font-size:17px; }
      body.lp .brand svg { width:26px; height:26px; }

      /* hero */
      .lp-h1 { font-size:clamp(48px, calc(5.86vw + 3px), 78px); line-height:.99;
        max-width:1000px; }
      .lp-lede { font-size:clamp(18px, calc(.39vw + 15px), 20px); line-height:1.5;
        max-width:690px; }
      .lp-fine { font-size:15px; line-height:22px; }
      .lp-btn { height:52px; min-height:52px; padding:0 26px; font-size:17px; }
      .lp-quiet { min-height:52px; font-size:17px; }

      /* sections */
      .lp-h2 { font-size:clamp(36px, calc(4.49vw + 1.5px), 59px); }
      .lp-h3 { font-size:clamp(24px, calc(1.37vw + 13.5px), 31px); }
      .lp-body { font-size:clamp(17px, calc(.39vw + 14px), 19px); line-height:1.53;
        max-width:700px; }
      .lp-cap { font-size:15px; line-height:22px; }
      .lp-num { font-size:15px; line-height:22px; }
      .lp-link { font-size:18px; min-height:48px; }
      .lp-tag { font-size:14px; line-height:20px; min-height:32px; padding:0 12px; }
      .lp-tag::before { width:7px; height:7px; }

      /* data surface */
      .lp-data { max-width:780px; }
      .lp-data-h { padding:22px 26px; }
      .lp-kv { padding:8px 26px 22px; }
      .lp-kv dt, .lp-kv dd { font-size:16px; line-height:24px; padding:12px 0; }
      .lp-verdict { padding:18px 26px; font-size:16px; line-height:25px; }
      .lp-data details > summary { padding:15px 26px; font-size:15px; line-height:22px; }
      .lp-calc { padding:18px 26px 22px; font-size:15px; line-height:26px; }

      /* pricing */
      .lp-plan-n { font-size:16px; line-height:24px; }
      .lp-plan-p { font-size:36px; line-height:44px; margin:10px 0 12px; }
      .lp-plan-p span { font-size:16px; }
      .lp-plan-d { font-size:16px; line-height:25px; }
      .lp-rec { font-size:15px; line-height:22px; }

      /* faq */
      .lp-faq summary { font-size:18px; line-height:28px; padding:24px 44px 24px 0; }
      .lp-faq summary::after { width:10px; height:10px; top:33px; }
      .lp-faq details[open] summary::after { top:37px; }
      .lp-faq p { font-size:18px; line-height:29px; padding:0 0 26px; }

      /* The cropped product views render real app components, whose metadata
         floor is 13px. That is right inside the application and too small in a
         marketing screenshot, so the floor is raised here and nowhere else.
         These carry body.lp because `.kv dt` and `.faint` are defined later in
         the sheet at the same specificity, and a tie is settled by order. */
      body.lp .lp-shot dt, body.lp .lp-shot dd,
      body.lp .lp-shot .lab, body.lp .lp-shot .pill,
      body.lp .lp-shot .arow, body.lp .lp-shot .m { font-size:15px; line-height:22px; }
      body.lp .lp-shot pre.m { font-size:15px; line-height:23px; }
      body.lp .lp-shot svg { width:16px; height:16px; }

      /* The footer is shared, so only the landing copy of it moves. Links were
         already 14px; the group labels and legal lines were not. */
      body.lp .mfoot .lab { font-size:14px; line-height:20px; }
      body.lp .mfoot .mfoot-note { font-size:14px; line-height:21px; }
      /* The legal row sets 13px on the container, so the children inherit it;
         raising the row is what actually moves them. */
      body.lp .mfoot .mfoot-legal { font-size:14px; line-height:21px; }
      body.lp .mfoot .brand.small { font-size:14px; }
      body.lp .mfoot a:not(.btn) { font-size:15px; }

      /* product proof: the reason the page looked small */
      .lp-proof-wrap { width:min(1240px, calc(100vw - 64px)); }
      .lp-proof .lp-win { height:700px; }
    }

    @media (max-width: 900px) {
      .lp-row { grid-template-columns:1fr; gap:28px; }
      .lp-proof .lp-win { height:420px; }
      .lp-plans { grid-template-columns:1fr; }
      .lp-plans > div { border-left:0; padding:24px 0;
        border-top:1px solid var(--lp-line-soft); }
      .lp-plans > div:first-child { border-top:0; padding-top:24px; }
    }
    @media (max-width: 560px) {
      .lp-proof .lp-win { height:360px; }
      /* Shrinking a 1330px surface to fit a phone makes its text unreadable, so
         the crop moves instead of the scale: the sidebar slides out of view and
         what remains is the transcript, which is the part worth showing. */
      .lp-proof .lp-inner { margin-left:-232px !important; }
      .lp-actions { width:100%; flex-direction:column; align-items:stretch; }
      .lp-actions .lp-btn { width:100%; }
      .lp-quiet { justify-content:center; }
    }
    /* No entrance transform at all when the user has asked for less motion. */
    @media (prefers-reduced-motion: reduce) {
      .lp-enter { opacity:1; transform:none; transition:none; }
      .lp-faq summary::after { transition:none; }
    }

    @media (max-width: 860px) {
      .mwrap { padding:0 20px; }
      .mhead [data-nav-toggle] { display:inline-flex; margin-left:auto; }
      .mhead [data-nav] { display:none; position:fixed; inset:68px 0 0 0; background:var(--bg);
        flex-direction:column; align-items:stretch; gap:0; padding:12px 20px; overflow-y:auto; }
      .mhead [data-nav] a { padding:14px 0; font-size:16px; border-bottom:1px solid var(--line-soft); }
      .mhead-sp { display:none; }
      .mfoot-top, .mfoot-legal { padding-left:20px; padding-right:20px; }
      .mfoot-nav { gap:32px; }
    }

    /* ---- interactive states ------------------------------------------ */
    .shell.is-collapsed .sidebar { display: none; }
    @media (min-width: 1024px) {
      .shell.is-collapsed .sidebar { display: flex; width: 54px; }
      .shell.is-collapsed .sidebar .t,
      .shell.is-collapsed .sidebar [data-hide-collapsed] { display: none; }
      .shell.is-collapsed .sidebar .srow { justify-content: center; padding: 0; }
      /* The chat list is what normally pushes the footer down, and it is hidden
         when collapsed, so the utility group needs its own reason to stay at
         the bottom of the rail. */
      .shell.is-collapsed .side-foot { margin-top: auto; }
      .shell.is-collapsed .side-hd { align-items: center; }
      .shell.is-collapsed .side-hd { flex-direction: column; height: auto; gap: 4px;
        padding: 8px 0; }
      .shell.is-collapsed .sidebar { transition: width 180ms ease; }
    }

    .popover { position: absolute; z-index: 60; max-width: calc(100vw - 24px); }
    .popover[hidden] { display: none; }

    .toast-host { position: fixed; right: 16px; bottom: 16px; z-index: 200;
      display: flex; flex-direction: column; gap: 8px; pointer-events: none; }
    .toast { border: 1px solid var(--line); background: var(--raised); color: var(--fg);
      border-radius: 8px; padding: 10px 14px; font-size: var(--t-label); line-height: var(--lh-label); box-shadow: var(--shadow-menu);
      opacity: 0; transform: translateY(6px); transition: opacity 160ms ease, transform 160ms ease;
      max-width: 340px; }
    .toast.in { opacity: 1; transform: none; }

    .drawer[hidden] { display: none; }
    .shell.is-max > .main { display: none; }
    .drawer.is-max { width: auto !important; min-width: 0; flex: 1; }
    .drawer.is-max .drawer-handle { display: none; }
    .drawer-handle { position: absolute; left: -4px; top: 0; bottom: 0; width: 9px;
      cursor: col-resize; z-index: 5; background: transparent; }
    .drawer-handle:hover, .drawer-handle:focus-visible { background: var(--acc); opacity: .45; }

    [data-diff-view][data-mode="split"] .diff-unified { display: none; }
    [data-diff-view][data-mode="split"] .diff-split { display: grid; }
    [data-diff-view][data-mode="unified"] .diff-split { display: none; }
    .diff-split { grid-template-columns: 1fr 1fr; }
    .diff-split > * { min-width: 0; overflow-x: auto; }

    button[aria-pressed="true"].pill, .pill.is-on { border-color: var(--acc); color: var(--acc-text); }
    [aria-disabled="true"], button:disabled, a[aria-disabled="true"] {
      cursor: not-allowed; color: var(--dis-fg); }
    /* only the icon dims; the label keeps its own contrast */
    [aria-disabled="true"] svg, button:disabled svg { opacity: .5; }
    [aria-disabled="true"] .lab, button:disabled .lab { color: var(--dis-icon); }
    /* a control with a surface keeps one, so it still reads as a control */
    .btn:disabled, .btn[aria-disabled="true"], .field:disabled, .field[aria-disabled="true"] {
      background: var(--dis-bg); border-color: var(--dis-bd); color: var(--dis-fg); }
    .btn:disabled:hover, .btn[aria-disabled="true"]:hover { background: var(--dis-bg); }
    /* an unavailable primary must not still read as the primary action */
    .btnp:disabled, .btnp[aria-disabled="true"] {
      background: var(--dis-bg); border-color: var(--dis-bd); color: var(--dis-fg); }
    .btnq:disabled, .btnq[aria-disabled="true"] { background: transparent; border-color: transparent; }
    .btnq:disabled:hover, .btnq[aria-disabled="true"]:hover { background: transparent; }
    /* a navigation or session row goes quiet without losing its label */
    .srow:disabled, .srow[aria-disabled="true"] { background: transparent; box-shadow: none;
      color: var(--dis-fg); }
    .srow:disabled:hover, .srow[aria-disabled="true"]:hover { background: transparent;
      color: var(--dis-fg); }
    .seg > button:disabled, .seg > button[aria-disabled="true"] { color: var(--dis-fg); }
    [data-review-file][data-reviewed="true"] .review-mark { opacity: 1; }
    .review-mark { opacity: 0; }

    /* One line until the text needs two: the input shell owns the height. */
    textarea.ta { width: 100%; border: 0; background: transparent; resize: none;
      font-size: var(--t-body); line-height: var(--lh-body); color: var(--fg); outline: none;
      min-height: 24px; max-height: 184px; padding: 0; font-family: inherit;
      overflow-y: auto; }
    textarea.ta::placeholder { color: var(--mut); }

    .num { font-variant-numeric: tabular-nums; }
    .vh { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
      overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
    /* the skip link is the one visually hidden thing that must appear on focus */
    a.vh:focus-visible { position: fixed; left: 12px; top: 12px; z-index: 400;
      width: auto; height: auto; margin: 0; clip: auto; overflow: visible;
      display: inline-flex; align-items: center; min-height: 40px; padding: 0 16px;
      border: 1px solid var(--line-strong); border-radius: 8px;
      background: var(--raised); color: var(--fg); font-size: 14px; }

    [data-nav][data-open="true"] { display: flex !important; }

    /* ---- onboarding shell -------------------------------------------- */
    .ob { height:100%; display:flex; flex-direction:column; }
    .ob-top { height:48px; flex-shrink:0; display:flex; align-items:center; gap:12px;
      padding:0 16px; border-bottom:1px solid var(--line-soft); }
    .ob-count { font-size:14px; line-height:20px; color:var(--mut);
      font-variant-numeric:tabular-nums; }
    .ob-bar { width:64px; height:3px; border-radius:2px; background:var(--line);
      overflow:hidden; }
    .ob-bar i { display:block; height:100%; background:var(--acc); border-radius:2px;
      transition:width 220ms ease-out; }
    .ob-bar[data-step="1"] i { width:25%; }
    .ob-bar[data-step="2"] i { width:50%; }
    .ob-bar[data-step="3"] i { width:75%; }
    .ob-bar[data-step="4"] i { width:100%; }
    @media (prefers-reduced-motion: reduce) { .ob-bar i { transition:none; } }
    /* on a phone the bar is 130px of decoration next to "Step 4 of 5", which
       says the same thing in 29px */
    /* The bar is the redundant half of the pair, so it is what goes. */
    @media (max-width: 480px) { .ob-bar { display: none; } }
    .ob-body { flex:1; min-height:0; overflow-y:auto; display:flex; flex-direction:column;
      justify-content:flex-start; }
    .ob-col { width:100%; max-width:648px; margin:auto; padding:32px 24px;
      display:flex; flex-direction:column; gap:22px; }
    /* ---- onboarding screens --------------------------------------------- */
    .ob-h1 { margin:0; font-size:clamp(26px,2.6vw,34px); line-height:1.16; font-weight:600;
      letter-spacing:-.022em; max-width:20ch; }
    .ob-lede { margin:0; font-size:17px; line-height:27px; color:var(--mut); max-width:56ch; }
    .ob-note { margin:0; font-size:15px; line-height:23px; color:var(--mut);
      border-left:2px solid var(--line-strong); padding:2px 0 2px 14px; }
    .ob-note-q { margin:0; font-size:14px; line-height:21px; color:var(--mut); max-width:60ch; }

    /* The scan. Rows resolve in place; nothing celebrates. */
    .ob-scan { display:flex; flex-direction:column; gap:2px; }
    .ob-check { display:flex; align-items:center; gap:12px; min-height:44px;
      border-bottom:1px solid var(--line-soft); font-size:15px; line-height:22px; }
    .ob-check:last-of-type { border-bottom:0; }
    .ob-check-i { width:16px; height:16px; border-radius:50%; flex-shrink:0;
      border:1.6px solid var(--line-strong); }
    .ob-check-n { flex:1; min-width:0; color:var(--fg); }
    .ob-check-v { color:var(--mut); font-size:14px; line-height:20px; text-align:right;
      min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:52%; }
    .ob-check[data-state="ok"] .ob-check-i { border-color:var(--ok-line); background:var(--ok-line); }
    .ob-check[data-state="ok"] .ob-check-v { color:var(--fg); }
    /* Unavailable is a fact, not a failure: it takes the neutral treatment and
       says which part of the product would answer it. */
    .ob-check[data-state="na"] .ob-check-i { border-style:dashed; }
    .ob-check[data-state="bad"] .ob-check-i { border-color:var(--bad-line); }
    .ob-check[data-state="bad"] .ob-check-v { color:var(--bad); }

    /* The single recommendation. */
    .ob-rec { border:1px solid var(--line); border-radius:12px; background:var(--raised);
      overflow:hidden; }
    .ob-rec-h { padding:18px 20px 0; display:flex; align-items:baseline; gap:12px; flex-wrap:wrap; }
    .ob-rec-n { font-size:20px; line-height:28px; font-weight:600; letter-spacing:-.015em; }
    .ob-fit { font-size:14px; line-height:20px; color:var(--ok); }
    .ob-rec-d { margin:0; padding:8px 20px 4px; font-size:15px; line-height:23px; color:var(--mut); }
    .ob-kv { margin:0; padding:8px 20px 16px; display:grid;
      grid-template-columns:minmax(0,1fr) auto; }
    .ob-kv dt { padding:9px 0; font-size:15px; line-height:22px; color:var(--mut);
      border-bottom:1px solid var(--line-soft); }
    .ob-kv dd { margin:0; padding:9px 0; font-size:15px; line-height:22px; color:var(--fg);
      text-align:right; border-bottom:1px solid var(--line-soft);
      font-variant-numeric:tabular-nums; }
    .ob-kv dt:last-of-type, .ob-kv dd:last-of-type { border-bottom:0; }
    .ob-more > summary { cursor:pointer; padding:12px 20px; min-height:44px;
      display:flex; align-items:center; border-top:1px solid var(--line-soft);
      font-size:14px; line-height:20px; color:var(--fg); }
    .ob-more > summary:hover { background:var(--sunk); }

    /* Download. One bar, and only real numbers beside it. */
    .ob-dl { border:1px solid var(--line); border-radius:12px; background:var(--raised);
      padding:18px 20px; display:flex; flex-direction:column; gap:12px; }
    .ob-dl-h { display:flex; align-items:baseline; gap:12px; }
    .ob-dl-n { flex:1; min-width:0; font-size:17px; line-height:25px; font-weight:600; }
    .ob-dl-s { font-size:14px; line-height:20px; color:var(--mut); }
    .ob-prog { height:6px; border-radius:3px; background:var(--sunk); overflow:hidden; }
    .ob-prog i { display:block; height:100%; background:var(--acc); border-radius:3px;
      transition:width 200ms ease-out; }
    .ob-dl-m { margin:0; font-size:14px; line-height:21px; color:var(--mut);
      font-variant-numeric:tabular-nums; }
    .ob-dl-a { display:flex; gap:8px; }

    /* Project. One large target. */
    .ob-pick { display:flex; align-items:center; justify-content:center; gap:12px;
      width:100%; min-height:96px; padding:20px; border:1px dashed var(--line-strong);
      border-radius:12px; background:var(--raised); color:var(--fg);
      font-size:17px; line-height:25px; font-weight:500; cursor:pointer;
      transition:background 160ms ease-out, border-color 160ms ease-out; }
    .ob-pick:hover { background:var(--sunk); border-color:var(--faint); }
    .ob-pick:focus-visible { outline:2px solid var(--focus); outline-offset:2px; }
    .ob-trust { border:1px solid var(--line); border-radius:12px; background:var(--raised);
      padding:16px 18px; display:flex; flex-direction:column; gap:8px; }
    .ob-trust-h { display:flex; flex-direction:column; gap:3px; }
    .ob-trust-n { font-size:17px; line-height:25px; font-weight:600; }
    .ob-trust-p { font-size:14px; line-height:21px; color:var(--mut); word-break:break-all; }
    .ob-trust-b { margin:0; font-size:15px; line-height:23px; color:var(--mut); }
    .ob-recent { display:flex; flex-direction:column; gap:8px; }

    /* Permission modes as full-width rows. */
    .ob-modes { display:flex; flex-direction:column; gap:8px; }
    .ob-mode { display:flex; flex-direction:column; gap:4px; align-items:flex-start;
      width:100%; padding:14px 16px 15px 46px; position:relative; text-align:left;
      border:1px solid var(--line); border-radius:12px; background:var(--raised);
      cursor:pointer; transition:border-color 160ms ease-out, background 160ms ease-out; }
    .ob-mode:hover { background:var(--sunk); }
    .ob-mode:focus-visible { outline:2px solid var(--focus); outline-offset:2px; }
    .ob-mode::before { content:""; position:absolute; left:16px; top:18px;
      width:18px; height:18px; border-radius:50%; border:1.6px solid var(--line-strong); }
    .ob-mode[aria-checked="true"] { border-color:var(--acc); }
    .ob-mode[aria-checked="true"]::before { border-color:var(--acc); border-width:5.5px; }
    .ob-mode-t { font-size:16px; line-height:24px; font-weight:600; color:var(--fg);
      display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
    .ob-mode-r { font-size:14px; line-height:20px; font-weight:400; color:var(--mut); }
    .ob-mode-d { font-size:15px; line-height:23px; color:var(--mut); }

    .ob-foot { flex-shrink:0; border-top:1px solid var(--line-soft); }
    .ob-foot .inner { width:100%; max-width:648px; margin:0 auto; padding:12px 24px;
      display:flex; align-items:center; gap:10px; flex-wrap:wrap; row-gap:10px; }
    @media (max-width:520px) { .ob-foot .inner .grow { display:none; } }
    .kv { display:grid; grid-template-columns:132px 1fr; gap:9px 14px; margin:0; }
    .kv dt { color: var(--mut); font-size:13px; }
    .kv dd { margin:0; font-size:14px; }
    @media (max-width:640px) {
      .ob-col { padding:24px 16px } .ob-foot .inner { padding:12px 16px }
      .kv { grid-template-columns:1fr; gap:2px 0 }
      .kv dd { margin-bottom:8px }
    }

    /* ---- responsive --------------------------------------------------- */
    /* Below 1180px the sidebar stops holding a column and becomes an overlay,
       hidden until asked for. [data-open] shows that overlay state. */
    @media (max-width: 1180px) {
      .sidebar { position: absolute; z-index: 40; inset: 0 auto 0 0; width: 280px;
        max-width: 86vw; box-shadow: var(--shadow-menu); display: none; }
      .sidebar[data-open] { display: flex; }
      /* the drawer is modal enough to need a way back out by tapping away */
      .side-scrim { position: absolute; inset: 0; z-index: 35; background: rgba(0,0,0,.45); }
      .side-scrim[hidden] { display: none !important; }
      .hide-sm { display: none; }
    }
    @media (min-width: 1181px) { .side-scrim { display: none; } }
    @media (max-width: 1080px) {
      .drawer { width: 46%; min-width: 380px; }
    }
    @media (max-width: 860px) {
      .drawer { position: absolute; inset: 48px 0 0 0; width: 100%; min-width: 0;
        border-left: 0; z-index: 20; }
      /* a drawer that already fills the width has nothing to drag */
      .drawer-handle { display: none; }
      .col { padding: 0 16px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .001ms !important; animation-iteration-count: 1 !important;
        transition-duration: .001ms !important; scroll-behavior: auto !important;
      }
    }

    /* ---- touch targets --------------------------------------------------- */
    /* Stated last so it beats the dense desktop sizes above. A finger is wider
       than a pointer, and these are the controls that carry the work. */
    @media (max-width: 720px) {
      .cbar .btn, .cbar .ico, .cchip,
      .topbar .btn, .topbar .ico, .topbar .hit,
      .chip, .btn.btnp { min-height: 44px; height: auto; }
      .cstrip { gap: 2px; }
    }

    /* ---- touch layout ------------------------------------------------------
       Last in the sheet on purpose: these override component rules of equal
       specificity, and a tie is settled by order. An input below 16px makes
       mobile Safari zoom the page the moment it is focused, and a 38px control
       is not a target a thumb can hit. */
    @media (max-width: 720px) {
      .field, .mc-search, .side-search .field, .msearch { height: 44px; min-height: 44px; }
      .field input { height: 100%; }
      input, textarea, select,
      .field input, .mc-search input, .side-search input, .loader-search input {
        font-size: var(--t-body); }
      .cchip, .chipf, .lsort, .vstate-a, summary { min-height: 44px; }
    }

  </style>
</helmet>
