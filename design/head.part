<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <style>
    /* ==================================================================
       ForgeLocal design tokens

       :root  = light marketing surface
       .app   = near-black desktop shell
       Components read only the vars, so one set serves both.
       ================================================================== */
    :root {
      --bg:#F7F5F0; --panel:#F1EEE7; --raised:#FFFFFF; --sunk:#EAE7DF;
      --line:#DEDAD1; --line-soft:#E8E4DC; --line-strong:#C9C4B9;
      --fg:#17181A; --mut:#5F6165; --faint:#64666B;
      --acc:#5457CE; --acc-hi:#4B4EC2; --acc-text:#4F52C9; --acc-soft:#EDEDFA;
      --ok:#2F6B3D; --ok-line:#5C9268; --ok-soft:#EDF4EE;
      --warn:#7A5310; --warn-line:#BF8B2C; --warn-soft:#FBF4E6;
      --bad:#9B3A33; --bad-line:#C2564D; --bad-soft:#FBEFEE;
      --focus:#5457CE;
      --flow-head:#2F7DEB; --flow-tail:#4F52C9; --flow-far:#38BDF8;
      --dis-fg:#78797C; --dis-bd:#E0DCD3; --dis-bg:#EFEDE7; --dis-icon:#93918B;
      --shadow-menu:0 10px 30px rgba(23,24,26,.14), 0 1px 3px rgba(23,24,26,.10);
    }
    .app {
      --bg:#0E0F10; --panel:#121315; --raised:#16171A; --sunk:#1B1D20;
      --line:#26282C; --line-soft:#1E2023; --line-strong:#33363B;
      --fg:#EDEDEB; --mut:#A2A39F; --faint:#8A8C88;
      --acc:#6366D9; --acc-hi:#7275E2; --acc-text:#9698F2; --acc-soft:#191A2B;
      --ok:#7FB98A; --ok-line:#4F7A59; --ok-soft:#131C16;
      --warn:#D6A85C; --warn-line:#8A6A2E; --warn-soft:#1F1A10;
      --bad:#E08A82; --bad-line:#8E4A44; --bad-soft:#211413;
      --focus:#9698F2;
      --flow-head:#38BDF8; --flow-tail:#6366D9; --flow-far:#3B82F6;
      --dis-fg:#85878A; --dis-bd:#2A2D31; --dis-bg:#141518; --dis-icon:#6C6F73;
      --shadow-menu:0 16px 40px rgba(0,0,0,.55), 0 2px 6px rgba(0,0,0,.4);
    }

    /* ---- reset / base ------------------------------------------------ */
    *, *::before, *::after { box-sizing: border-box; }
    /* Any author rule that sets display beats the UA [hidden] rule, and most of
       our rows carry an inline display:flex. Without this, setting .hidden on a
       row updated the count but left the row painted. */
    [hidden] { display: none !important; }
    html, body { height: 100%; }
    body { margin: 0; background: var(--bg); color: var(--fg);
      font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
      font-size: 14px; line-height: 21px; -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility; }
    button, input, textarea, select { font: inherit; color: inherit; }
    button { background: none; border: 0; padding: 0; cursor: pointer; }
    a { color: var(--acc-text); text-decoration: none; }
    a:hover { text-decoration: underline; }
    /* A standalone link is a control and needs a hit area. Links inside a
       paragraph keep the paragraph line-height and are exempt. */
    /* A standalone link is a control. Links written inside a paragraph, list
       item or definition keep the paragraph line-height and are excluded. */
    /* A standalone link is a control. Only links written inside running prose
       are exempt, so the exclusion is <p> and <dd>, not every list item: a
       catalog row is an <li> and its title link is very much a control. */
    a.link,
    .msec a:not(p a):not(dd a):not(.btn):not(.brand),
    .mfoot a:not(p a):not(.btn):not(.brand),
    .mhead [data-nav] a:not(.btn) {
      display: inline-flex; align-items: center; min-height: 40px; }
    .mfoot a:not(.btn), .mhead [data-nav] a:not(.btn) { font-size: 14px; }
    .brand { min-height: 40px; }
    :focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
    ::selection { background: var(--acc); color: #fff; }

    /* ---- type -------------------------------------------------------- */
    .m { font-family: "Geist Mono", "Cascadia Mono", ui-monospace, Consolas, monospace;
      font-size: 13px; line-height: 19px; }
    /* .lab is the optional-metadata floor at 12px. Functional labels use
       .lab-fn at 13px. Nothing customer-facing goes below 12px. */
    .lab { font-family: "Geist Mono", "Cascadia Mono", ui-monospace, Consolas, monospace;
      font-size: 12px; line-height: 18px; letter-spacing: .01em; color: var(--faint); }
    .lab-fn { font-size: 13px; line-height: 19px; }
    .h1 { font-size: 28px; line-height: 34px; font-weight: 600; letter-spacing: -.015em; margin: 0; }
    .h2 { font-size: 16px; line-height: 22px; font-weight: 600; margin: 0; }
    .h3 { font-size: 15px; line-height: 22px; font-weight: 600; margin: 0; }
    .h-sec { font-size: 18px; line-height: 26px; font-weight: 600; margin: 0; }
    .mut { color: var(--mut); }
    .faint { color: var(--faint); }
    .prose { font-size: 15px; line-height: 24px; }
    .prose p { margin: 0 0 14px; }
    .prose p:last-child { margin-bottom: 0; }

    /* ---- surfaces ---------------------------------------------------- */
    .app, .site { background: var(--bg); color: var(--fg); }
    .box { border: 1px solid var(--line); background: var(--raised); border-radius: 8px; }
    .soft { background: var(--sunk); }
    .menu { border: 1px solid var(--line); background: var(--raised); border-radius: 10px;
      box-shadow: var(--shadow-menu); }

    /* ---- app shell --------------------------------------------------- */
    .shell { display: flex; height: 100%; min-height: 0; overflow: hidden; }
    .sidebar { width: 272px; flex-shrink: 0; border-right: 1px solid var(--line);
      background: var(--panel); display: flex; flex-direction: column; min-height: 0; }
    .main { flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--bg); }
    .topbar { height: 52px; flex-shrink: 0; display: flex; align-items: center; gap: 10px;
      padding: 0 16px 0 12px; border-bottom: 1px solid var(--line-soft); }
    .scroll { flex: 1; min-height: 0; overflow: hidden; }
    .col { width: 100%; max-width: 792px; margin: 0 auto; padding: 0 28px; }
    .drawer { position: relative; width: 480px; flex-shrink: 0;
      border-left: 1px solid var(--line); background: var(--panel);
      display: flex; flex-direction: column; min-height: 0; }

    /* sidebar rows */
    .srow { display: flex; align-items: center; gap: 10px; min-height: 40px; padding: 4px 10px;
      border-radius: 8px; font-size: 14px; color: var(--mut); cursor: pointer;
      transition: background 140ms ease, color 140ms ease; width: 100%; text-align: left; }
    .srow:hover { background: var(--sunk); color: var(--fg); }
    .srow[aria-current="true"], .srow.on { background: var(--raised); color: var(--fg);
      box-shadow: inset 0 0 0 1px var(--line); }
    .srow .t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .sgroup { font-family: "Geist Mono", "Cascadia Mono", ui-monospace, Consolas, monospace;
      font-size: 12px; color: var(--faint); padding: 0 10px; height: 30px;
      display: flex; align-items: center; letter-spacing: .02em; }

    /* Stop replaces Send in the same control, in the same place. */
    .sendbtn .i-stop { width: 10px; height: 10px; border-radius: 2px; background: currentColor;
      display: none; }
    .sendbtn[data-stop="true"] { background: var(--sunk); border-color: var(--line-strong);
      color: var(--fg); }
    .sendbtn[data-stop="true"]:hover { background: var(--line-soft); }
    .sendbtn[data-stop="true"] .i-send { display: none; }
    .sendbtn[data-stop="true"] .i-stop { display: block; }

    /* ---- model detail drawer -------------------------------------------------- */
    .mdrawer-host { position: absolute; inset: 0; z-index: 80; }
    .mdrawer-host[hidden] { display: none !important; }
    .mdrawer-scrim { position: absolute; inset: 0; background: rgba(0,0,0,.42); }
    .mdrawer { position: absolute; top: 0; right: 0; bottom: 0; width: min(520px, 92vw);
      border-left: 1px solid var(--line); background: var(--bg);
      display: flex; flex-direction: column; box-shadow: var(--shadow-menu); }
    .mdrawer-h { flex-shrink: 0; display: flex; align-items: center; gap: 10px;
      min-height: 52px; padding: 0 12px 0 20px; border-bottom: 1px solid var(--line-soft); }
    .mdrawer-b { flex: 1; min-height: 0; overflow-y: auto; padding: 20px 20px 28px; }
    .mdrawer-s { margin: 0; display: flex; align-items: center; gap: 8px;
      font-size: 14px; color: var(--mut); }
    .mdrawer-f { flex-shrink: 0; display: flex; align-items: center; gap: 8px;
      padding: 12px 16px; border-top: 1px solid var(--line-soft); }
    /* the row title is a control, and the whole row is its target */
    button.rname { font: inherit; font-size: 15.5px; line-height: 22px; font-weight: 600;
      color: var(--fg); text-align: left; }
    button.rname::after { content: ""; position: absolute; inset: 0; }
    .rrow.has-action button.rname::after { content: none; }
    .rrow.has-action button.rname { padding: 9px 10px 9px 0; margin: -9px -10px -9px 0; }

    .diag-steps { margin: 10px 0 0; padding-left: 20px; }
    .diag-steps li { font-size: 14px; line-height: 22px; color: var(--mut); margin-bottom: 8px; }
    .diag-steps li::marker { color: var(--faint); }

    /* ---- first run ---------------------------------------------------------- */
    /* A new user has no history, no second project and no settings to manage
       yet, so none of that is drawn. */
    .sidebar[data-mode="first-run"] .side-search,
    .sidebar[data-mode="first-run"] .cgroup,
    .sidebar[data-mode="first-run"] .chat-archived,
    .sidebar[data-mode="first-run"] .side-foot { display: none; }
    .sidebar[data-mode="first-run"] [data-first-run] { display: block; }

    /* ---- downloads ---------------------------------------------------------- */
    .dlrow { display: grid; grid-template-columns: minmax(0,1fr) 168px auto; gap: 6px 20px;
      align-items: center; padding: 16px 2px; }
    .dl-main { min-width: 0; display: flex; flex-direction: column; gap: 7px; }
    .dl-n { font-size: 14.5px; line-height: 21px; font-weight: 500; }
    .dl-track { width: 100%; max-width: 320px; }
    .dl-m { margin: 0; font-size: 13px; line-height: 20px; color: var(--mut); max-width: 62ch; }
    .dl-s { font-size: 13.5px; }
    .dl-a { display: flex; gap: 8px; justify-self: end; }
    @media (max-width: 860px) {
      .dlrow { grid-template-columns: minmax(0,1fr); }
      .dl-s, .dl-a { justify-self: start; }
    }

    /* ---- settings ----------------------------------------------------------- */
    /* A section list and one readable column. Each row is a label, a sentence
       of consequence and the current value. */
    .setwrap { display: flex; overflow-y: auto; }
    .setnav { flex-shrink: 0; width: 208px; padding: 24px 8px; position: sticky; top: 0;
      align-self: flex-start; }
    .setnav .srow.is-on { background: var(--sunk); color: var(--fg); box-shadow: inset 2px 0 0 var(--acc); }
    .setcol { flex: 1; min-width: 0; max-width: 680px; padding: 24px 28px 64px; }
    .setsec { padding-top: 32px; }
    .setsec:first-child { padding-top: 0; }
    .setsec > h1, .setsec > h2 { margin: 0 0 4px; }
    .set-lede { margin: 8px 0 4px; font-size: 14.5px; line-height: 23px; color: var(--mut);
      max-width: 68ch; }
    .set-h3 { margin: 26px 0 0; font-size: 14px; line-height: 22px; font-weight: 600; }
    .setrow { display: flex; align-items: flex-start; gap: 20px; padding: 16px 0;
      border-top: 1px solid var(--line-soft); }
    .setsec > .setrow:first-of-type { border-top: 1px solid var(--line); margin-top: 14px; }
    .setrow > div:first-child { flex: 1; min-width: 0; }
    .set-l { font-size: 14.5px; line-height: 22px; font-weight: 500; }
    .set-d { margin: 3px 0 0; font-size: 13.5px; line-height: 21px; color: var(--mut);
      max-width: 62ch; }
    .set-v { flex-shrink: 0; font-size: 13.5px; line-height: 22px; color: var(--mut);
      text-align: right; max-width: 40%; overflow-wrap: anywhere; }
    .set-empty { margin: 14px 0 0; font-size: 13.5px; line-height: 21px; color: var(--faint); }
    .setrow[hidden] { display: none !important; }
    /* a switch that states its value in text as well as position */
    .switch { flex-shrink: 0; width: 44px; height: 40px; border: 0; background: none;
      padding: 0; position: relative; cursor: pointer; }
    .switch::before { content: ""; position: absolute; inset: 7px 0; border-radius: 13px;
      border: 1px solid var(--line-strong); background: var(--sunk);
      transition: background 140ms ease-out, border-color 140ms ease-out; }
    .switch > span { position: absolute; top: 10px; left: 3px; width: 18px; height: 18px;
      border-radius: 50%; background: var(--mut); transition: transform 160ms ease-out,
      background 160ms ease-out; }
    .switch[aria-checked="true"]::before { background: var(--acc); border-color: var(--acc); }
    .switch[aria-checked="true"] > span { transform: translateX(18px); background: #fff; }
    @media (max-width: 860px) {
      .setwrap { flex-direction: column; }
      .setnav { width: auto; position: static; display: flex; gap: 4px; overflow-x: auto;
        padding: 12px 12px 8px; border-bottom: 1px solid var(--line-soft); }
      .setnav .srow { width: auto; white-space: nowrap; }
      .setcol { padding: 20px 16px 56px; }
    }

    /* ---- details popovers --------------------------------------------------- */
    /* Project and runtime context, on demand, instead of permanent metrics in
       the header. */
    .pdetails { top: calc(100% + 6px); left: 0; width: 320px; padding: 14px 16px 12px; }
    .pd-h { margin: 0 0 10px; display: flex; align-items: center; gap: 8px;
      font-size: 14px; font-weight: 600; }
    .pd-kv { margin: 0; display: grid; grid-template-columns: 108px 1fr; gap: 7px 12px; }
    .pd-kv dt { font-size: 12.5px; line-height: 19px; color: var(--faint); }
    .pd-kv dd { margin: 0; font-size: 13.5px; line-height: 19px; overflow-wrap: anywhere; }
    .pd-bar { margin-top: 12px; display: flex; flex-direction: column; gap: 6px;
      font-size: 12.5px; line-height: 18px; }
    .pd-a { display: flex; gap: 8px; flex-wrap: wrap; padding-top: 10px; }
    .pdetails .sep { margin: 12px -16px 0; }
    @media (max-width: 520px) { .pdetails { width: min(320px, calc(100vw - 24px)); } }

    /* ---- focused task shell ------------------------------------------------ */
    /* One field, one decision: a centred card and a slim footer instead of the
       full marketing page. */
    .authwrap { display: flex; justify-content: center; padding-top: 72px; padding-bottom: 72px; }
    .authcard { width: 100%; max-width: 460px; }
    .mfoot-slim { margin-top: 48px; }
    .mfoot-slim .mfoot-legal { padding-top: 20px; padding-bottom: 20px; }
    .mfoot-slim .mfoot-legal a:not(.brand) { font-size: 13.5px; color: var(--mut); }

    /* ---- dialog ----------------------------------------------------------- */
    /* One shape for every scoped decision. It says what the choice costs and
       what survives it, which a native confirm cannot. */
    .dlg-host { position: fixed; inset: 0; z-index: 300; }
    .dlg-host[hidden] { display: none !important; }
    .dlg-scrim { position: absolute; inset: 0; background: rgba(0,0,0,.5); }
    .dlg { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
      width: min(440px, calc(100vw - 32px)); border: 1px solid var(--line-strong);
      border-radius: 14px; background: var(--raised); box-shadow: var(--shadow-menu);
      padding: 22px 22px 18px; }
    .dlg-t { margin: 0 0 8px; font-size: 17px; line-height: 25px; font-weight: 600;
      letter-spacing: -.01em; }
    .dlg-b p { margin: 0; font-size: 14.5px; line-height: 22px; color: var(--mut); }
    .dlg-scope { margin: 14px 0 0; display: grid; grid-template-columns: 132px 1fr;
      gap: 8px 14px; padding-top: 14px; border-top: 1px solid var(--line-soft); }
    .dlg-scope dt { font-size: 13px; line-height: 20px; color: var(--faint); }
    .dlg-scope dd { margin: 0; font-size: 13.5px; line-height: 20px; }
    .dlg-a { display: flex; justify-content: flex-end; gap: 8px; margin-top: 20px; }
    body.has-dlg { overflow: hidden; }

    /* ---- scrollbars ------------------------------------------------------- */
    /* Scoped to the dark shell so the light marketing pages keep their own. */
    .app { color-scheme: dark; }
    .app .thread-scroll, .app .scroll, .app pre, .app .drawer,
    .app [data-diff-view], .app .chat-list {
      scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; }
    .app ::-webkit-scrollbar { width: 10px; height: 10px; }
    .app ::-webkit-scrollbar-track { background: transparent; }
    .app ::-webkit-scrollbar-thumb { background: var(--line-strong);
      border-radius: 6px; border: 3px solid transparent; background-clip: content-box; }
    .app ::-webkit-scrollbar-thumb:hover { background: var(--mut);
      border: 3px solid transparent; background-clip: content-box; }
    .app ::-webkit-scrollbar-corner { background: transparent; }

    /* ---- conversation --------------------------------------------------- */
    /* One geometry for every conversation: a 748px thread column, the composer
       docked to the same column, and three levels of emphasis — message,
       then activity, then controls. */
    .thread-scroll { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain;
      display: flex; flex-direction: column; }
    .col { width: 100%; max-width: 748px; margin: 0 auto; padding: 0 28px; }
    .thread { display: flex; flex-direction: column; gap: 40px;
      padding-top: 28px; padding-bottom: 28px; }
    /* the last turn's action row lives in the gutter below it, so the thread
       needs room for one before the composer starts */
    .thread { flex: 0 0 auto; padding-bottom: 48px; }
    /* the empty state centres in the canvas; a conversation starts at the top */
    .thread.is-empty { flex: 1 0 auto; justify-content: center; gap: 0;
      padding-bottom: 8vh; }
    .turn { display: flex; flex-direction: column; gap: 12px; }
    .turn-user { align-items: flex-end; }

    /* user message: one quiet raised surface, no border, no shadow */
    .umsg { max-width: 74%; }
    .umsg-body { background: var(--sunk); border-radius: 19px; padding: 11px 15px;
      font-size: 15.5px; line-height: 25px; white-space: pre-wrap; overflow-wrap: anywhere; }
    .uedit { width: min(74vw, 640px); display: flex; flex-direction: column; gap: 8px; }
    .uedit-t { width: 100%; min-height: 68px; max-height: 220px; resize: none;
      border: 1px solid var(--acc); border-radius: 12px; background: var(--bg);
      color: var(--fg); font: inherit; font-size: 15.5px; line-height: 25px; padding: 10px 14px;
      outline: none; }
    .uedit-a { display: flex; gap: 8px; justify-content: flex-end; }

    /* assistant prose sits on the page, no bubble */
    .amsg { font-size: 15.5px; line-height: 26px; }
    .amsg p { margin: 0 0 14px; }
    .amsg p:last-child { margin-bottom: 0; }
    .amsg h2 { font-size: 20px; line-height: 28px; margin: 22px 0 8px; font-weight: 600; }
    .amsg h3 { font-size: 17px; line-height: 25px; margin: 18px 0 6px; font-weight: 600; }
    .tnote { display: flex; align-items: flex-start; gap: 9px; margin: 0;
      font-size: 15px; line-height: 24px; }
    .tnote svg { flex-shrink: 0; margin-top: 5px; }

    .plan { display: flex; flex-direction: column; gap: 2px; margin-top: 14px; }
    .plan-h { font-family: "Geist Mono", "Cascadia Mono", ui-monospace, Consolas, monospace;
      font-size: 13px; letter-spacing: .015em; color: var(--faint); padding-bottom: 4px; }
    .plan-row { display: flex; align-items: center; gap: 10px; min-height: 28px;
      font-size: 14.5px; color: var(--mut); }
    .plan-row.is-now { color: var(--fg); font-weight: 500; }
    .plan-row.is-todo { color: var(--faint); }
    .plan-i { width: 14px; display: inline-flex; justify-content: center; flex-shrink: 0; }
    .box-todo { width: 13px; height: 13px; border-radius: 4px;
      border: 1px solid var(--line-strong); display: block; }

    /* code: quiet header, always-visible copy, horizontal scroll, never wrapped */
    .cblock { margin: 16px 0 0; border: 1px solid var(--line); border-radius: 10px;
      overflow: hidden; background: var(--panel); }
    .cblock-h { display: flex; align-items: center; gap: 10px; padding: 6px 8px 6px 14px;
      border-bottom: 1px solid var(--line-soft); }
    .cblock-h .m { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis;
      white-space: nowrap; color: var(--faint); }
    .cblock pre { margin: 0; padding: 12px 14px; overflow-x: auto;
      font-size: 13.5px; line-height: 21px; }

    /* ---- activity group -------------------------------------------------- */
    /* One low-contrast surface with internal rules. Never a card per row. */
    .agroup { border: 1px solid var(--line); border-radius: 10px; background: var(--panel);
      overflow: hidden; }
    .agroup-h { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 44px;
      padding: 0 12px 0 14px; text-align: left; font-size: 14px;
      transition: background 140ms ease-out; }
    .agroup-h:hover { background: var(--sunk); }
    .agroup-i { display: inline-flex; width: 15px; justify-content: center; flex-shrink: 0; }
    .agroup-l { font-weight: 600; flex-shrink: 0; }
    .agroup-s { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis;
      white-space: nowrap; color: var(--mut); font-size: 13.5px; }
    .agroup-c { display: inline-flex; color: var(--faint); flex-shrink: 0;
      transition: transform 160ms ease-out; }
    .agroup-h[aria-expanded="true"] .agroup-c { transform: rotate(180deg); }
    .agroup-b { border-top: 1px solid var(--line-soft); padding: 4px 0; }
    .agroup-b[hidden] { display: none; }

    .arow2 { display: flex; align-items: center; gap: 10px; min-height: 34px;
      padding: 2px 14px; font-size: 14px; color: var(--mut); }
    .arow2-i { display: inline-flex; width: 14px; justify-content: center; flex-shrink: 0; }
    .arow2-t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .arow2-m { color: var(--faint); font-size: 13px; }
    .arow2.is-fail { color: var(--bad); }
    .arow2.is-running .arow2-t { color: var(--fg); }
    .arow2-out { margin: 2px 14px 8px 38px; padding: 9px 11px; border-radius: 6px;
      background: var(--bg); border: 1px solid var(--line-soft); color: var(--mut);
      font-size: 13px; line-height: 20px; overflow-x: auto; }
    .num.add { color: var(--ok); font-variant-numeric: tabular-nums; font-size: 13px; }
    .num.del { color: var(--bad); font-variant-numeric: tabular-nums; font-size: 13px; }

    .agroup-files { border-top: 1px solid var(--line-soft); margin-top: 4px; padding-top: 4px; }
    .frow { display: flex; align-items: center; gap: 10px; min-height: 34px; padding: 2px 14px;
      font-size: 13.5px; }
    .frow-n { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis;
      white-space: nowrap; direction: rtl; text-align: left; }
    .frow-new { color: var(--faint); }
    .adiag { border-top: 1px solid var(--line-soft); margin-top: 4px; }
    .adiag summary { cursor: pointer; list-style: none; min-height: 40px; display: flex;
      align-items: center; padding: 0 14px; font-size: 13.5px; color: var(--mut); }
    .adiag summary::-webkit-details-marker { display: none; }
    .adiag summary:hover { color: var(--fg); }
    .adiag pre { margin: 0 14px 12px; padding: 10px 12px; border-radius: 6px;
      background: var(--bg); border: 1px solid var(--line-soft); color: var(--mut);
      font-size: 13px; line-height: 20px; overflow-x: auto; }

    /* ---- permission ------------------------------------------------------ */
    /* A real decision point stays a contained surface; once decided it becomes
       an immutable one-line result that cannot look actionable. */
    .perm { border: 1px solid var(--warn-line); border-radius: 10px;
      background: var(--warn-soft); overflow: hidden; }
    .perm-h { display: flex; align-items: center; gap: 10px; padding: 13px 14px 0; }
    .perm-h .h3 { flex: 1; }
    .perm-c { margin: 12px 14px 0; padding: 10px 12px; border-radius: 6px;
      background: var(--bg); border: 1px solid var(--line); font-size: 13px; overflow-x: auto; }
    .perm-kv { margin: 0; padding: 14px 14px 4px; display: grid;
      grid-template-columns: 108px 1fr; gap: 10px 14px; }
    .perm-kv dt { font-family: "Geist Mono", "Cascadia Mono", ui-monospace, Consolas, monospace;
      font-size: 12.5px; color: var(--faint); padding-top: 2px; }
    .perm-kv dd { margin: 0; font-size: 14px; line-height: 21px; }
    .perm-rev { display: flex; align-items: center; gap: 8px; }
    .perm-a { padding: 12px 14px 14px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .perm-x, .recover-x { font-size: 14px; color: var(--acc-text); padding: 0 8px; }
    .permdone { display: flex; align-items: center; gap: 9px; min-height: 40px;
      padding: 0 2px; font-size: 14px; color: var(--mut); }
    .permdone svg { flex-shrink: 0; }
    .permdone-c { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis;
      white-space: nowrap; color: var(--faint); }
    .permdone:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

    /* one primary recovery, neutral alternatives, diagnostics as text */
    .recover { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .recover-done { font-size: 14px; line-height: 22px; color: var(--mut); flex: 1; min-width: 200px; }

    /* ---- message actions ------------------------------------------------- */
    /* Reserved space, so revealing them never shifts the thread. */
    .mactions { display: flex; gap: 2px; height: 40px; align-items: center;
      opacity: 0; transition: opacity 140ms ease-out; }
    /* Out of flow, in the gutter between turns, starting at the content
       boundary rather than above it. The row itself never intercepts a
       pointer; only its buttons do, and only while they are visible. */
    .turn > .mactions { position: absolute; left: 0; right: 0; top: 100%;
      margin-top: 0; pointer-events: none; }
    .turn > .mactions .mact { pointer-events: none; }
    .turn { position: relative; }
    .turn:hover > .mactions, .turn:focus-within > .mactions { opacity: 1; }
    .turn:hover > .mactions .mact, .turn:focus-within > .mactions .mact { pointer-events: auto; }
    .turn-user > .mactions { justify-content: flex-end; }
    /* a coarse pointer has no hover, so the actions stay put and readable */
    @media (hover: none), (pointer: coarse) {
      .turn > .mactions { position: static; opacity: 1; margin-top: 4px; height: 44px; }
      .turn > .mactions .mact { pointer-events: auto; }
      .mact { min-height: 44px; min-width: 44px; }
    }
    .mact { display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      min-height: 40px; min-width: 40px; padding: 0 8px; border-radius: 7px;
      color: var(--faint); font-size: 13px;
      transition: background 140ms ease-out, color 140ms ease-out; }
    .mact:hover { background: var(--sunk); color: var(--fg); }
    .mact.is-done { color: var(--ok); }
    .mact[aria-pressed="true"] { color: var(--acc-text); background: var(--sunk); }
    .mact-i { display: inline-flex; }

    .thinking { display: flex; align-items: center; gap: 10px; margin: 0;
      font-size: 15px; color: var(--mut); }
    .haltnote { display: flex; align-items: center; gap: 9px; margin: 0;
      font-size: 14.5px; line-height: 22px; color: var(--faint); }
    .haltnote svg { flex-shrink: 0; }
    @keyframes fl-spin { to { transform: rotate(360deg); } }
    .spin { width: 13px; height: 13px; flex-shrink: 0; border-radius: 50%;
      border: 1.7px solid var(--line-strong); border-top-color: var(--acc);
      animation: fl-spin 720ms linear infinite; display: block; }

    /* ---- dock ------------------------------------------------------------ */
    /* The composer sits on the same column as the thread, with a canvas-coloured
       fade so content does not end in a hard cut. */
    .dock { position: sticky; bottom: 0; z-index: 6; flex-shrink: 0;
      padding-bottom: 14px; margin-top: auto; background: var(--bg); }
    .dock::before { content: ""; position: absolute; left: 0; right: 0; bottom: 100%;
      height: 40px; pointer-events: none;
      background: linear-gradient(to top, var(--bg), transparent); }
    .dock-inner { position: relative; }
    .jump { position: absolute; left: 50%; bottom: calc(100% + 10px); transform: translateX(-50%);
      display: inline-flex; align-items: center; gap: 7px; min-height: 40px; padding: 0 16px;
      border: 1px solid var(--line-strong); border-radius: 18px; background: var(--raised);
      color: var(--fg); font-size: 13px; white-space: nowrap; box-shadow: var(--shadow-menu);
      transition: background 140ms ease-out; z-index: 5; }
    .jump:hover { background: var(--sunk); }
    .jump[hidden] { display: none !important; }

    /* ---- empty conversation ---------------------------------------------- */
    .empty { display: flex; flex-direction: column; gap: 14px; }
    .empty-meta { margin: -4px 0 4px; display: flex; align-items: center; gap: 8px;
      flex-wrap: wrap; font-size: 13.5px; }
    /* calmer starters: two columns of short actions, not three dashboard cards */
    .starters { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-top: 4px; }
    .starters > button { display: flex; flex-direction: column; align-items: flex-start; gap: 2px;
      min-height: 58px; padding: 10px 14px; border: 1px solid var(--line); border-radius: 10px;
      background: transparent; text-align: left;
      transition: background 140ms ease-out, border-color 140ms ease-out; }
    .starters > button:hover { background: var(--sunk); border-color: var(--line-strong); }
    /* one featured action, then two equal halves: never an empty third column */
    .starters > button:first-child { grid-column: 1 / -1; }
    .starters:not(.is-pair) > button:nth-child(2) { grid-column: 1; }
    .starters:not(.is-pair) > button:nth-child(3) { grid-column: 2; }
    /* a pair is two equal columns, one card each, by auto-placement */
    .starters.is-pair > button { grid-column: auto; }
    .starters .s-t { font-size: 14.5px; line-height: 21px; color: var(--fg); font-weight: 500; }
    .starters .s-d { font-size: 13px; line-height: 19px; color: var(--faint); }
    @media (max-width: 720px) {
      .starters { grid-template-columns: 1fr; }
      .starters > button,
      .starters > button:first-child,
      .starters.is-pair > button,
      .starters:not(.is-pair) > button:nth-child(2),
      .starters:not(.is-pair) > button:nth-child(3) {
        grid-column: 1; min-height: 44px; }
    }
    @media (max-width: 640px) {
      .col { padding: 0 16px; }
      .umsg { max-width: 88%; }
    }
    @media (prefers-reduced-motion: reduce) {
      .thread-scroll { scroll-behavior: auto; }
    }

    /* ---- saved session view -------------------------------------------- */
    /* A historical chat renders here. It reuses .prose, .act, .arow and .box so
       it introduces no new visual language of its own. */
    .sview-msg { display: flex; justify-content: flex-end; }
    .sview-msg p { margin: 0; max-width: 78%; padding: 11px 14px; border-radius: 12px;
      background: var(--raised); border: 1px solid var(--line);
      font-size: 15px; line-height: 23px; }
    .sview .arow { padding-left: 16px; padding-right: 16px; }
    .sview-file { display: flex; align-items: center; gap: 12px; min-height: 38px;
      padding: 5px 14px; font-size: 13px; }
    .sview-file .n { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis;
      white-space: nowrap; }
    .sview-file .a { color: var(--ok); font-variant-numeric: tabular-nums; }
    .sview-file .d { color: var(--bad); font-variant-numeric: tabular-nums; }

    /* ---- chat selector ------------------------------------------------ */
    /* The sidebar is a chat selector scoped to one project. Rows are 42px, the
       row menu appears on hover, focus and selection, and nothing here borrows
       the workspace's own surfaces. */
    .side-hd { height: 52px; flex-shrink: 0; display: flex; align-items: center; gap: 6px;
      padding: 0 8px 0 10px; }
    .side-hd-t { font-size: 14px; font-weight: 600; letter-spacing: -.005em; }
    .side-search { flex-shrink: 0; padding: 0 10px 8px; }
    .side-search .field { height: 40px; width: 100%; }
    .side-search input { font-size: 14px; }
    .side-project { flex-shrink: 0; padding: 0 10px 10px; }
    .chat-list { flex: 1; min-height: 0; overflow-y: auto; padding: 0 8px 8px; }
    .side-foot { flex-shrink: 0; border-top: 1px solid var(--line-soft); padding: 8px; }

    .cgroup[hidden] { display: none !important; }
    .cgroup-hd { margin: 0; }
    .cgroup-hd > button { display: flex; align-items: center; gap: 6px; width: 100%;
      min-height: 40px; padding: 0 8px; border-radius: 6px;
      font-family: "Geist Mono", "Cascadia Mono", ui-monospace, Consolas, monospace;
      font-size: 13px; letter-spacing: .015em; color: var(--faint); text-align: left; }
    .cgroup-hd > button:hover { color: var(--mut); background: var(--sunk); }
    .cgroup-hd svg { flex-shrink: 0; transition: transform 160ms ease-out; }
    .cgroup-hd > button[aria-expanded="false"] svg { transform: rotate(-90deg); }
    .cgroup-hd > button[aria-expanded="false"] + .cgroup-body,
    .cgroup-body[hidden] { display: none; }

    .chat { position: relative; display: flex; align-items: center; border-radius: 8px;
      transition: background 140ms ease-out; }
    .chat:hover { background: var(--sunk); }
    .chat.is-on { background: var(--sunk); box-shadow: inset 2px 0 0 var(--acc); }
    .chat[hidden] { display: none !important; }
    .chat-open { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10px;
      min-height: 42px; padding: 0 4px 0 10px; font-size: 14px; line-height: 20px;
      color: var(--mut); text-align: left; }
    .chat.is-on .chat-open { color: var(--fg); font-weight: 500; }
    .chat-open .ic { display: inline-flex; width: 13px; flex-shrink: 0; justify-content: center; }
    .chat-open .t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis;
      white-space: nowrap; }
    /* the row menu is present for the pointer, the keyboard and the selection */
    .chat-more { width: 40px; min-width: 40px; height: 42px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center; color: var(--faint);
      border-radius: 8px; opacity: 0; transition: opacity 140ms ease-out, color 140ms ease-out; }
    .chat:hover .chat-more, .chat.is-on .chat-more,
    .chat-more:focus-visible, .chat-more[aria-expanded="true"] { opacity: 1; }
    .chat-more:hover { color: var(--fg); background: var(--line-soft); }
    /* the inline rename field replaces the title in place */
    .chat-rename { flex: 1; min-width: 0; height: 30px; border: 1px solid var(--acc);
      border-radius: 6px; background: var(--bg); color: var(--fg); font-size: 14px;
      padding: 0 8px; outline: none; }
    .chat-empty { margin: 14px 10px; font-size: 13.5px; line-height: 20px; color: var(--faint); }
    .chat-archived { padding: 6px 2px 0; }
    .chat-archived-toggle { min-height: 40px; padding: 0 8px; font-size: 13px;
      color: var(--faint); border-radius: 6px; width: 100%; text-align: left; }
    .chat-archived-toggle:hover { color: var(--mut); background: var(--sunk); }

    .chat-menu { width: 232px; padding: 6px; }
    .chat-menu > button { display: flex; align-items: center; gap: 9px; width: 100%;
      min-height: 40px; padding: 0 10px; border-radius: 7px; font-size: 13.5px;
      color: var(--fg); text-align: left; }
    .chat-menu > button:hover { background: var(--sunk); }
    .chat-menu > button.is-bad { color: var(--bad); }
    .chat-menu > button.is-bad:hover { background: var(--bad-soft); }
    .chat-menu .sep { margin: 5px 0; }
    .chat-menu-hd { margin: 4px 0 2px; padding: 0 10px;
      font-family: "Geist Mono", "Cascadia Mono", ui-monospace, Consolas, monospace;
      font-size: 12px; letter-spacing: .02em; color: var(--faint); }
    .chat-menu .check { width: 14px; flex-shrink: 0; color: var(--acc-text); }
    .chat-menu [aria-checked="true"] .check::before { content: "\2713"; }

    /* ---- controls ---------------------------------------------------- */
    /* 40px is the floor for every control; 44px for primary actions. The dense
       variant trades padding, never height. */
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      height: 40px; padding: 0 14px; border: 1px solid var(--line-strong); background: var(--raised);
      border-radius: 8px; font-size: 14px; line-height: 20px; color: var(--fg); white-space: nowrap;
      transition: background 140ms ease-out, border-color 140ms ease-out, color 140ms ease-out; }
    .btn:hover { background: var(--sunk); }
    .btnp { background: var(--acc); border-color: var(--acc); color: #fff; }
    .btnp:hover { background: var(--acc-hi); border-color: var(--acc-hi); }
    .btnq { background: transparent; border-color: transparent; color: var(--mut); }
    .btnq:hover { background: var(--sunk); color: var(--fg); }
    .btnd { border-color: var(--bad-line); color: var(--bad); }
    .btns { height: 40px; padding: 0 12px; font-size: 13px; border-radius: 8px; }
    .btnl { height: 44px; padding: 0 20px; font-size: 15px; border-radius: 10px; }
    .ico { width: 40px; min-width: 40px; padding: 0; flex-shrink: 0; }
    .ico.btns { width: 40px; min-width: 40px; }

    /* ---- segmented control ------------------------------------------- */
    /* One object instead of a row of loose pills. Children keep whatever
       pressed/unpressed behaviour the page already wired. */
    .seg { display: inline-flex; border: 1px solid var(--line); border-radius: 8px;
      background: var(--raised); overflow: hidden; }
    .seg > button { height: 40px; padding: 0 13px; font-size: 13.5px; color: var(--mut);
      border-left: 1px solid var(--line); white-space: nowrap;
      transition: background 140ms ease-out, color 140ms ease-out; }
    .seg > button:first-child { border-left: 0; }
    .seg > button:hover { background: var(--sunk); color: var(--fg); }
    .seg > button[aria-pressed="true"] { background: var(--sunk); color: var(--fg); font-weight: 500;
      box-shadow: inset 0 -2px 0 var(--acc); }

    /* ---- registry list ------------------------------------------------ */
    /* A list of comparable things is one surface with rules between rows, not
       a stack of cards. The rules live on the rows so filtering a row out
       never leaves a stray divider or doubles one up. */
    .reg { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
    .reg > li { border-top: 1px solid var(--line); }
    .rrow { position: relative; display: grid; align-items: center; gap: 6px 28px;
      grid-template-columns: minmax(0, 1fr) 132px 208px 148px 32px;
      padding: 16px; box-shadow: inset 2px 0 0 transparent;
      transition: background 140ms ease-out; }
    .rrow:hover { background: var(--sunk); }
    /* the current row is marked by the rule at its edge, not by a coloured block */
    .reg > li.is-current .rrow { background: color-mix(in srgb, var(--acc) 4%, var(--raised));
      box-shadow: inset 2px 0 0 var(--acc); }
    .reg > li.is-current .rrow:hover { background: color-mix(in srgb, var(--acc) 7%, var(--raised)); }
    .rname { font-size: 15.5px; line-height: 22px; font-weight: 600; color: var(--fg); }
    .rname:hover { text-decoration: none; }
    /* the whole row is the target; the title is the only link in it */
    .rname::after { content: ""; position: absolute; inset: 0; }
    .ruse { font-size: 14px; line-height: 21px; color: var(--mut); margin: 2px 0 0; }
    .rmeta { font-size: 13px; line-height: 19px; color: var(--faint);
      font-variant-numeric: tabular-nums; margin: 0; }
    .rfit { display: inline-flex; align-items: center; gap: 7px; font-size: 13.5px; line-height: 20px; }
    .rnum { display: flex; flex-direction: column; gap: 2px; font-variant-numeric: tabular-nums; }
    .rnum b { font-size: 14px; line-height: 20px; font-weight: 500; color: var(--fg); }
    .rnum span { font-size: 12.5px; line-height: 17px; color: var(--faint); }
    .rnums { display: flex; gap: 22px; }
    .rchev { color: var(--faint); justify-self: end; }
    /* a row that carries its own action button is targeted by that button */
    /* the action column is a fixed track, not auto: "Use", "Install" and
       "In use" are different widths, and an auto track let every row put its
       fit state and numbers in a slightly different place */
    .rrow.has-action { grid-template-columns: minmax(0, 1fr) 148px 210px 112px; }
    .rrow.has-action > .btn { justify-self: end; }
    .rrow.has-action .rname::after { content: none; }
    /* Between 980 and 1120 the publisher column is gone but the row is still a
       row: the name keeps column one and picks the metadata up underneath it. */
    @media (min-width: 981px) and (max-width: 1120px) {
      .rrow { grid-template-columns: minmax(0, 1fr) 132px 208px 32px; }
      .rrow > div:first-child { grid-column: 1; grid-row: 1; }
      .rrow .rmeta { grid-column: 1; grid-row: 2; margin-top: 4px; }
      .rrow .rfit { grid-column: 2; grid-row: 1; }
      .rrow .rnums { grid-column: 3; grid-row: 1; }
      .rrow .rchev { grid-column: 4; grid-row: 1; }
    }
    /* Below 980 the row stacks, but stays a row of one list rather than
       becoming a card: name, then status, then the numbers underneath. */
    @media (max-width: 980px) {
      .rrow { grid-template-columns: minmax(0, 1fr) auto; gap: 10px 20px; padding: 16px; }
      .rrow > div:first-child { grid-column: 1; grid-row: 1; }
      .rrow .rfit { grid-column: 2; grid-row: 1; justify-self: end; align-self: start; }
      .rrow .rmeta { grid-column: 1 / -1; grid-row: 2; }
      .rrow .rnums { grid-column: 1 / -1; grid-row: 3; }
      .rrow .btn { grid-column: 1 / -1; grid-row: 4; justify-self: start; }
      .rchev { display: none; }
    }
    @media (max-width: 560px) {
      .rnums { gap: 16px; flex-wrap: wrap; }
    }

    /* a pill is a status badge */
    .pill { display: inline-flex; align-items: center; gap: 6px; min-height: 26px; padding: 2px 10px;
      border-radius: 13px; border: 1px solid var(--line); background: transparent;
      font-size: 13px; line-height: 19px; color: var(--mut); white-space: nowrap; }
    /* a pill that is a control gets a control's hit area */
    button.pill, a.pill { height: 40px; border-radius: 20px; padding: 0 15px; font-size: 13px;
      color: var(--fg); cursor: pointer; }
    .pill.ok { border-color: var(--ok-line); color: var(--ok); }
    .pill.warn { border-color: var(--warn-line); color: var(--warn); }
    .pill.bad { border-color: var(--bad-line); color: var(--bad); }
    .pill.acc { border-color: var(--acc); color: var(--acc-text); }

    .dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; background: var(--faint); }
    .dot.ok { background: var(--ok-line); }
    .dot.warn { background: var(--warn-line); }
    .dot.bad { background: var(--bad-line); }
    .dot.acc { background: var(--acc); }

    .track { height: 5px; border-radius: 3px; background: var(--line); overflow: hidden; }
    .fillbar { height: 100%; background: var(--acc); border-radius: 3px; }

    .field { height: 40px; border: 1px solid var(--line); background: var(--sunk);
      border-radius: 8px; display: flex; align-items: center; gap: 10px; padding: 0 12px;
      font-size: 14px; color: var(--mut); }
    .field:focus-within { border-color: var(--acc); }
    .field input { border: 0; background: transparent; outline: none; flex: 1; min-width: 0;
      color: var(--fg); font-size: 14px; align-self: stretch; height: auto; }

    /* ---- composer ---------------------------------------------------- */
    /* One short light travels the perimeter. About three quarters of the ring
       is transparent at any moment, so it reads as a passing light rather than
       a rotating ring. Only opacity responds to hover and focus, so the light
       never restarts or jumps position when focus moves. */
    @property --flow-angle {
      syntax: "<angle>";
      inherits: false;
      initial-value: 0deg;
    }
    .composer { position: relative; isolation: isolate;
      border: 1px solid var(--line-strong); background: var(--raised);
      border-radius: 16px; padding: 8px 10px;
      display: flex; flex-direction: column; gap: 6px;
      transition: border-color 160ms ease-out, background-color 160ms ease-out; }

    .composer::before, .composer::after {
      content: ""; position: absolute; border-radius: inherit; pointer-events: none;
      background: conic-gradient(from var(--flow-angle),
        transparent 0deg 265deg,
        color-mix(in srgb, var(--flow-far) 8%, transparent) 278deg,
        var(--flow-head) 302deg,
        color-mix(in srgb, var(--flow-tail) 72%, transparent) 322deg,
        transparent 342deg 360deg);
      /* the ring is the difference between the padded box and its content box */
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
      mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      mask-composite: exclude;
      animation: flow-edge 8.5s linear infinite;
      transition: opacity 160ms ease-out;
    }
    .composer::before { inset: -1px; padding: 1px; opacity: .24; z-index: 2; }
    .composer::after { inset: -3px; padding: 3px; opacity: .11; filter: blur(9px); z-index: -1; }

    .composer:hover::before { opacity: .35; }
    .composer:focus-within { border-color: color-mix(in srgb, var(--line-strong) 55%, var(--flow-head)); }
    .composer:focus-within::before { opacity: .84; }
    .composer:focus-within::after { opacity: .22; }

    @keyframes flow-edge { to { --flow-angle: 360deg; } }

    /* Static equivalent: the light parks on the upper-left arc. */
    @media (prefers-reduced-motion: reduce) {
      .composer::before, .composer::after { animation: none; --flow-angle: 302deg; }
    }
    /* Without mask compositing there is no ring to draw, so fall back to the
       neutral border and a plain focus ring. */
    @supports not ((-webkit-mask-composite: xor) or (mask-composite: exclude)) {
      .composer::before, .composer::after { display: none; }
      .composer:focus-within { border-color: var(--flow-head);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--flow-head) 16%, transparent); }
    }
    /* The control row must wrap rather than push Send past the viewport on a
       narrow window, and the model name truncates before it does. */
    .cbar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; row-gap: 8px; }
    .cbar > .btn { min-width: 0; }
    .cbar [data-model-label] { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    @media (max-width: 560px) {
      .cbar { flex-wrap: nowrap; }
      .cbar [data-model-label] { max-width: 9ch; }
    }
    @media (max-width: 460px) {
      .cbar [data-model-label] { max-width: 6ch; }
      .cbar > .btn { padding: 0 8px; }
    }

    /* ---- activity group ---------------------------------------------- */
    .act { border: 1px solid var(--line); border-radius: 8px; background: var(--raised);
      overflow: hidden; }
    .act > .hd { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 4px 16px; }
    .arow { display: flex; align-items: center; gap: 12px; min-height: 36px; padding: 6px 16px;
      font-size: 14px; color: var(--mut); }
    .arow .t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .arow.now { color: var(--fg); }
    /* A finished run is a status line, not a second surface competing with the
       result it introduces. */
    .act.is-flat { border: 0; background: transparent; border-radius: 0; }
    .act.is-flat > .hd { padding: 0; min-height: 32px; }
    .act.is-flat .arow { padding-left: 0; padding-right: 0; }

    /* ---- misc -------------------------------------------------------- */
    /* floor for controls that are not one of the named primitives */
    .hit { display: inline-flex; align-items: center; min-height: 40px; }

    .sep { height: 1px; background: var(--line-soft); }
    .grow { flex-grow: 1; }
    .ph { background: var(--line); border-radius: 2px; }
    .xbox { border: 1px solid var(--line); border-radius: 6px; background-color: var(--sunk);
      background-image:
        linear-gradient(to top right, transparent calc(50% - .5px), var(--line) 50%, transparent calc(50% + .5px)),
        linear-gradient(to bottom right, transparent calc(50% - .5px), var(--line) 50%, transparent calc(50% + .5px)); }
    .note { border: 1px dashed var(--line-strong); background: transparent; border-radius: 8px; }
    .chrome { height: 34px; flex-shrink: 0; display: flex; align-items: center; gap: 10px;
      padding: 0 12px; border-bottom: 1px solid var(--line); background: var(--panel); }

    /* ---- pulse (single, on the current activity only) ---------------- */
    @keyframes fl-pulse { 0%,100% { opacity: 1 } 50% { opacity: .45 } }
    .pulse { animation: fl-pulse 2s ease-in-out infinite; }

    /* ---- tables ------------------------------------------------------- */
    .tbl { width:100%; border-collapse:collapse; font-size:14px; }
    .tbl th, .tbl td { text-align:left; padding:14px 16px; border-bottom:1px solid var(--line-soft); }
    .tbl thead th { font-family:"Geist Mono","Cascadia Mono",ui-monospace,Consolas,monospace;
      font-size:13px; color:var(--faint); font-weight:400; background:var(--panel); }
    .tbl tbody tr:last-child td { border-bottom:0; }
    .tbl { border:1px solid var(--line); border-radius:8px; overflow:hidden; }
    .tbl td.num, .tbl th.num { font-variant-numeric:tabular-nums; }

    /* comparison table stacks into labelled rows on narrow screens */
    @media (max-width: 760px) {
      .cmp thead { display: none; }
      .cmp, .cmp tbody, .cmp tr, .cmp th, .cmp td { display: block; }
      .cmp tr { border-bottom: 1px solid var(--line-soft); padding: 12px 14px; }
      .cmp tbody tr:last-child { border-bottom: 0; }
      .cmp th[scope="row"] { padding: 0 0 8px; border: 0; font-weight: 600; }
      .cmp td { border: 0; padding: 3px 0; display: flex; justify-content: space-between; gap: 16px; }
      .cmp td::before { content: attr(data-l); color: var(--faint); font-size: 12.5px; }
    }

    /* ---- marketing shell --------------------------------------------- */
    .mwrap { width:100%; max-width:1240px; margin:0 auto; padding:0 32px; }
    .brand { display:inline-flex; align-items:center; gap:9px; color:var(--fg);
      font-weight:600; font-size:15px; letter-spacing:-.01em; }
    .brand:hover { text-decoration:none; }
    .brand.small { font-size:13px; gap:7px; }
    .mhead { border-bottom:1px solid var(--line); position:sticky; top:0; z-index:50;
      background:var(--bg); }
    .mhead-in { height:72px; display:flex; align-items:center; gap:22px; }
    .mhead [data-nav] { display:flex; align-items:center; gap:22px; flex:1; }
    .mhead [data-nav] a { color:var(--mut); font-size:14px; font-weight:500; }
    .mhead [data-nav] a:hover { color:var(--fg); text-decoration:none; }
    .mhead [data-nav] a[aria-current="page"] { color:var(--fg); font-weight:500; }
    .mhead [data-nav] a.btn { color:var(--fg); }
    .mhead-sp { flex:1; }
    .mhead [data-nav-toggle] { display:none; }

    .mfoot { border-top:1px solid var(--line); margin-top:64px; }
    .mfoot-top { padding:40px 32px 32px; display:flex; gap:40px; flex-wrap:wrap; align-items:flex-start; }
    .mfoot-cta { flex:1; min-width:280px; display:flex; flex-direction:column; gap:14px; }
    .mfoot-cta h2 { margin:0; font-size:22px; line-height:30px; font-weight:600; }
    .mfoot-cta .row { display:flex; align-items:center; gap:14px; flex-wrap:wrap; }
    .mfoot-nav { display:flex; gap:44px; flex-wrap:wrap; }
    .mfoot-nav > div { display:flex; flex-direction:column; gap:2px; }
    .mfoot-nav a { color:var(--mut); font-size:14px; }
    .mfoot-legal { padding:0 32px 28px; display:flex; align-items:center; gap:16px;
      flex-wrap:wrap; font-size:13px; }

    /* two editorial columns with a rule between them on desktop only */
    .seclower { padding: 44px clamp(20px, 5vw, 56px); border-top: 1px solid var(--line);
      background: var(--panel); display: grid; grid-template-columns: 1fr 1fr; gap: 0 44px; }
    .seclower > div + div { border-left: 1px solid var(--line); padding-left: 44px; }
    @media (max-width: 900px) {
      .seclower { grid-template-columns: 1fr; gap: 36px; }
      .seclower > div + div { border-left: 0; padding-left: 0; }
    }

    /* ---- process band -------------------------------------------------- */
    /* Four stages of one process on a shared surface, divided by a rule and a
       chevron rather than four mini-cards floating inside a larger card. */
    .band-p { display: grid; grid-template-columns: repeat(4, 1fr);
      border: 1px solid var(--line); border-radius: 10px; overflow: hidden;
      background: var(--raised); }
    .band-p > .stage { position: relative; padding: 16px 18px;
      border-left: 1px solid var(--line-soft); display: flex; flex-direction: column; gap: 5px; }
    .band-p > .stage:first-child { border-left: 0; }
    /* the chevron sits on the divider so the stages read as one flow */
    .band-p > .stage + .stage::before { content: ""; position: absolute; left: -5px; top: 50%;
      width: 9px; height: 9px; margin-top: -5px; border-top: 1.6px solid var(--line-strong);
      border-right: 1.6px solid var(--line-strong); transform: rotate(45deg);
      background: var(--raised); }
    .band-p > .stage.is-key { background: color-mix(in srgb, var(--acc) 5%, var(--raised));
      box-shadow: inset 0 2px 0 var(--acc); }
    .band-p .h3 { font-size: 14.5px; line-height: 21px; }
    .band-p .why { font-size: 13px; line-height: 19px; color: var(--mut); }
    @media (max-width: 900px) {
      .band-p { grid-template-columns: 1fr; }
      .band-p > .stage { border-left: 0; border-top: 1px solid var(--line-soft); padding: 14px 16px; }
      .band-p > .stage:first-child { border-top: 0; }
      .band-p > .stage + .stage::before { left: 50%; top: -5px; margin: 0 0 0 -5px;
        transform: rotate(135deg); }
      .band-p > .stage.is-key { box-shadow: inset 2px 0 0 var(--acc); }
    }

    /* ---- editorial index ---------------------------------------------- */
    /* Sparse informational pages share this: a readable measure, rules top and
       bottom, rows divided by 1px. No outer radius, no shadow, no card per row.
       The rules sit on the rows so a hidden row never doubles a divider up. */
    .measure { max-width: 900px; }
    .measure-doc { max-width: 740px; }
    .index { border-bottom: 1px solid var(--line); }
    .index > * { border-top: 1px solid var(--line); }
    .irow { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto;
      gap: 0 24px; align-items: baseline; padding: 20px 2px; min-height: 44px; }
    .irow .n { grid-column: 1; grid-row: 1; font-size: 13px; line-height: 24px;
      color: var(--faint); font-variant-numeric: tabular-nums; }
    .irow .t { grid-column: 2; grid-row: 1; font-size: 16px; line-height: 24px;
      font-weight: 600; letter-spacing: -.01em; }
    .irow .d { grid-column: 2; grid-row: 2; margin: 5px 0 0; font-size: 14.5px;
      line-height: 23px; color: var(--mut); max-width: 68ch; }
    .irow .s { grid-column: 3; grid-row: 1; justify-self: end; font-size: 13.5px;
      line-height: 24px; color: var(--faint); white-space: nowrap; }
    /* an interactive row gets the hover and focus treatment; a status-only row
       must not, because nothing happens when you click it */
    a.irow, button.irow { width: 100%; text-align: left; cursor: pointer;
      transition: background 140ms ease-out; }
    a.irow:hover, button.irow:hover { background: var(--sunk); text-decoration: none; }
    /* status table: service, what it affects, state */
    .strow { display: grid; grid-template-columns: 210px minmax(0, 1fr) 150px;
      gap: 4px 24px; align-items: baseline; padding: 18px 2px; min-height: 44px; }
    .strow .t { font-size: 15px; line-height: 23px; font-weight: 600; }
    .strow .d { margin: 0; font-size: 14px; line-height: 22px; color: var(--mut); }
    .strow .s { justify-self: end; display: inline-flex; align-items: center; gap: 8px;
      font-size: 14px; line-height: 22px; color: var(--mut); white-space: nowrap; }
    /* changelog: a release timeline that happens to be empty */
    .tlrow { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 6px 24px;
      padding: 22px 2px; }
    .tlrow .when { font-size: 14px; line-height: 24px; color: var(--faint);
      font-variant-numeric: tabular-nums; }
    .tlrow .t { font-size: 16px; line-height: 24px; font-weight: 600; letter-spacing: -.01em; }
    .tlrow .d { margin: 6px 0 0; font-size: 14.5px; line-height: 23px; color: var(--mut);
      max-width: 68ch; }
    @media (max-width: 720px) {
      .irow { grid-template-columns: minmax(0, 1fr) auto; gap: 0 16px; }
      .irow .n { display: none; }
      .irow .t { grid-column: 1; }
      .irow .d { grid-column: 1 / -1; }
      .strow, .tlrow { grid-template-columns: minmax(0, 1fr); }
      .strow .s { justify-self: start; margin-top: 6px; }
      /* a column header means nothing once the columns have stacked */
      .strow-head { display: none; }
      .tlrow .when { order: -1; }
    }

    /* a plain-language document: sections separated by space and a rule */
    .doc > section { padding: 26px 0; border-top: 1px solid var(--line-soft); }
    .doc > section:first-child { padding-top: 0; border-top: 0; }
    .doc h2 { margin: 0 0 8px; font-size: 17px; line-height: 25px; font-weight: 600;
      letter-spacing: -.01em; }
    .doc p { margin: 0; font-size: 15.5px; line-height: 26px; color: var(--mut); }

    /* ---- technical document ------------------------------------------- */
    /* Sections divided by a rule rather than each one sitting in its own
       rounded box. Used by the model detail pages. */
    fieldset.bare { border: 0; margin: 0; padding: 0; min-width: 0; }

    .dlchip { display: inline-flex; align-items: center; gap: 8px; height: 40px;
      padding: 0 12px; border-radius: 8px; font-size: 13px; color: var(--mut);
      text-decoration: none; }
    .dlchip:hover { background: var(--sunk); color: var(--fg); }
    .dlchip b { font-weight: 600; color: var(--fg); }
    /* narrow onboarding headers have no room for the word, only the number */
    @media (max-width: 640px) { .dlchip-t { display: none; } .dlchip { padding: 0 8px; } }

    /* ---- documentation ------------------------------------------------------ */
    /* Two columns: a persistent index and one readable measure. No cards, and
       the article is the widest thing on the page rather than a panel in it. */
    .docwrap { display: grid; grid-template-columns: 210px minmax(0, 1fr);
      gap: 56px; align-items: start; padding: 56px 24px 88px; }
    .docnav { position: sticky; top: 84px; display: flex; flex-direction: column; gap: 22px; }
    .docnav-g { display: flex; flex-direction: column; gap: 2px; }
    .docnav-g .lab { margin-bottom: 5px; }
    .docnav a { display: flex; align-items: center; min-height: 40px; padding: 6px 10px;
      margin-left: -10px; border-radius: 7px; font-size: 13.5px; line-height: 19px;
      color: var(--mut); text-decoration: none; }
    .docnav a:hover { background: var(--sunk); color: var(--fg); }
    .docnav a.on { color: var(--fg); font-weight: 600; background: var(--sunk); }
    .docbody { max-width: 44rem; }
    .docbreadcrumb { margin: 0 0 14px; font-size: 13px; color: var(--faint); }
    .docbreadcrumb a { color: var(--mut); }
    .docbreadcrumb span { margin: 0 7px; }
    .docmeta { margin: 16px 0 0; font-size: 13px; color: var(--faint); }
    .docbody .docsec:first-of-type { margin-top: 30px; }
    .docbody .docsec p { margin: 0 0 14px; font-size: 15.5px; line-height: 27px; color: var(--mut); }
    .docbody .docsec p:last-child { margin-bottom: 0; }
    .docnote { border-left: 2px solid var(--line); padding-left: 16px; }
    .doccode { margin: 0 0 14px; padding: 14px 16px; border: 1px solid var(--line);
      border-radius: 8px; background: var(--sunk); font-size: 13px; line-height: 21px;
      overflow-x: auto; color: var(--fg); }
    .doclist { margin: 0 0 14px; padding-left: 22px; }
    .doclist li { font-size: 15.5px; line-height: 27px; color: var(--mut); margin-bottom: 8px; }
    .doclist li::marker { color: var(--faint); }
    .dockv { margin: 0 0 14px; display: grid; gap: 0; }
    .dockv > div { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 22px;
      padding: 13px 0; border-top: 1px solid var(--line-soft); }
    .dockv > div:last-child { border-bottom: 1px solid var(--line-soft); }
    .dockv dt { font-size: 14.5px; font-weight: 600; color: var(--fg); }
    .dockv dd { margin: 0; font-size: 14.5px; line-height: 24px; color: var(--mut); }
    .docpn { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 44px;
      padding-top: 26px; border-top: 1px solid var(--line); }
    .docpn a { display: flex; flex-direction: column; gap: 4px; padding: 15px 17px;
      border: 1px solid var(--line); border-radius: 10px; text-decoration: none;
      min-height: 40px; justify-content: center; }
    .docpn a:hover { border-color: var(--line-strong); background: var(--sunk); }
    .docpn a.nx { text-align: right; }
    .docpn .lab { font-size: 13px; }
    .docpn .t { font-size: 14.5px; font-weight: 600; color: var(--fg); }
    .docgroup { margin-top: 34px; }
    .docgroup:first-child { margin-top: 0; }
    .docgroup-h { margin-bottom: 6px; }
    .docgroup-h h2 { margin: 0; font-size: 19px; line-height: 27px; font-weight: 600; }
    .docgroup-h p { margin: 4px 0 0; font-size: 14px; line-height: 21px; color: var(--mut); }
    .docrow { grid-template-columns: minmax(0, 1fr) auto; }
    .docrow .t { grid-column: 1; text-decoration: none; }
    .docrow .d { grid-column: 1 / -1; }
    .docrow .s { grid-column: 2; }
    .measure-w { max-width: 62rem; }

    @media (max-width: 900px) {
      /* twelve links ahead of the article is a wall to scroll past on a phone,
         so the index moves below the thing you actually opened */
      .docwrap { grid-template-columns: minmax(0, 1fr); gap: 30px; padding: 40px 20px 72px; }
      .docbody { order: 1; }
      .docnav { order: 2; position: static; flex-direction: row; flex-wrap: wrap;
        gap: 20px 28px; padding-top: 30px; border-top: 1px solid var(--line); }
      .docnav-g { min-width: 150px; }
      .docnav a { margin-left: -10px; }
      .dockv > div { grid-template-columns: minmax(0, 1fr); gap: 3px; }
      .docpn { grid-template-columns: minmax(0, 1fr); }
      .docpn a.nx { text-align: left; }
    }

    .docsec { border-top:1px solid var(--line); padding:34px 0 0; margin-top:34px; }
    .docsec > h2 { margin:0 0 12px; font-size:20px; line-height:28px; font-weight:600;
      letter-spacing:-.012em; }
    .docsec > p { margin:0 0 16px; font-size:15px; line-height:24px; color:var(--mut);
      max-width:72ch; }
    /* the metadata band under a title: values on a grid, rules top and bottom */
    .specs { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
      gap:20px 32px; padding:20px 0; border-top:1px solid var(--line);
      border-bottom:1px solid var(--line); margin:28px 0 0; }
    .specs > div { display:flex; flex-direction:column; gap:3px; min-width:0; }
    .specs dt, .specs .k { font-size:13px; line-height:19px; color:var(--faint); }
    .specs dd, .specs .v { margin:0; font-size:15px; line-height:22px;
      font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
    /* a table inside a document reads as rules, not as another outlined box */
    .tbl.flat { border:0; border-radius:0; border-top:1px solid var(--line);
      border-bottom:1px solid var(--line); }
    .tbl.flat thead th { background:transparent; font-family:inherit; font-size:13px;
      letter-spacing:0; border-bottom:1px solid var(--line); }
    .tbl.flat th, .tbl.flat td { padding:12px 12px 12px 0; }
    .tbl.flat tbody tr:last-child td { border-bottom:0; }
    /* one contained callout, reserved for a genuinely exceptional state */
    .callout { border:1px solid var(--line); border-radius:10px; background:var(--panel);
      padding:18px 20px; display:flex; gap:14px; align-items:flex-start; }
    .callout svg { flex-shrink:0; margin-top:2px; }

    /* ---- pricing ------------------------------------------------------ */
    /* One surface split by rules, not three floating cards. Every column
       shares the same baselines, so the eye compares rows rather than boxes. */
    .billing { display:flex; align-items:center; gap:14px; margin-bottom:22px; }
    .billing > span { font-size:13.5px; color:var(--mut); }
    .plans { display:grid; grid-template-columns:repeat(3, 1fr);
      /* eyebrow, name, price, note, blurb, features, cta: one row line per
         band, so every column shares the same baselines */
      grid-template-rows:auto auto auto auto auto 1fr auto;
      border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
    .plan { display:grid; grid-template-rows:subgrid; grid-row:span 7;
      padding:24px 26px; border-left:1px solid var(--line-soft); align-content:start; }
    .plan:first-child { border-left:0; }
    .plan.is-rec { background:color-mix(in srgb, var(--acc) 4%, var(--raised));
      box-shadow: inset 0 2px 0 var(--acc); }
    .plan-eyebrow { font-size:12.5px; line-height:18px; color:var(--acc-text); font-weight:500; }
    .plan-price { display:flex; align-items:baseline; gap:5px; margin-top:8px; }
    .plan-price .num { font-size:34px; line-height:40px; font-weight:600; letter-spacing:-.02em; }
    .plan-price .mut { font-size:14px; }
    .plan-note { font-size:12.5px; line-height:18px; min-height:18px; display:block; }
    .plan-blurb { margin:12px 0 0; font-size:14px; line-height:21px; color:var(--mut); }
    .plan-feats { list-style:none; margin:20px 0 0; padding:0;
      display:flex; flex-direction:column; gap:10px; }
    .plan-feats li { display:flex; gap:9px; align-items:flex-start;
      font-size:14px; line-height:21px; }
    .plan-feats svg { flex-shrink:0; margin-top:4px; }
    .plan-cta { margin-top:24px; align-self:end; }
    /* Without subgrid the columns stack their own rows; they no longer share
       baselines, but nothing overlaps or clips. */
    @supports not (grid-template-rows: subgrid) {
      .plan { display:flex; flex-direction:column; }
      .plan-cta { margin-top:auto; padding-top:24px; }
    }
    @media (max-width: 900px) {
      .plans { grid-template-columns:1fr; grid-template-rows:none; }
      .plan { grid-row:auto; grid-template-rows:none; border-left:0;
        border-top:1px solid var(--line-soft); }
      .plan:first-child { border-top:0; }
      .plan.is-rec { box-shadow: inset 2px 0 0 var(--acc); }
    }

    /* ---- disclosure list ---------------------------------------------- */
    /* Questions are rows in one list, not a stack of rounded cards. */
    .faq > details { border-top:1px solid var(--line); }
    .faq > details:last-child { border-bottom:1px solid var(--line); }
    .faq summary { display:flex; align-items:center; gap:12px; cursor:pointer;
      list-style:none; padding:16px 2px; min-height:40px;
      font-size:15px; line-height:23px; font-weight:500; }
    .faq summary::-webkit-details-marker { display:none; }
    .faq summary svg { margin-left:auto; flex-shrink:0; color:var(--faint);
      transition:transform 160ms ease-out; }
    .faq details[open] summary svg { transform:rotate(180deg); }
    .faq summary:hover { color:var(--acc-text); }
    .faq p { margin:0; padding:0 2px 18px; font-size:14.5px; line-height:23px;
      color:var(--mut); max-width:72ch; }

    .msec { padding:0 32px; }
    .mhero h1 { margin:0; font-size:clamp(40px,4.4vw,60px); line-height:1.03;
      font-weight:600; letter-spacing:-.028em; max-width:15ch; }
    .mlede { margin:0; font-size:17px; line-height:27px; color:var(--mut); max-width:62ch; }
    .mbody { font-size:16px; line-height:26px; }
    .msmall { font-size:13px; line-height:20px; }
    .mh2 { margin:0; font-size:clamp(32px,3vw,40px); line-height:1.12; font-weight:600;
      letter-spacing:-.022em; }
    .mh1 { margin:0; font-size:clamp(36px,3.6vw,48px); line-height:1.14; font-weight:600;
      letter-spacing:-.024em; }
    .stack { display:flex; flex-direction:column; }

    @media (max-width: 860px) {
      .mwrap { padding:0 20px; }
      .mhead [data-nav-toggle] { display:inline-flex; margin-left:auto; }
      .mhead [data-nav] { display:none; position:fixed; inset:68px 0 0 0; background:var(--bg);
        flex-direction:column; align-items:stretch; gap:0; padding:12px 20px; overflow-y:auto; }
      .mhead [data-nav] a { padding:14px 0; font-size:16px; border-bottom:1px solid var(--line-soft); }
      .mhead-sp { display:none; }
      .mfoot-top, .mfoot-legal { padding-left:20px; padding-right:20px; }
      .mfoot-nav { gap:32px; }
    }

    /* ---- interactive states ------------------------------------------ */
    .shell.is-collapsed .sidebar { display: none; }
    @media (min-width: 1024px) {
      .shell.is-collapsed .sidebar { display: flex; width: 60px; }
      .shell.is-collapsed .sidebar .t,
      .shell.is-collapsed .sidebar [data-hide-collapsed] { display: none; }
      .shell.is-collapsed .sidebar .srow { justify-content: center; padding: 0; }
      .shell.is-collapsed .side-hd { flex-direction: column; height: auto; gap: 4px;
        padding: 8px 0; }
      .shell.is-collapsed .sidebar { transition: width 180ms ease; }
    }

    .popover { position: absolute; z-index: 60; max-width: calc(100vw - 24px); }
    .popover[hidden] { display: none; }

    .toast-host { position: fixed; right: 16px; bottom: 16px; z-index: 200;
      display: flex; flex-direction: column; gap: 8px; pointer-events: none; }
    .toast { border: 1px solid var(--line); background: var(--raised); color: var(--fg);
      border-radius: 8px; padding: 10px 14px; font-size: 13px; box-shadow: var(--shadow-menu);
      opacity: 0; transform: translateY(6px); transition: opacity 160ms ease, transform 160ms ease;
      max-width: 340px; }
    .toast.in { opacity: 1; transform: none; }

    .drawer[hidden] { display: none; }
    .drawer.is-max { width: calc(100% - 60px) !important; }
    .drawer-handle { position: absolute; left: -4px; top: 0; bottom: 0; width: 9px;
      cursor: col-resize; z-index: 5; background: transparent; }
    .drawer-handle:hover, .drawer-handle:focus-visible { background: var(--acc); opacity: .45; }

    [data-diff-view][data-mode="split"] .diff-unified { display: none; }
    [data-diff-view][data-mode="split"] .diff-split { display: grid; }
    [data-diff-view][data-mode="unified"] .diff-split { display: none; }
    .diff-split { grid-template-columns: 1fr 1fr; }
    .diff-split > * { min-width: 0; overflow-x: auto; }

    button[aria-pressed="true"].pill, .pill.is-on { border-color: var(--acc); color: var(--acc-text); }
    [aria-disabled="true"], button:disabled, a[aria-disabled="true"] {
      cursor: not-allowed; color: var(--dis-fg); }
    /* only the icon dims; the label keeps its own contrast */
    [aria-disabled="true"] svg, button:disabled svg { opacity: .5; }
    [aria-disabled="true"] .lab, button:disabled .lab { color: var(--dis-icon); }
    /* a control with a surface keeps one, so it still reads as a control */
    .btn:disabled, .btn[aria-disabled="true"], .field:disabled, .field[aria-disabled="true"] {
      background: var(--dis-bg); border-color: var(--dis-bd); color: var(--dis-fg); }
    .btn:disabled:hover, .btn[aria-disabled="true"]:hover { background: var(--dis-bg); }
    /* an unavailable primary must not still read as the primary action */
    .btnp:disabled, .btnp[aria-disabled="true"] {
      background: var(--dis-bg); border-color: var(--dis-bd); color: var(--dis-fg); }
    .btnq:disabled, .btnq[aria-disabled="true"] { background: transparent; border-color: transparent; }
    .btnq:disabled:hover, .btnq[aria-disabled="true"]:hover { background: transparent; }
    /* a navigation or session row goes quiet without losing its label */
    .srow:disabled, .srow[aria-disabled="true"] { background: transparent; box-shadow: none;
      color: var(--dis-fg); }
    .srow:disabled:hover, .srow[aria-disabled="true"]:hover { background: transparent;
      color: var(--dis-fg); }
    .seg > button:disabled, .seg > button[aria-disabled="true"] { color: var(--dis-fg); }
    [data-review-file][data-reviewed="true"] .review-mark { opacity: 1; }
    .review-mark { opacity: 0; }

    textarea.ta { width: 100%; border: 0; background: transparent; resize: none;
      font-size: 16px; line-height: 24px; color: var(--fg); outline: none;
      min-height: 24px; max-height: 200px; padding: 6px 4px 0; font-family: inherit;
      overflow-y: auto; }
    textarea.ta::placeholder { color: var(--mut); }

    .num { font-variant-numeric: tabular-nums; }
    .vh { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
      overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
    /* the skip link is the one visually hidden thing that must appear on focus */
    a.vh:focus-visible { position: fixed; left: 12px; top: 12px; z-index: 400;
      width: auto; height: auto; margin: 0; clip: auto; overflow: visible;
      display: inline-flex; align-items: center; min-height: 40px; padding: 0 16px;
      border: 1px solid var(--line-strong); border-radius: 8px;
      background: var(--raised); color: var(--fg); font-size: 14px; }

    [data-nav][data-open="true"] { display: flex !important; }

    /* ---- onboarding shell -------------------------------------------- */
    .ob { height:100%; display:flex; flex-direction:column; }
    .ob-top { height:48px; flex-shrink:0; display:flex; align-items:center; gap:12px;
      padding:0 16px; border-bottom:1px solid var(--line-soft); }
    .ob-steps { display:flex; gap:5px; }
    .ob-steps i { width:22px; height:3px; border-radius:2px; background:var(--line); display:block; }
    .ob-steps[data-step="2"] i:nth-child(-n+1),
    .ob-steps[data-step="3"] i:nth-child(-n+2),
    .ob-steps[data-step="4"] i:nth-child(-n+3),
    .ob-steps[data-step="5"] i:nth-child(-n+4) { background: var(--line-strong); }
    .ob-steps[data-step="1"] i:nth-child(1),
    .ob-steps[data-step="2"] i:nth-child(2),
    .ob-steps[data-step="3"] i:nth-child(3),
    .ob-steps[data-step="4"] i:nth-child(4),
    .ob-steps[data-step="5"] i:nth-child(5) { background: var(--acc); }
    /* on a phone the bar is 130px of decoration next to "Step 4 of 5", which
       says the same thing in 29px */
    @media (max-width: 480px) { .ob-steps { display: none; } }
    .ob-body { flex:1; min-height:0; overflow-y:auto; display:flex; flex-direction:column;
      justify-content:flex-start; }
    .ob-col { width:100%; max-width:648px; margin:auto; padding:32px 24px;
      display:flex; flex-direction:column; gap:22px; }
    .ob-foot { flex-shrink:0; border-top:1px solid var(--line-soft); }
    .ob-foot .inner { width:100%; max-width:648px; margin:0 auto; padding:12px 24px;
      display:flex; align-items:center; gap:10px; flex-wrap:wrap; row-gap:10px; }
    @media (max-width:520px) { .ob-foot .inner .grow { display:none; } }
    .kv { display:grid; grid-template-columns:132px 1fr; gap:9px 14px; margin:0; }
    .kv dt { color:var(--faint); font-size:12.5px; }
    .kv dd { margin:0; font-size:13.5px; }
    @media (max-width:640px) {
      .ob-col { padding:24px 16px } .ob-foot .inner { padding:12px 16px }
      .kv { grid-template-columns:1fr; gap:2px 0 }
      .kv dd { margin-bottom:8px }
    }

    /* ---- responsive --------------------------------------------------- */
    /* Below 1180px the sidebar stops holding a column and becomes an overlay,
       hidden until asked for. [data-open] shows that overlay state. */
    @media (max-width: 1180px) {
      .sidebar { position: absolute; z-index: 40; inset: 0 auto 0 0; width: 280px;
        max-width: 86vw; box-shadow: var(--shadow-menu); display: none; }
      .sidebar[data-open] { display: flex; }
      /* the drawer is modal enough to need a way back out by tapping away */
      .side-scrim { position: absolute; inset: 0; z-index: 35; background: rgba(0,0,0,.45); }
      .side-scrim[hidden] { display: none !important; }
      .hide-sm { display: none; }
    }
    @media (min-width: 1181px) { .side-scrim { display: none; } }
    @media (max-width: 1080px) {
      .drawer { width: 46%; min-width: 380px; }
    }
    @media (max-width: 860px) {
      .drawer { position: absolute; inset: 48px 0 0 0; width: 100%; min-width: 0;
        border-left: 0; z-index: 20; }
      /* a drawer that already fills the width has nothing to drag */
      .drawer-handle { display: none; }
      .col { padding: 0 16px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .001ms !important; animation-iteration-count: 1 !important;
        transition-duration: .001ms !important; scroll-behavior: auto !important;
      }
    }
  </style>
</helmet>
